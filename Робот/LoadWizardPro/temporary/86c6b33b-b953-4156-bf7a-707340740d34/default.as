.PROGRAM state0()@26/09/13 22:45 #0; Initialization
;
  CALL log("State 0: Initialization")
;
  SIGNAL eo.robot.ready
  CALL log("Waiting for task start")
  SWAIT ei.task.start
;
; Resetting signals
  SIGNAL -s.shelf.failed
  BITS eo.shelf.opened[1],4 = 0
;
  SIGNAL eo.task.exec
  SIGNAL -eo.robot.ready
  SIGNAL -s.p.put.air.req
  SIGNAL -s.a.pic.air.req
  SIGNAL -s.mcode.req
;SIGNAL -s.change.req
;SIGNAL -s.chg.ok
  SIGNAL -s.ext.chg.ok
  SIGNAL -s.ext.chg.req
  current.shelf = 0
;
  state = 1
  RETURN
;
.END
.PROGRAM state1()@26/09/13 22:45 #0; Check ready shelves
;
  CALL log("State 1: Check ready shelves")
  WHILE TRUE DO
    IF NOT SIG(ei.task.start) THEN
      state = 255
      RETURN
    END
;
    current.shelf = current.shelf+1
    IF current.shelf==5 THEN
      current.shelf = 1
    END
;
    IF SIG(ei.shelf.ready[current.shelf]) THEN
      CALL log("Shelf"+$ENCODE(current.shelf)+" is ready. Request data!")
;
      SIGNAL eo.data.request[current.shelf]
      SWAIT ei.data.ready
      SIGNAL -eo.data.request[current.shelf]
;
      gripper.id[1] = 0
      gripper.id[2] = 0
      gripper.state[1] = -1
      gripper.state[2] = -1
      cnc.id[1] = 0
      cnc.id[2] = 0
      cnc.state[1] = -1
      cnc.state[2] = -1
      current.wp = 1
      processed.wp = 0
;
      CALL get.task.data
;
      IF air.blow[1] THEN
        SIGNAL s.p.put.air.req
      END
      IF air.blow[2] THEN
        SIGNAL s.a.pic.air.req
      END
;
      SPEED 100
      HOME
;
      state = 100
      RETURN
    END
    HOME 2
  END
;
.END
.PROGRAM state10()@26/09/13 22:45 #0; Pick WP[1] from CNC
