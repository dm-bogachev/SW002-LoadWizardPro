.PROGRAM a.home()@26/09/13 22:45 #0
;
; Set small speed
  SPEED 100 MM/S ALWAYS
  ACCURACY 0.01 ALWAYS
; Move to home and home standby pos
  HOME
  HOME 2
;
.END
.PROGRAM a.main()@26/09/13 22:45 #0
;
  CALL log("Main program executed")
  CALL safe.home
;
  WHILE TRUE DO
    .$pg.string = "state"+$ENCODE(/L,state)
    IF EXISTPGM(.$pg.string) THEN
      SCALL .$pg.string
    ELSE
      CALL log("Error! Program is in wrong state. Reset state to 0")
      RETURN
    END
  END
;
.END
.PROGRAM air.blow(.air)@26/09/13 22:45 #0
;
  BREAK
  HERE #state.bf.air
;
  .air.pg = air.pg.no[.air]
  .$pg.string = "air.pg."+$ENCODE(/L,.air.pg)
  IF EXISTPGM(.$pg.string) THEN
    CALL log("Use air blow program "+.$pg.string)
    SIGNAL air.blow.on,-air.blow.off,eo.air.enabled
    SCALL .$pg.string
  ELSE
    CALL log("No air blow program found, skip")
  END
;
  JMOVE #state.bf.air
  SIGNAL -air.blow.on,air.blow.off,-eo.air.enabled
;
.END
.PROGRAM air.pg.1()@26/09/13 22:45 #0
;
  TWAIT 5
;
.END
.PROGRAM air.pg.3()@26/09/13 22:45 #0
;
  TWAIT 5
;
.END
.PROGRAM autostart.pc()@26/09/13 22:45 #0
;
  CALL initialize.pc
;
  WHILE TRUE DO
    CALL check.speed.pc
    CALL check.teach.pc
    CALL check.limits.pc
    CALL check.reset.pc
    CALL send.plc.pc
  END
;
.END
.PROGRAM calc.rotation(.grip.no,.chuck.no)@26/09/13 22:45 #0
;
  .j6 = cnc.rotations[.grip.no,.chuck.no]
  DECOMPOSE .j[1] = #cnc.out.base
  POINT #cnc.out = #PPOINT(.j[1],.j[2],.j[3],.j[4],.j[5],.j[6]+.j6)
  DECOMPOSE .j[1] = #cnc.in.base
  POINT #cnc.in = #PPOINT(.j[1],.j[2],.j[3],.j[4],.j[5],.j[6]+.j6)
;
;
.END
.PROGRAM calc.state.flag()@26/09/13 22:45 #0
;
  shelf.opened = SIG(eo.shelf.opened[current.shelf])
  shelf.closed = NOT shelf.opened
;
  gp.empty[1] = gripper.state[1]==-1
  gp.full[1] = NOT gp.empty[1]
  gp.wp2[1] = gripper.state[1]==2
  gp.wp1[1] = gripper.state[1]==1
  gp.wp0[1] = gripper.state[1]==0
;
  gp.empty[2] = gripper.id[2]==0
  gp.full[2] = NOT gp.empty[2]
  gp.wp2[2] = gripper.state[2]==2
  gp.wp1[2] = gripper.state[2]==1
  gp.wp0[2] = gripper.state[2]==0
;
  cnc.empty[1] = cnc.state[1]==-1
  cnc.full[1] = NOT cnc.empty[1]
  cnc.wp2[1] = cnc.state[1]==2
  cnc.wp1[1] = cnc.state[1]==1
  cnc.wp0[1] = cnc.state[1]==0
;
  cnc.empty[2] = cnc.state[2]==-1
  cnc.full[2] = NOT cnc.empty[2]
  cnc.wp2[2] = cnc.state[2]==2
  cnc.wp1[2] = cnc.state[2]==1
  cnc.wp0[2] = cnc.state[2]==0
;
  air.bp = SIG(s.p.put.air.req)
  air.ap = SIG(s.a.pic.air.req)
;
  .inside.cnc = SIG(s.inside.cnc)
  .outside.cnc = NOT .inside.cnc
  rout = shelf.opened AND .outside.cnc
  rin = shelf.opened AND .inside.cnc
;
  mfinish = SIG(s.mcode.req)
  n.max.pick = current.wp<=wp.count
  max.pick = NOT n.max.pick
;
  IF grip.chg.int[1] THEN
    gp.int = 1
  ELSE
    gp.int = 2
  END
;
  IF grip.chg.ext[1,1] THEN
    gp.ext.1 = 1
  ELSE
    gp.ext.1 = 2
  END
  IF grip.chg.ext[2,1] THEN
    gp.ext.2 = 1
  ELSE
    gp.ext.2 = 2
  END
;
.END
