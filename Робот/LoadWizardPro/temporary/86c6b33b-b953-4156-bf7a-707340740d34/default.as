;
  CALL cnc.pick(.grip.no,.chuck.no,.wp.state)
;
  IF SIG(eo.grip.error[.grip.no]) THEN
    state = 255
  ELSE
    state = decision.state
  END
;
;SIGNAL s.change.req
  SIGNAL s.ext.chg.req
  SIGNAL s.ext.chg.ok
;
.END
.PROGRAM state100()@26/09/13 22:45 #0; Select decision making module state
;
  CALL log("State 100: Select decision making module state")
;
  .config = BITS(ei.subspindel,3)
  CASE .config OF
   VALUE 0:
    decision.state = 101
   VALUE 1:
    IF int.change THEN
      IF wp2.pick[1] THEN
        decision.state = 103
      ELSE
        CALL log("Impossible configuration!")
        HALT
      END
    ELSE
      IF wp2.pick[1] THEN
        decision.state = 101
      ELSE
        decision.state = 102
      END
    END
   VALUE 2:
    IF int.change THEN
      decision.state = 103
    ELSE
      decision.state = 101
    END
   VALUE 3:
    CALL log("Impossible configuration!")
    HALT
   VALUE 4:
    IF ext.change THEN
      decision.state = 105
    ELSE
      decision.state = 101
    END
   VALUE 5:
    IF ext.change THEN
      IF wp2.pick[1] THEN
        decision.state = 105
      ELSE
        CALL log("Impossible configuration!")
        HALT
      END
    ELSE
      IF int.change THEN
        IF wp2.pick[1] THEN
          decision.state = 103
        ELSE
          CALL log("Impossible configuration!")
          HALT
        END
      ELSE
        IF wp2.pick[1] THEN
          decision.state = 101
        ELSE
          decision.state = 102
        END
      END
    END
   VALUE 6:
    IF ext.change THEN
      decision.state = 105
    ELSE
      IF int.change THEN
        decision.state = 103
      ELSE
        decision.state = 101
      END
    END
  END
  state = decision.state
  RETURN
;
.END
.PROGRAM state101()@26/09/13 22:45 #0; Decision making module 1
;
  CALL log("State 101: Decision making module 1")
;
  WHILE TRUE DO
    CALL calc.state.flag
; Open shelf in not opened
    IF shelf.closed THEN
      state = 2
      RETURN
    END
;
; Send MFINISH
    IF rout AND cnc.full[1] AND mfinish THEN
      state = 18
      RETURN
    END
;
; Pick workpiece from shelf
    IF rout AND gp.empty[1] AND gp.empty[2] AND n.max.pick THEN
      state = 4
      RETURN
    END
;
; Move inside CNC
;
    IF rout AND (gp.full[1] AND cnc.empty[1] OR gp.empty[2] AND cnc.full[1]) THEN
      state = 7
      RETURN
    END
;
; Air blow after pick workpiece
    IF rin AND gp.full[2] AND cnc.empty[1] AND air.ap THEN
      state = 17
      RETURN
    END
;
; Air blow before put workpiece
    IF rin AND gp.full[1] AND cnc.empty[1] AND air.bp THEN
      state = 16
      RETURN
    END
;
; Put workpiece to CNC
    IF rin AND gp.full[1] AND cnc.empty[1] THEN
      state = 9
      RETURN
    END
;
; Pick detail from CNC
    IF rin AND gp.empty[2] AND cnc.wp2[1] THEN
      state = 12
      RETURN
    END
;;;
;
; Move outside cnc.in
    IF rin AND (gp.empty[1] AND cnc.full[1] OR gp.full[2] AND cnc.empty[1]) THEN
      state = 8
      RETURN
    END
;
; Put detail to stocker
    IF rout AND gp.full[2] AND gp.empty[1] THEN
      state = 5
      RETURN
    END
;
; Close shelf
    .ge = gp.empty[1] AND gp.empty[2]
    .ce = cnc.empty[1]
    IF rout AND .ge AND .ce AND max.pick THEN
      state = 3
      RETURN
    END
  END
;
.END
