    RETURN
  ELSE
    CALL log ("Failed to close shelf" + $ENCODE (.shelf.no) +". Task will be stopped")
    SIGNAL s.shelf.failed
    SIGNAL -eo.shelf.unlock[.shelf.no]
    LMOVE .start + TRANS (20, 0, 0)
    BREAK
    ;
    SPEED 650 MM/S ALWAYS
    ACCURACY 50 ALWAYS
    LMOVE .start + TRANS (20, 0, -100)
    LMOVE .start + TRANS (-100, 0, -100)
    JMOVE .#safe
    BREAK
    ;
    RETURN
  END
  ;
  SIGNAL -eo.lidar.small
.END
.PROGRAM shelf.open (.shelf.no,.gripper.type)
  ;
  ; .gripper.type:
  ; 0 - Double
  ; 1 - Parallel
  ;
  IF .gripper.type == type.double THEN
    CALL shelf.open.dbl (.shelf.no)
  ELSE
    CALL shelf.open.par (.shelf.no)
  END
  ;
.END
.PROGRAM shelf.open.dbl (.shelf.no)
  ;
  CALL log ("Opening shelf"+ $ENCODE (.shelf.no) +" with double gripper")
  ;
  CALL gripper.close (grip.no.dbl[1], 0, FALSE)
  CALL gripper.close (grip.no.dbl[2], 0, FALSE)
  CALL set.tool (pin.double)
  ;
  POINT .#safe = #shelf.safe.dbl
  POINT .start = #shelf.open.dbl[.shelf.no, 1]
  POINT .end = #shelf.open.dbl[.shelf.no, 2]
  ;
  SPEED 650 MM/S ALWAYS
  ACCURACY 50 ALWAYS
  ;
  JMOVE .#safe
  ; Change zone to small for avoiding lidar crossing
  IF .shelf.no == 3 OR .shelf.no == 4 THEN
    SIGNAL eo.lidar.small
  END
  ;
  LMOVE .start + TRANS (20, 0, -350)
  LMOVE .start + TRANS (20, 0, 0)
  BREAK
  ; Set smaller speed
  SPEED 100 MM/S ALWAYS
  ACCURACY 0.1 ALWAYS
  LMOVE .start
  BREAK
  ; Open shelf
  CALL log ("Request shelf" + $ENCODE (.shelf.no) + " unlock")
  SIGNAL eo.shelf.unlock[.shelf.no]
  WAIT BITS (ei.shelf.state[1], 5) <> 0
  ;
  IF NOT SIG (ei.shelf.failed) THEN
    CALL log ("Shelf" + $ENCODE (.shelf.no) +" successfully unlocked")
    LMOVE .end
    BREAK
    LMOVE .end + TRANS (20, 0, 0)
    BREAK
    ;
    ; Lock shelf
    SIGNAL -eo.shelf.unlock[.shelf.no]
    SIGNAL eo.shelf.opened[.shelf.no]
    ;
    SPEED 650 MM/S ALWAYS
    ACCURACY 50 ALWAYS
    LMOVE .end + TRANS (20, 0, -100)
    LMOVE .end + TRANS (-200, 0, -100)
    LMOVE .#safe
    BREAK
    ;
    RETURN
  ELSE
    CALL log ("Failed to open shelf" + $ENCODE (.shelf.no) +". Task will be stopped")
    SIGNAL s.shelf.failed
    SIGNAL -eo.shelf.unlock[.shelf.no]
    LMOVE .start + TRANS (20, 0, 0)
    BREAK
    ;
    SPEED 650 MM/S ALWAYS
    ACCURACY 50 ALWAYS
    LMOVE .start + TRANS (20, 0, -350)
    JMOVE .#safe
    BREAK
    ;
    RETURN
  END
  SIGNAL -eo.lidar.small
  ;
.END
.PROGRAM shelf.open.par (.shelf.no)
  ;
  CALL log ("Opening shelf"+ $ENCODE (.shelf.no) +" with parallel gripper")
  ;
  CALL gripper.close (grip.no.dbl[1], 0, FALSE)
  CALL gripper.close (grip.no.dbl[2], 0, FALSE)
  CALL set.tool (pin.parallel)
  ;
  POINT .#safe = #shelf.safe.par
  POINT .start = #shelf.open.par[.shelf.no, 1]
  POINT .end = #shelf.open.par[.shelf.no, 2]
  ;
  SPEED 650 MM/S ALWAYS
  ACCURACY 50 ALWAYS
  ;
  JMOVE .#safe
  ; Change zone to small for avoiding lidar crossing
  IF .shelf.no == 3 OR .shelf.no == 4 THEN
    SIGNAL eo.lidar.small
  END
  ;
  LMOVE .start + TRANS (20, 0, -350)
  LMOVE .start + TRANS (20, 0, 0)
  BREAK
  ; Set smaller speed
  SPEED 100 MM/S ALWAYS
  ACCURACY 0.1 ALWAYS
  LMOVE .start
  BREAK
  ; Open shelf
  CALL log ("Request shelf" + $ENCODE (.shelf.no) + " unlock")
  SIGNAL eo.shelf.unlock[.shelf.no]
  WAIT BITS (ei.shelf.state[1], 5) <> 0
  ;
  IF NOT SIG (ei.shelf.failed) THEN
    CALL log ("Shelf" + $ENCODE (.shelf.no) +" successfully unlocked")
    LMOVE .end
    BREAK
    LMOVE .end + TRANS (20, 0, 0)
    BREAK
    ;
    ; Lock shelf
    SIGNAL -eo.shelf.unlock[.shelf.no]
    SIGNAL eo.shelf.opened[.shelf.no]
    ;
    SPEED 650 MM/S ALWAYS
    ACCURACY 50 ALWAYS
    LMOVE .end + TRANS (20, 0, -100)
    LMOVE .end + TRANS (-200, 0, -100)
    LMOVE .#safe
    BREAK
    ;
    RETURN
  ELSE
    CALL log ("Failed to open shelf" + $ENCODE (.shelf.no) +". Task will be stopped")
    SIGNAL s.shelf.failed
    SIGNAL -eo.shelf.unlock[.shelf.no]
    LMOVE .start + TRANS (20, 0, 0)
    BREAK
    ;
    SPEED 650 MM/S ALWAYS
    ACCURACY 50 ALWAYS
    LMOVE .start + TRANS (20, 0, -350)
    JMOVE .#safe
    BREAK
    ;
    RETURN
  END
  SIGNAL -eo.lidar.small
  ;
.END
.PROGRAM state0 () ; Initialization
  ;
  CALL log ("State 0: Initialization")
  ;
  SIGNAL eo.robot.ready
  CALL log ("Waiting for task start")
  SWAIT ei.task.start
  CALL log ("Task start command received")
  ;
  ; Resetting signals
  BITS eo.shelf.opened[1], 4 = 0
  ;
  SIGNAL eo.task.exec
  SIGNAL -eo.robot.ready
  SIGNAL -s.mcode.req
  SIGNAL -s.clean.req
  SIGNAL -s.inside.cnc
  SIGNAL -s.shelf.failed
  SIGNAL -o.debug
  current.shelf = 5
  ;
  state = 1
  RETURN
  ;
.END
.PROGRAM state1 () ; Check ready shelves
  ;
  CALL log ("State 1: Check ready shelves")
  WHILE TRUE DO
    IF NOT SIG (ei.task.start) THEN
      CALL log ("Task signal was turned off by operator")
      state = 0
      RETURN
    END
    ;
    current.shelf = current.shelf - 1
    IF current.shelf == 0 THEN
      current.shelf = 4
    END
    ;
    IF SIG (ei.shelf.ready[current.shelf]) THEN
      CALL log ("Shelf" + $ENCODE (current.shelf) + " is ready. Request data!")
      ;
      SIGNAL eo.data.request[current.shelf]
      TWAIT 2
      SWAIT ei.data.ready
      SIGNAL -eo.data.request[current.shelf]
      ;
      gripper.dbl.id[1] = 0
      gripper.dbl.st[1] = -1
      gripper.dbl.id[2] = 0
      gripper.dbl.st[2] = -1
      ;
      gripper.prl.id = 0
      gripper.prl.st = -1
      ;
      cnc.id = 0
      cnc.st = -1
      ;
      chg.id = 0
      chg.st = -1
      ;
      current.wp    = 1
      processed.wp  = 0
      ;
      SIGNAL -s.clean.req
      CALL get.task.data
      ;
      state = 99
      RETURN
    END
    HOME
  END
  ;
.END
.PROGRAM state100 () ; Select decision state for bushing type
  ;
  CALL log ("State 100: Select decision state for bushing type")
  ;
  IF NOT chg.required THEN
    decision.state = 101
  ELSE
    decision.state = 102
  END
  ;
  state = decision.state
  RETURN
  ;
.END
.PROGRAM state101 () ; Decision making module. Type: bushing; No buffer
  ;
  CALL log ("State 101: Decision making module. Type: bushing; No buffer")
  ;
  WHILE TRUE DO
    ;
    CALL calc.state.flag
    ;
    ; Open shelf in not opened
    IF shelf.closed THEN
      state = 110
      RETURN
    END
    ;
    ; Send MFINISH
    IF rout AND cnc.full AND mfinish THEN
      state = 116
      RETURN
    END
    ;
    ; Send Clean
    IF rin AND cnc.empty AND SIG(s.clean.req) THEN
      state = 121
      RETURN
    END
    ;
    ; Pick workpiece from shelf
    IF rout AND gp.dbl.empty[1] AND gp.dbl.empty[2] AND n.max.pick THEN
      state = 111
      RETURN
    END
    ;
    ; Move inside CNC
    ;
    IF rout AND (gp.dbl.full[1] AND cnc.empty OR gp.dbl.empty[2] AND cnc.full) THEN
      state = 112
      RETURN
    END
    ;
    ; Put workpiece to CNC
    IF rin AND gp.dbl.full[1] AND cnc.empty THEN
      state = 113
      RETURN
    END
    ;
    ; Pick detail from CNC
    IF rin AND gp.dbl.empty[2] AND cnc.wp2 THEN
      state = 114
      RETURN
    END
    ;
    ; Move outside cnc.in
    IF rin AND (gp.dbl.empty[1] AND cnc.full OR gp.dbl.full[2] AND cnc.empty) THEN
      state = 115
      RETURN
    END
    ;
    ; Put detail to stocker
    IF rout AND gp.dbl.full[2] AND gp.dbl.empty[1] THEN
      state = 117
      RETURN
    END
    ;
    ; Close shelf
    .ge = gp.dbl.empty[1] AND gp.dbl.empty[2]
    .ce = cnc.empty
    IF rout AND .ge AND .ce AND max.pick
      state = 118
      RETURN
    END
  END
  ;
.END
.PROGRAM state102 () ; Decision making module. Type: bushing; With buffer
  ;
  CALL log ("State 102: Decision making module. Type: bushing; With buffer")
  ;
  WHILE TRUE DO
    CALL calc.state.flag
    ;
    ; Open shelf in not opened
    IF shelf.closed THEN
      state = 110
      RETURN
    END
    ;
    ; Send MFINISH
    IF rout AND cnc.full AND mfinish THEN
      state = 116
      RETURN
    END
    ;
    ; Send Clean
    IF rin AND cnc.empty AND SIG (s.clean.req) THEN
      state = 121
      RETURN
    END
    ;
    ; Pick workpiece from shelf
    IF rout AND gp.dbl.empty[1] AND gp.dbl.empty[2] AND n.max.pick THEN
      state = 111
      RETURN
    END
    ;
    ; Buffer change
    IF rout AND gp.dbl.wp0[1] THEN
      state = 120
      RETURN
    END
    ;
    ; Move inside CNC
    ;
    IF rout AND (gp.dbl.wp1[1] AND cnc.empty OR gp.dbl.empty[2] AND cnc.full) THEN
      state = 112
      RETURN
    END
    ;
    ; Put workpiece to CNC
    IF rin AND gp.dbl.full[1] AND cnc.empty THEN
      state = 113
      RETURN
    END
    ;
    ;
    ; Pick detail from CNC
    IF rin AND gp.dbl.empty[2] AND cnc.wp2 THEN
      state = 114
      RETURN
    END
    ; Move outside cnc.in
    IF rin AND (gp.dbl.empty[1] AND cnc.full OR gp.dbl.full[2] AND cnc.empty) THEN
      state = 115
      RETURN
    END
    ;
    ; Put detail to stocker
    IF rout AND gp.dbl.full[2] AND gp.dbl.empty[1] THEN
      state = 117
      RETURN
    END
    ;
    ; Close shelf
    .ge = gp.dbl.empty[1] AND gp.dbl.empty[2]
    .ce = cnc.empty
    IF rout AND .ge AND .ce AND max.pick
      state = 118
      RETURN
    END
  END
  ;
  ;
.END
