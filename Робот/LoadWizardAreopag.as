.PROGRAM set.tool (.tool.no)
  ;
  CASE .tool.no OF
    VALUE 1:
      ; Double gripper, tool 1
      TOOL t.gripper[1]
      CALL log ("Double gripper, tool 1 set")
    VALUE 2:
      ; Double gripper, tool 2
      TOOL t.gripper[2]
      CALL log ("Double gripper, tool 2 set")
    VALUE 3:
      ; Parallel gripper
      TOOL t.gripper[3]
      CALL log ("Parallel gripper set")
    VALUE 4:
      ; Double gripper, pin
      TOOL t.pin[1]
      CALL log ("Double gripper, pin set")
    VALUE 5:
      ; Parallel gripper, pin
      TOOL t.pin[2]
      CALL log ("Parallel gripper, pin set")
  END
  current.tool = .tool.no
  ;
  WEIGHT 20, 0, 0, 100, 0.1, 0.1, 0.1
  ;
.END
