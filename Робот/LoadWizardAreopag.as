.PROGRAM tch.cnc.bushing ()
  ;
  IF SIG (s.hmi.tool[1]) THEN
    .grip.no = 1
  ELSE
    .grip.no = 2
  END
  ;
  .gc.full = hmi.dbl.ch.full[.grip.no]
  .gc.body = hmi.dbl.ch.work[.grip.no]
  .cncc.full = hmi.cnc.ch.full
  .cncc.body = hmi.cnc.ch.work
  ;
  TOOL t.gripper[.grip.no]
  CALL calc.rot.dbl (.grip.no)
  ;
  JMOVE #cnc.out
  LMOVE #cnc.in
  ;
  LAPPRO #cnc.point.bush[.grip.no], 50
  ; Teach this point 
  BREAK
  LMOVE #cnc.point.bush[.grip.no]  ; **== TEACH POINT ==**
  LAPPRO #cnc.point.bush[.grip.no], 50
  ;
  POINT .temp = #cnc.point.bush[.grip.no]
  .zshift = .gc.body + .cncc.body + hmi.bush.length
  POINT cnc.point.bush[.grip.no] = .temp + TRANS (, , .zshift)
  ;
  POINT .temp = cnc.point.bush[.grip.no] + TRANS (, , -.zshift)
  LAPPRO .temp, 50
  LMOVE .temp
  LAPPRO .temp, 50
  ;
.END
.PROGRAM tch.cnc.dbl.app ()
  ;
  JMOVE #cnc.out.dbl.bas ; ***TEACH POINT***
  LMOVE #cnc.in.dbl.base ; ***TEACH POINT***
  ;
.END
.PROGRAM tch.cnc.prl.app ()
  ;
  JMOVE #cnc.out.prl.bas ; ***TEACH POINT***
