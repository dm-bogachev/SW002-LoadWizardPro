.PROGRAM prep.points.dbl () ; Do not use
  ;
  FOR .b = 1 TO 2
    TOOL t.gripper[.b]
    FOR .t = 2 TO 180
      FOR .i = 1 TO 4
        ;POINT #p0.bush[.i, .t, .b] = #p0.bush[.i, 1, .b]
        ;POINT #px.bush[.i, .t, .b] = #px.bush[.i, 1, .b]
        ;POINT #py.bush[.i, .t, .b] = #py.bush[.i, 1, .b]
        ;
        POINT .p0 = #p0.bush[.i, .t, .b]
        POINT .px = #px.bush[.i, .t, .b]
        POINT .py = #py.bush[.i, .t, .b]
        ;
        PRINT 0: .b, .t, .i
        ; Direction vectors
        ; X
        .cx = 1 / DISTANCE (.p0, .px)
        POINT .x.vec = TRANS (DX (.px) - DX (.p0), DY (.px) - DY (.p0), DZ (.px) - DZ (.p0))
