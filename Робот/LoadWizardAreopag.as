  gripper.dbl.st[.grip.no] = -1
  ;
  SPEED 80 MM/S
  ACCURACY 0.1
  LAPPRO .put, .z.appro
  JMOVE #wp.bush.safe[.grip.no]
  ;
.END
.PROGRAM wp.prl.pick (.shelf.no,.wp.id)
  ;
  .$temp = "Pick shaft workpiece with id:" + $ENCODE (.wp.id)
  CALL log (.$temp)
  ;
  SPEED 100 ALWAYS
  ACCURACY 10 ALWAYS
  ;
  CALL set.tool (grip.no.par[1])
  CALL gripper.open (grip.no.par[1], 0, FALSE)
  CALL id.to.ij.shaft (.wp.id, .i, .j)
  ;
  .dx = plt.dx * .i
  .dy = plt.dy * .j + shaft.wp0.l2 + shaft.wp0.l3 - cond.stp.oy
  .dz = shaft.wp0.h + gr.prl.full - gr.prl.work
  ;
  .z.appro = shaft.wp0.h + 20
  ;
  POINT .p0 = origin.shaft[.shelf.no, task.id]
  POINT .x.norm = x.norm.shaft[.shelf.no, task.id]
  POINT .y.norm = y.norm.shaft[.shelf.no, task.id]
  ;
  POINT .x.vec = TRANS (DX (.x.norm) * .dx, DY (.x.norm) * .dx, DZ (.x.norm) * .dx)
  POINT .y.vec = TRANS (DX (.y.norm) * .dy, DY (.y.norm) * .dy, DZ (.y.norm) * .dy)
  POINT .origin = TRANS (DX (.p0), DY (.p0), DZ (.p0))
  POINT .pick = .origin + .x.vec + .y.vec
  POINT/OAT .pick = .p0
  POINT .pick = .pick + TRANS (0, 0, -.dz)
  ;
  ;IF
  ;
  JMOVE #wp.shaft.safe
  ;
  ; Pick workpiece
  ACCURACY 0.1
  LAPPRO .pick, .z.appro
  SPEED 30 MM/S
  ACCURACY 0.1
  LMOVE .pick
  BREAK
  CALL gripper.close (grip.no.par[1], gp.par.cl.tmr, FALSE)
  CALL log ("Shaft picked")
  gripper.prl.id = .wp.id
  gripper.prl.st = 0
  ;
  SPEED 80 MM/S
  ACCURACY 0.1
  LAPPRO .pick, .z.appro
  JMOVE #wp.shaft.safe
  ;
.END
.PROGRAM wp.prl.put (.shelf.no,.wp.id)
  ;
  .$temp = "Put shaft workpiece with id:" + $ENCODE (.wp.id)
  CALL log (.$temp)
  ;
  SPEED 100 ALWAYS
  ACCURACY 10 ALWAYS
  ;
  CALL set.tool (grip.no.par[1])
  CALL id.to.ij.shaft (.wp.id, .i, .j)
  ;
  .dx = plt.dx * .i
  .dy = plt.dy * .j + shaft.wp0.l2 + shaft.wp0.l3 - cond.stp.oy
  .dz = shaft.wp0.h + gr.prl.full - gr.prl.work
  ;
  .z.appro = shaft.wp0.h + 20
  ;
  POINT .p0 = origin.shaft[.shelf.no, task.id]
  POINT .x.norm = x.norm.shaft[.shelf.no, task.id]
  POINT .y.norm = y.norm.shaft[.shelf.no, task.id]
  ;
  POINT .x.vec = TRANS (DX (.x.norm) * .dx, DY (.x.norm) * .dx, DZ (.x.norm) * .dx)
  POINT .y.vec = TRANS (DX (.y.norm) * .dy, DY (.y.norm) * .dy, DZ (.y.norm) * .dy)
  POINT .origin = TRANS (DX (.p0), DY (.p0), DZ (.p0))
  POINT .put = .origin + .x.vec + .y.vec
  POINT/OAT .put = .p0
  POINT .put = .put + TRANS (0, 0, -.dz)
  POINT .put.appro = .put + TRANS (0, 5, 0)
  ;
  JMOVE #wp.shaft.safe
  ;
  ; Pick workpiece
  ACCURACY 0.1
  LAPPRO .put.appro, .z.appro
  SPEED 30 MM/S
  ACCURACY 0.1
  LMOVE .put.appro
  LMOVE .put
  BREAK
  CALL gripper.open(grip.no.par[1], gp.par.op.tmr, FALSE)
  CALL log ("Shaft put")
  gripper.prl.id = 0
  gripper.prl.st = -1
  ;
  SPEED 80 MM/S
  ACCURACY 0.1
  LAPPRO .put, .z.appro
  JMOVE #wp.shaft.safe
  ;
.END
