    BREAK
    LMOVE .end + TRANS (0, 0, -20)
    BREAK
    ;
    ; Lock shelf
    SIGNAL -eo.shelf.unlock[.shelf.no]
    SIGNAL -eo.shelf.opened[.shelf.no]
    ;
    SPEED 350 MM/S ALWAYS
    ACCURACY 50 ALWAYS
    LMOVE .end + TRANS (-350, -350, -20)
    LMOVE .#safe
    $safe.flag = "shelf.safe"
    BREAK
    ;
    RETURN
  ELSE
    CALL log ("Failed to open shelf" + $ENCODE (.shelf.no) +". Task will be stopped")
    SIGNAL s.shelf.failed
    SIGNAL -eo.shelf.unlock[.shelf.no]
    LMOVE .start + TRANS (0, 0, -20)
    LMOVE .start + TRANS (-150, -150, -20)
    LMOVE .start + TRANS (-150, -150, -20) + RZ (70)
    LMOVE .start + TRANS (-150, -150, 200) + RZ (70)
    BREAK
    ;
    SPEED 350 MM/S ALWAYS
    ACCURACY 50 ALWAYS
    LMOVE .start + TRANS (-350, -350, -20)
    JMOVE .#safe
    $safe.flag = "shelf.safe"
    BREAK
    ;
    RETURN
  END
  ;
.END
