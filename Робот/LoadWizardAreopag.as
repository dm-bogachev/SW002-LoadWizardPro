.PROGRAM cnc.pick.bush (.grip.no)
  ;
  .$temp = "Pick bushing workpiece in CNC with tool:" + $ENCODE (.grip.no)
  CALL log (.$temp)
  ;
  SPEED 100 ALWAYS
  ACCURACY 10 ALWAYS
  CALL set.tool (grip.no.dbl[.grip.no])
  CALL gripper.open (grip.no.dbl[.grip.no], 0, gr.dbl.inv[.grip.no])
  CALL calc.rot.dbl (.grip.no)
  ;
  ; Calculate shifts
  .c1 = bush.wp2.len + gr.dbl.work[.grip.no] + cnc.ch.work
  .dz = .c1 - cnc.overshoot ;
  .c2 = cnc.ch.full - cnc.ch.work
  .z.appro = .c2 + cnc.overshoot + 10
  ;
  ; Calculate points
  POINT .temp = cnc.point.bush[task.id, .grip.no]
  POINT .put = .temp + TRANS (0, 0, -.dz)
  ;
  ; Approach
  SPEED 20 ALWAYS
  JMOVE #cnc.in
  ACCURACY 0.1
  LAPPRO .put, .z.appro
  BREAK;
  SPEED 30 MM/S
  LMOVE .put
  BREAK
  CALL gripper.close (grip.no.dbl[.grip.no], gp.dbl.cl.tmr[.grip.no], gr.dbl.inv[.grip.no])
  CALL chuck.open
  ;
  SIGNAL s.mcode.req
  gripper.dbl.id[.grip.no] = cnc.id
  gripper.dbl.st[.grip.no] = cnc.st
  cnc.id = 0
  cnc.st = -1
  ;
  ACCURACY 0.1
  LAPPRO .put, .z.appro
  BREAK
  LMOVE #cnc.in
  ;
.END
.PROGRAM cnc.pick.shaft ()
  ;
  .$temp = "Put shaft workpiece in CNC:"
  CALL log (.$temp)
  ;
  SPEED 100 ALWAYS
  ACCURACY 10 ALWAYS
  CALL set.tool (grip.no.par[1])
  CALL chuck.open
  CALL calc.rot.prl (shaft.rotate)
  ;
  IF shaft.rotate THEN
    .shaft.l = shaft.wp2.l1-shaft.wp2.l2
    .rz = 180
    .dir = -1
  ELSE
    .shaft.l = shaft.wp2.l2
    .rz = 0
    .dir = 1
  END
  ;
  .gc.len = gr.prl.full[1]
  .gc.body = gr.prl.work[1]
  .cncc.full = cnc.ch.full
  .cncc.body = cnc.ch.work
  ;
  ; Calculate shifts
  .dz = gr.prl.full[1] - gr.prl.work[1]
  .dy = .shaft.l + cnc.ch.work - cnc.overshoot
  .y.appro = cnc.ch.full + cnc.overshoot + 10
  ;
  ; Calculate points
  POINT .temp = cnc.point.shaft[task.id]
  POINT .temp = .temp + RZ(.rz)
  POINT .pick = .temp + TRANS (0, .dir*.dy, -.dz)
  POINT .pick.appro[1]= .pick  + TRANS (0, 0, -100)
  POINT .pick.appro[2]= .pick  + TRANS (0, .dir*.y.appro, 0)
  ;
  ; Approach
  SPEED 20 ALWAYS
  JMOVE #cnc.in
  ACCURACY 0.1
  LMOVE .pick.appro[1]
  BREAK;
  SPEED 30 MM/S
  LMOVE .pick
  BREAK
  ;
  CALL gripper.close (grip.no.par[1], gp.par.cl.tmr, FALSE)
  CALL chuck.open
  ;
  gripper.prl.id = cnc.id
  gripper.prl.st = cnc.st
  cnc.id = 0
  cnc.st = -1
  ;
  ACCURACY 0.1
  LMOVE .pick.appro[2]
  BREAK
  LMOVE #cnc.in
  ;
.END
.PROGRAM cnc.put.bush (.grip.no)
  ;
  .$temp = "Put bushing workpiece in CNC with tool:" + $ENCODE (.grip.no)
  CALL log (.$temp)
  ;
  SPEED 100 ALWAYS
  ACCURACY 10 ALWAYS
  CALL set.tool (grip.no.dbl[.grip.no])
  CALL chuck.open 
  CALL calc.rot.dbl (.grip.no)
  ;
  IF NOT d.chg.required THEN
    .gr.dbl.work = gr.dbl.work[.grip.no]
  ELSE
    .gr.dbl.work = gr.dbl.work[3]
  END
  ;
  ; Calculate shifts
  .c1 = bush.wp0.len + gr.dbl.work[.grip.no] + cnc.ch.work
  .dz = .c1 - cnc.overshoot ;
  .c2 = cnc.ch.full - cnc.ch.work
  .z.appro = .c2 + cnc.overshoot + 10
  ;
  ; Calculate points
  POINT .temp = cnc.point.bush[task.id, .grip.no]
  POINT .put = .temp + TRANS (0, 0, -.dz)
  ;
  ; Approach
  SPEED 20 ALWAYS
  JMOVE #cnc.in
  ACCURACY 0.1
  LAPPRO .put, .z.appro
  BREAK;
  SPEED 30 MM/S
  LMOVE .put
  BREAK
  IF cnc.first THEN
    CALL log ("CNC close chuck first")
    CALL chuck.close 
    CALL gripper.open (grip.no.dbl[.grip.no], gp.dbl.op.tmr[.grip.no], gr.dbl.inv[.grip.no])
  ELSE
    CALL log ("Robot open chuck first")
    CALL gripper.open (grip.no.dbl[.grip.no], gp.dbl.op.tmr[.grip.no], gr.dbl.inv[.grip.no])
    CALL chuck.close 
  END
  ;
  SIGNAL s.mcode.req
  cnc.id = gripper.dbl.id[.grip.no]
  cnc.st = gripper.dbl.st[.grip.no]
  gripper.dbl.id[.grip.no] = 0
  gripper.dbl.st[.grip.no] = -1
  ;
  ACCURACY 0.1
  LAPPRO .put, .z.appro
  BREAK
  LMOVE #cnc.in
  CALL gripper.close (grip.no.dbl[.grip.no], 0, gr.dbl.inv[.grip.no])
  ;
.END
.PROGRAM cnc.put.shaft ()
  ;
  .$temp = "Put shaft workpiece in CNC"
  CALL log (.$temp)
  ;
  SPEED 100 ALWAYS
  ACCURACY 10 ALWAYS
  CALL set.tool (grip.no.par[1])
  CALL calc.rot.prl (chg.required)
  ;
  IF chg.required THEN
    .shaft.l = shaft.wp0.l1 - shaft.wp0.l2
  ELSE
    .shaft.l = shaft.wp0.l2
  END
  ;
  .gc.len = gr.prl.full[2]
  .gc.body = gr.prl.work[2]
  .cncc.full = cnc.ch.full
  .cncc.body = cnc.ch.work
  ;
  ; Calculate shifts
  .dz = gr.prl.full[2] - gr.prl.work[2]
  .dy = .shaft.l + cnc.ch.work - cnc.overshoot
  .y.appro = cnc.ch.full + cnc.overshoot + 10
  ;
  ; Calculate points
  POINT .temp = cnc.point.shaft[task.id]
  POINT .temp = .temp + RZ (.rz)
  POINT .put = .temp + TRANS (0, .dy, -.dz)
  POINT .put.appro[1] = .put  + TRANS (0, .y.appro, 0)
  POINT .put.appro[2] = .put  + TRANS (0, 0, -100)
  ;
  ; Approach
  SPEED 20 ALWAYS
  JMOVE #cnc.in
  ACCURACY 0.1
  LMOVE .put.appro[1]
  BREAK;
  SPEED 30 MM/S
  LMOVE .put
  BREAK
  CALL log ("CNC close chuck first")
  CALL chuck.close
  CALL gripper.open (grip.no.par[1], gp.par.op.tmr, FALSE)
  ;
  SIGNAL s.mcode.req
  cnc.id = gripper.prl.id
  cnc.st = gripper.prl.st
  gripper.prl.id = 0
  gripper.prl.st = -1
  ;
  ACCURACY 0.1
  LMOVE .put.appro[2]
  BREAK
  LMOVE #cnc.in
  CALL gripper.close (grip.no.par[1], 0, FALSE)
  ;
.END
.PROGRAM copy.buff () ; Do not use
  ;
  FOR .i = 2 TO 180
    POINT #buff.put.appro[.i] = #buff.put.appro[1]
    POINT #buff.put[.i] = #buff.put[1]
    POINT #buff.put.depar[.i] = #buff.put.depar[1]
    POINT #buff.pick.appro[.i] = #buff.pick.appro[1]
    POINT #buff.pick[.i] = #buff.pick[1]
    POINT #buff.pick.depar[.i] = #buff.pick.depar[1]
  END
  ;
.END
.PROGRAM copy.cnc (.source,.dest)
  ;
  POINT #cnc.point.bush[.dest, 1] = #cnc.point.bush[.source, 1]
  POINT #cnc.point.bush[.dest, 2] = #cnc.point.bush[.source, 2]
  POINT cnc.point.bush[.dest, 1] = cnc.point.bush[.source, 1]
  POINT cnc.point.bush[.dest, 2] = cnc.point.bush[.source, 2]
  POINT #cnc.point.shaft[.dest] = #cnc.point.shaft[.source]
  POINT cnc.point.shaft[.dest] = cnc.point.shaft[.source]
  ;
.END
.PROGRAM copy.cnc.debug ()
  FOR .grip.no = 1 TO 2
    FOR .i = 1 TO 180
      ;
      .gc.full = hmi.dbl.ch.full[.grip.no]
      .gc.body = hmi.dbl.ch.work[.grip.no]
      .cncc.full = hmi.cnc.ch.full
      .cncc.body = hmi.cnc.ch.work
      ;
      TOOL t.gripper[.grip.no]
      POINT #cnc.point.bush[.i, .grip.no] = #cnc.point.bush[1, .grip.no]
      
      POINT .temp = #cnc.point.bush[.i, .grip.no]
      .zshift = .gc.body + .cncc.body + hmi.bush.length
      POINT cnc.point.bush[.i, .grip.no] = .temp + TRANS (, , .zshift)
      ;
    END
  END
  FOR .i = 1 TO 180
    ;
    .gc.len = hmi.prl.ch.full
    .gc.body = hmi.prl.ch.work
    .cncc.full = hmi.cnc.ch.full
    .cncc.body = hmi.cnc.ch.work
    ;
    TOOL t.gripper[3]
    POINT #cnc.point.shaft[.i] = #cnc.point.shaft[1]
    ;
    POINT .t = #cnc.point.shaft[.i]
    POINT .t = .t + TRANS (0, 150, 0)
    POINT .t = #cnc.point.shaft[.i]
    POINT .t = .t + TRANS (0, 150, 0)
    ;
    POINT .temp = #cnc.point.shaft[.i]
    .zshift = .gc.len - .gc.body;
    .yshift = hmi.cnc.ch.work + hmi.shaft.pick
    POINT cnc.point.shaft[.i] = .temp + TRANS (, -.yshift, .zshift)
    ;
  END
.END
.PROGRAM copy.plate.bush (.source,.dest)
  ;
  FOR .i = 1 TO 4
    FOR .j = 1 TO 2
      POINT #p0.bush[.i, .dest, .j] = #p0.bush[.i, .source, .j]
      POINT #px.bush[.i, .dest, .j] = #px.bush[.i, .source, .j]
      POINT #py.bush[.i, .dest, .j] = #py.bush[.i, .source, .j]
      POINT origin.bush[.i, .dest, .j] = origin.bush[.i, .source, .j]
      POINT x.norm.bush[.i, .dest, .j] = x.norm.bush[.i, .source, .j]
      POINT y.norm.bush[.i, .dest, .j] = y.norm.bush[.i, .source, .j]
      ;
    END
  END
  ;
.END
.PROGRAM copy.plate.shaf (.source,.dest)
;
  FOR .i = 1 TO 4
    POINT #p0.shaft[.i,.dest] = #p0.shaft[.i,.source]
    POINT #px.shaft[.i,.dest] = #px.shaft[.i,.source]
    POINT #py.shaft[.i,.dest] = #py.shaft[.i,.source]
;
    POINT origin.shaft[.i,.dest] = origin.shaft[.i,.source]
    POINT x.norm.shaft[.i,.dest] = x.norm.shaft[.i,.source]
    POINT y.norm.shaft[.i,.dest] = y.norm.shaft[.i,.source]
;
  END
;
.END
