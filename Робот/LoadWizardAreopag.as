.PROGRAM wp.dbl.pick (.grip.no,.shelf.no,.wp.id)
  ;
  .$temp = "Pick bushing workpiece with id:" + $ENCODE (.wp.id)
  CALL log (.$temp)
  ;
  SPEED 100 ALWAYS
  ACCURACY 10 ALWAYS
  ;
  CALL set.tool (grip.no.dbl[.grip.no])
  CALL gripper.open (grip.no.dbl[.grip.no], 0, gr.dbl.inv[.grip.no])
  CALL id.to.ij.bush (.wp.id, .i, .j)
  ;
  .dx = plt.dx * .i
  IF .i MOD 2 == 0
    .dy = plt.dy * (plt.cell.odd - 1 - .j)
  ELSE
    .dy = plt.dy * (plt.cell.even - 1 - .j) + plt.even.dy
  END
  .dz = bush.wp0.len + gr.dbl.work[.grip.no] - shelf.overshoot ;
  .z.appro = gr.dbl.full[.grip.no] - gr.dbl.work[.grip.no] + shelf.overshoot + 10
  ;
  POINT .p0 = origin.bush[.shelf.no, task.id, .grip.no]
  POINT .x.norm = x.norm.bush[.shelf.no, task.id, .grip.no]
  POINT .y.norm = y.norm.bush[.shelf.no, task.id, .grip.no]
  ;
  POINT .x.vec = TRANS (DX (.x.norm) * .dx, DY (.x.norm) * .dx, DZ (.x.norm) * .dx)
  POINT .y.vec = TRANS (DX (.y.norm) * .dy, DY (.y.norm) * .dy, DZ (.y.norm) * .dy)
  POINT .origin = TRANS (DX (.p0), DY (.p0), DZ (.p0))
  POINT .pick = .origin + .x.vec + .y.vec
  POINT/OAT .pick = .p0
  POINT .pick = .pick + TRANS (0, 0, -.dz)
  ;
  JMOVE #wp.bush.safe[.grip.no]
  ;
  ; Pick workpiece
  ACCURACY 0.1
  LAPPRO .pick, .z.appro
  SPEED 30 MM/S
  ACCURACY 0.1
  LMOVE .pick
  BREAK
  CALL gripper.close (grip.no.dbl[.grip.no], gp.dbl.cl.tmr[.grip.no], gr.dbl.inv[.grip.no])
  CALL log ("Bush picked")
  gripper.dbl.id[.grip.no] = .wp.id
  gripper.dbl.st[.grip.no] = 0
  ;
  SPEED 80 MM/S
  ACCURACY 0.1
  LAPPRO .pick, .z.appro
  JMOVE #wp.bush.safe[.grip.no]
  ;
.END
.PROGRAM wp.dbl.put (.grip.no,.shelf.no,.wp.id)
  ;
  .$temp = "Put bushing workpiece with id:" + $ENCODE (.wp.id)
  CALL log (.$temp)
  ;
  SPEED 100 ALWAYS
