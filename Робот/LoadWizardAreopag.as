.PROGRAM shelf.close (.shelf.no,.gripper.type)
  ;
  ; .gripper.type:
  ; 0 - Double
  ; 1 - Parallel
  ;
  IF .gripper.type == type.double THEN
    CALL shelf.close.dbl (.shelf.no)
  ELSE
    CALL shelf.close.par (.shelf.no)
  END
  ;
.END
.PROGRAM shelf.close.dbl (.shelf.no)
  ;
  CALL log ("Closing shelf"+ $ENCODE (.shelf.no) +" with double gripper")
  ;
  CALL gripper.close (grip.no.dbl[1], 0, FALSE)
  CALL gripper.close (grip.no.dbl[2], 0, FALSE)
  CALL set.tool (pin.double)
  ;
  POINT .#safe = #shelf.safe.dbl
  POINT .start = #shelf.close.dbl[.shelf.no, 1]
  POINT .end = #shelf.close.dbl[.shelf.no, 2]
  ;
  SPEED 650 MM/S ALWAYS
  ACCURACY 50 ALWAYS
  ;
  JMOVE .#safe
  ; Change zone to small for avoiding lidar crossing
  IF .shelf.no == 3 OR .shelf.no == 4 THEN
    SIGNAL eo.lidar.small
  END
  ;
  LMOVE .start + TRANS (-200, 0, -100)
  LMOVE .start + TRANS (20, 0, -100)
  LMOVE .start + TRANS (20, 0, 0)
  BREAK
  ; Set smaller speed
  SPEED 100 MM/S ALWAYS
  ACCURACY 0.1 ALWAYS
  LMOVE .start
  BREAK
  ; Open shelf
  CALL log ("Request shelf" + $ENCODE (.shelf.no) + " unlock")
  SIGNAL eo.shelf.unlock[.shelf.no]
  WAIT BITS (ei.shelf.state[1], 5) <> 0
  ;
  IF NOT SIG (ei.shelf.failed) THEN
    CALL log ("Shelf" + $ENCODE (.shelf.no) +" successfully unlocked")
    LMOVE .end
    BREAK
    LMOVE .end + TRANS (20, 0, 0)
    BREAK
    ;
    ; Lock shelf
    SIGNAL -eo.shelf.unlock[.shelf.no]
    SIGNAL -eo.shelf.opened[.shelf.no]
    ;
    SPEED 650 MM/S ALWAYS
    ACCURACY 50 ALWAYS
    LMOVE .end + TRANS (20, 0, -350)
    LMOVE .#safe
    BREAK
    ;
    RETURN
  ELSE
    CALL log ("Failed to close shelf" + $ENCODE (.shelf.no) +". Task will be stopped")
    SIGNAL s.shelf.failed
    SIGNAL -eo.shelf.unlock[.shelf.no]
    LMOVE .start + TRANS (20, 0, 0)
    BREAK
    ;
    SPEED 650 MM/S ALWAYS
    ACCURACY 50 ALWAYS
    LMOVE .start + TRANS (20, 0, -100)
    LMOVE .start + TRANS (-100, 0, -100)
    JMOVE .#safe
    BREAK
    ;
    RETURN
  END
  SIGNAL -eo.lidar.small
  ;
.END
.PROGRAM shelf.close.par (.shelf.no)
