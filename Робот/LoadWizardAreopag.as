    BREAK
    HERE #shelf.open.dbl[.i, 1]
    HERE #shelf.open.prl[.i, 1]
    ;
    JMOVE #shelf.open.dbl[1, 2]
    DRAW 0, 0, -180*(.i-1)
    BREAK
    HERE #shelf.open.dbl[.i, 2]
    HERE #shelf.open.prl[.i, 2]
    ;
    JMOVE #shelf.close.dbl[1, 1]
    DRAW 0, 0, -180*(.i-1)
    BREAK
    HERE #shelf.close.dbl[.i, 1]
    HERE #shelf.close.par[.i, 1]
    ;
    JMOVE #shelf.close.dbl[1, 2]
    DRAW 0, 0, -180*(.i-1)
    BREAK
    HERE #shelf.close.dbl[.i, 2]
    HERE #shelf.close.par[.i, 2]
  END
.END
.PROGRAM safe.home ()
  ;
  ; Set small speed
  SPEED 100 MM/S ALWAYS
  ACCURACY 0.01 ALWAYS
  ;
  SIGNAL gripper.close[1], -gripper.open[1]
  SIGNAL gripper.close[2], -gripper.open[2]
  TWAIT 0.2
  SIGNAL gripper.open[1], -gripper.close[1]
  SIGNAL gripper.open[2], -gripper.close[2]
  ;
  BITS eo.shelf.unlock[1], 4 = ^B1111
  ; Move to home pos
  .$tc = $ENCODE(max.trace.count)
  CALL log("Start moving to HOME position. Trace count =" + .$tc)
  FOR .i = max.trace.count-1 TO 0 STEP -1
    JMOVE #trace[.i]
  END
  ;
  BITS eo.shelf.unlock[1], 4 = ^B0000
  ;
.END
.PROGRAM safe.trace.pc ()
  ;
  max.trace.count = 0
  HERE .last.pos
  WHILE TRUE DO
    IF SIG (do.home) THEN
      max.trace.count = 1
      HERE .last.pos
      HERE #trace[0]
      TWAIT 1
    ELSE
      IF SIG (s.start.trace) THEN
        HERE .current.pos
        IF DISTANCE (.current.pos, .last.pos) > 5 THEN
          HERE #trace[max.trace.count]
          HERE .last.pos
          max.trace.count = max.trace.count + 1
        END
        TWAIT 0.1
        ;
      END
    END
    ;
  END
  ;
.END
.PROGRAM send.plc.pc ()
  ;
  BITS eo.dbl.grip.id[1, 0], 16 = gripper.dbl.id[1]
  BITS eo.dbl.grip.id[2, 0], 16 = gripper.dbl.id[2]
  BITS eo.prl.grip.id[0], 16 = gripper.prl.id
  BITS eo.cnc.id[1, 0], 16 = cnc.id
  BITS eo.chg.id[0], 16 = chg.id
  BITS eo.wp.processed[0], 16 = processed.wp
  IF current.wp > wp.count THEN
    BITS eo.next.wp[0], 16 = 0
  ELSE
    BITS eo.next.wp[0], 16 = current.wp
  END
  ;
  BITS eo.error.code[0], 16 = -ERROR
  ;
  FOR .i = 1 TO 2
    IF gripper.dbl.st[.i] == -1 THEN
      BITS eo.gr.dbl.empty[.i], 4 = 1
    END
    IF gripper.dbl.st[.i] == 0 THEN
      BITS eo.gr.dbl.empty[.i], 4 = 2
    END
    IF gripper.dbl.st[.i] == 1 THEN
      BITS eo.gr.dbl.empty[.i], 4 = 4
    END
    IF gripper.dbl.st[.i] == 2 THEN
      BITS eo.gr.dbl.empty[.i], 4 = 8
    END
  END
  ;
  IF gripper.prl.st == -1 THEN
    BITS eo.gr.prl.empty, 4 = 1
  END
  IF gripper.prl.st == 0 THEN
    BITS eo.gr.prl.empty, 4 = 2
  END
  IF gripper.prl.st == 1 THEN
    BITS eo.gr.prl.empty, 4 = 4
  END
  IF gripper.prl.st == 2 THEN
    BITS eo.gr.prl.empty, 4 = 8
  END
  ;
  IF cnc.st == -1 THEN
    BITS eo.cnc.empty, 4 = 1
  END
  IF cnc.st == 0 THEN
    BITS eo.cnc.empty, 4 = 2
  END
  IF cnc.st == 1 THEN
    BITS eo.cnc.empty, 4 = 4
  END
  IF cnc.st == 2 THEN
    BITS eo.cnc.empty, 4 = 8
  END
    ;
  IF chg.st == -1 THEN
    BITS eo.chg.empty, 4 = 1
  END
  IF chg.st == 0 THEN
    BITS eo.chg.empty, 4 = 2
  END
  IF chg.st == 1 THEN
    BITS eo.chg.empty, 4 = 4
  END
  IF chg.st == 2 THEN
    BITS eo.chg.empty, 4 = 8
  END
  ;
.END
