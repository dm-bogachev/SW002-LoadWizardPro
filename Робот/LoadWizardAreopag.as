.PROGRAM tch.cnc.shaft ()
  ;
  .gc.len = hmi.prl.ch.full
  .gc.body = hmi.prl.ch.work
  .cncc.full = hmi.cnc.ch.full
  .cncc.body = hmi.cnc.ch.work
  ;
  TOOL t.gripper[3]
  CALL calc.rot.prl (FALSE)
  ;
  JMOVE #cnc.out
  LMOVE #cnc.in
  ;
  POINT .t = #cnc.point.shaft
  POINT .t = .t + TRANS(0,150,0)
  LMOVE .t
  ; Teach this point 
  BREAK
  LMOVE #cnc.point.shaft  ; **== TEACH POINT ==**
  POINT .t = #cnc.point.shaft
  POINT .t = .t + TRANS(0,150,0)
  LMOVE .t
  ;
  POINT .temp = #cnc.point.shaft
  .zshift = .gc.len - .gc.body;
  .yshift = hmi.cnc.ch.work + hmi.shaft.pick
  POINT cnc.point.shaft = .temp + TRANS (, -.yshift, .zshift)
  ;
  POINT .temp = cnc.point.shaft + TRANS (, .yshift, -.zshift)
  POINT .temp.appro = .temp + TRANS(0, 150, 0 )
  LMOVE .temp.appro
  LMOVE .temp
  LMOVE .temp.appro
  ;
.END
.PROGRAM tch.dbl.plate ()
  ;
  IF SIG (s.hmi.tool[1]) THEN
    .tool.no = 1
  ELSE
    .tool.no = 2
  END
  ;
  .z.cor = hmi.dbl.ch.work[.tool.no] + hmi.bush.length
  TOOL t.gripper[.tool.no] + TRANS(0, 0, .z.cor)
  ;
  JMOVE #wp.bush.safe[.tool.no]
  ;
  LAPPRO #p0.bush[hmi.shelf.no, hmi.task.no, .tool.no], 20
  BREAK
  ; Zero point
  LMOVE #p0.bush[hmi.shelf.no, hmi.task.no, .tool.no] ; ***TEACH POINT***
  LAPPRO #p0.bush[hmi.shelf.no, hmi.task.no, .tool.no], 20
  ;
  LAPPRO #px.bush[hmi.shelf.no, hmi.task.no, .tool.no], 20
  BREAK
  ; X-direction
  LMOVE #px.bush[hmi.shelf.no, hmi.task.no, .tool.no] ; ***TEACH POINT***
  LAPPRO #px.bush[hmi.shelf.no, hmi.task.no, .tool.no], 20
  ;
  LAPPRO #py.bush[hmi.shelf.no, hmi.task.no, .tool.no], 20
  BREAK
  ; Y-direction
  LMOVE #py.bush[hmi.shelf.no, hmi.task.no, .tool.no] ; ***TEACH POINT***
  LAPPRO #py.bush[hmi.shelf.no, hmi.task.no, .tool.no], 20
  ;
  ; Calculation
  POINT .p0 = #p0.bush[hmi.shelf.no, hmi.task.no, .tool.no]
  POINT .px = #px.bush[hmi.shelf.no, hmi.task.no, .tool.no]
  POINT .py = #py.bush[hmi.shelf.no, hmi.task.no, .tool.no]
  ;
  ; Direction vectors
  ; X
  .cx = 1 / DISTANCE (.p0, .px)
  POINT .x.vec = TRANS (DX (.px) - DX (.p0), DY (.px) - DY (.p0), DZ (.px) - DZ (.p0))
  POINT .x.norm = TRANS (DX (.x.vec) * .cx, DY (.x.vec) * .cx, DZ (.x.vec) * .cx)
  ; Y
  .cy = 1 / DISTANCE (.p0, .py)
  POINT .y.vec = TRANS (DX (.py) - DX (.p0), DY (.py) - DY (.p0), DZ (.py) - DZ (.p0))
  POINT .y.norm = TRANS (DX (.y.vec) * .cy, DY (.y.vec) * .cy, DZ (.y.vec) * .cy)
  ;
  POINT origin.bush[hmi.shelf.no, hmi.task.no, .tool.no] = .p0
  POINT x.norm.bush[hmi.shelf.no, hmi.task.no, .tool.no] =.x.norm
  POINT y.norm.bush[hmi.shelf.no, hmi.task.no, .tool.no] =.y.norm
  ;
.END
.PROGRAM tch.prl.plate ()
  ;
  TOOL t.calib[3]
  ;
  JMOVE #wp.shaft.safe
  ;
  LAPPRO #p0.shaft[hmi.shelf.no, hmi.task.no], 20
  BREAK
  ; Zero point
  LMOVE #p0.shaft[hmi.shelf.no, hmi.task.no] ; ***TEACH POINT***
  LAPPRO #p0.shaft[hmi.shelf.no, hmi.task.no], 20
  ;
  LAPPRO #px.shaft[hmi.shelf.no, hmi.task.no], 20
  BREAK
  ; X-direction
  LMOVE #px.shaft[hmi.shelf.no, hmi.task.no] ; ***TEACH POINT***
  LAPPRO #px.shaft[hmi.shelf.no, hmi.task.no], 20
  ;
  LAPPRO #py.shaft[hmi.shelf.no, hmi.task.no], 20
  BREAK
  ; Y-direction
  LMOVE #py.shaft[hmi.shelf.no, hmi.task.no] ; ***TEACH POINT***
  LAPPRO #py.shaft[hmi.shelf.no, hmi.task.no], 20
  ;
  ; Calculation
  POINT .p0 = #p0.shaft[hmi.shelf.no, hmi.task.no]
  POINT .px = #px.shaft[hmi.shelf.no, hmi.task.no]
  POINT .py = #py.shaft[hmi.shelf.no, hmi.task.no]
  ;
  ; Direction vectors
  ; X
  .cx = 1 / DISTANCE (.p0, .px)
  POINT .x.vec = TRANS (DX (.px) - DX (.p0), DY (.px) - DY (.p0), DZ (.px) - DZ (.p0))
  POINT .x.norm = TRANS (DX (.x.vec) * .cx, DY (.x.vec) * .cx, DZ (.x.vec) * .cx)
  ; Y
  .cy = 1 / DISTANCE (.p0, .py)
  POINT .y.vec = TRANS (DX (.py) - DX (.p0), DY (.py) - DY (.p0), DZ (.py) - DZ (.p0))
  POINT .y.norm = TRANS (DX (.y.vec) * .cy, DY (.y.vec) * .cy, DZ (.y.vec) * .cy)
  ;
  POINT origin.shaft[hmi.shelf.no, hmi.task.no] = .p0
  POINT x.norm.shaft[hmi.shelf.no, hmi.task.no] =.x.norm
  POINT y.norm.shaft[hmi.shelf.no, hmi.task.no] =.y.norm
  ;
.END
.PROGRAM teach.shelf.dbl ()
  ;
  TOOL t.pin[1]
  SIGNAL gripper.close[1], -gripper.open[1]
  SIGNAL gripper.close[2], -gripper.open[2]
  ;
  JMOVE #shelf.safe.dbl
  ;
  ; Teach points for open shelf
  LMOVE shelf.open.dbl[hmi.shelf.no, 1] + TRANS (-350, 0, -20)
  LMOVE shelf.open.dbl[hmi.shelf.no, 1] + TRANS (0, 0, -20)
  ; Teach this point for shelf open
  BREAK
  LMOVE shelf.open.dbl[hmi.shelf.no, 1] ; **== TEACH POINT ==**
  ; Teach this point for shelf close
  BREAK
  LMOVE shelf.close.dbl[hmi.shelf.no, 2] ; **== TEACH POINT ==**
  ;
  LMOVE shelf.open.dbl[hmi.shelf.no, 1] + TRANS (0, 0, -20)
  LMOVE shelf.open.dbl[hmi.shelf.no, 1] + TRANS (-350, 0, -20)
  JMOVE #shelf.safe.dbl
  ;
  ; Teach points for close shelf
  LMOVE shelf.close.dbl[hmi.shelf.no, 1] + TRANS (-150, 0, 200)
  LMOVE shelf.close.dbl[hmi.shelf.no, 1] + TRANS (-150, 0, -20)
  LMOVE shelf.close.dbl[hmi.shelf.no, 1] + TRANS (0, 0, -20)
  ; Teach this point for shelf close
  BREAK
  LMOVE shelf.close.dbl[hmi.shelf.no, 1] ; **== TEACH POINT ==**
  ; Teach this point for shelf open
  BREAK
  LMOVE shelf.open.dbl[hmi.shelf.no, 2] ; **== TEACH POINT ==**
  ;
  LMOVE shelf.close.dbl[hmi.shelf.no, 1] + TRANS (0, 0, -20)
  LMOVE shelf.close.dbl[hmi.shelf.no, 1] + TRANS (-150, 0, -20)
  LMOVE shelf.close.dbl[hmi.shelf.no, 1] + TRANS (-150, 0, 200)
  ;
  JMOVE #shelf.safe.dbl
  ;
.END
.PROGRAM teach.shelf.par ()
