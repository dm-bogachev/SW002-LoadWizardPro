.PROGRAM tst.dbl.plate ()
  ;
  IF SIG (s.hmi.tool[1]) THEN
    .tool.no = 1
  ELSE
    .tool.no = 2
  END
  ;
  .z.cor = hmi.dbl.ch.work[.tool.no] + hmi.bush.length
  TOOL t.gripper[.tool.no] + TRANS (0, 0, .z.cor)
  ;
  POINT .p0 = origin.bush[hmi.shelf.no, hmi.task.no, .tool.no]
  POINT .x.norm = x.norm.bush[hmi.shelf.no, hmi.task.no, .tool.no]
  POINT .y.norm = y.norm.bush[hmi.shelf.no, hmi.task.no, .tool.no]
  ;
  JMOVE #wp.bush.safe[.tool.no]
  ;
  ; Test points
  ; Origin
  ;
  .dx = 0
  .dy = 0
  ;
  POINT .x.vec = TRANS (DX (.x.norm) * .dx, DY (.x.norm) * .dx, DZ (.x.norm) * .dx)
  POINT .y.vec = TRANS (DX (.y.norm) * .dy, DY (.y.norm) * .dy, DZ (.y.norm) * .dy)
  POINT .origin = TRANS (DX (.p0), DY (.p0), DZ (.p0))
  POINT .dest = .origin + .x.vec + .y.vec
  POINT/OAT .dest = .p0
  ;
  LAPPRO .dest, 30
  LMOVE .dest
  LAPPRO .dest, 30
  ;
  ; X-Direction
  ;
  .dx = (hmi.plate.rows - 1) * hmi.plate.dx
  .dy = 0
  ;
  POINT .x.vec = TRANS (DX (.x.norm) * .dx, DY (.x.norm) * .dx, DZ (.x.norm) * .dx)
  POINT .y.vec = TRANS (DX (.y.norm) * .dy, DY (.y.norm) * .dy, DZ (.y.norm) * .dy)
  POINT .origin = TRANS (DX (.p0), DY (.p0), DZ (.p0))
  POINT .dest = .origin + .x.vec + .y.vec
  POINT/OAT .dest = .p0
  ;
  LAPPRO .dest, 30
  LMOVE .dest
  LAPPRO .dest, 30
  ;
  ; Y-Direction
  ;
  .dx = 0
  .dy = (hmi.plate.col.o - 1) * hmi.plate.dy
  ;
  POINT .x.vec = TRANS (DX (.x.norm) * .dx, DY (.x.norm) * .dx, DZ (.x.norm) * .dx)
  POINT .y.vec = TRANS (DX (.y.norm) * .dy, DY (.y.norm) * .dy, DZ (.y.norm) * .dy)
  POINT .origin = TRANS (DX (.p0), DY (.p0), DZ (.p0))
  POINT .dest = .origin + .x.vec + .y.vec
  POINT/OAT .dest = .p0
  ;
  LAPPRO .dest, 30
  LMOVE .dest
  LAPPRO .dest, 30
  ;
  JMOVE #wp.bush.safe[.tool.no]
  ;
.END
.PROGRAM tst.prl.plate ()
  ;
  TOOL t.calib[3]
  ;
  POINT .p0 = origin.shaft[hmi.shelf.no, hmi.task.no]
  POINT .x.norm = x.norm.shaft[hmi.shelf.no, hmi.task.no]
  POINT .y.norm = y.norm.shaft[hmi.shelf.no, hmi.task.no]
  ;
  JMOVE #wp.shaft.safe
  ;
  ; Test points
  ; Origin
  ;
  .dx = 0
  .dy = 0
  ;
  POINT .x.vec = TRANS (DX (.x.norm) * .dx, DY (.x.norm) * .dx, DZ (.x.norm) * .dx)
  POINT .y.vec = TRANS (DX (.y.norm) * .dy, DY (.y.norm) * .dy, DZ (.y.norm) * .dy)
  POINT .origin = TRANS (DX (.p0), DY (.p0), DZ (.p0))
  POINT .dest = .origin + .x.vec + .y.vec
  POINT/OAT .dest = .p0
  ;
  LAPPRO .dest, 30
  LMOVE .dest
  LAPPRO .dest, 30
  ;
  ; X-Direction
  ;
  .dx = (hmi.plate.rows - 1) * hmi.plate.dx
  .dy = 0
  ;
  POINT .x.vec = TRANS (DX (.x.norm) * .dx, DY (.x.norm) * .dx, DZ (.x.norm) * .dx)
  POINT .y.vec = TRANS (DX (.y.norm) * .dy, DY (.y.norm) * .dy, DZ (.y.norm) * .dy)
  POINT .origin = TRANS (DX (.p0), DY (.p0), DZ (.p0))
  POINT .dest = .origin + .x.vec + .y.vec
  POINT/OAT .dest = .p0
  ;
  LAPPRO .dest, 30
  LMOVE .dest
  LAPPRO .dest, 30
  ;
  ; Y-Direction
  ;
  .dx = 0
  .dy = (hmi.plate.col.o - 1) * hmi.plate.dy
  ;
  POINT .x.vec = TRANS (DX (.x.norm) * .dx, DY (.x.norm) * .dx, DZ (.x.norm) * .dx)
  POINT .y.vec = TRANS (DX (.y.norm) * .dy, DY (.y.norm) * .dy, DZ (.y.norm) * .dy)
  POINT .origin = TRANS (DX (.p0), DY (.p0), DZ (.p0))
  POINT .dest = .origin + .x.vec + .y.vec
  POINT/OAT .dest = .p0
  ;
  LAPPRO .dest, 30
  LMOVE .dest
  LAPPRO .dest, 30
  ;
  JMOVE #wp.shaft.safe
  ;
.END
