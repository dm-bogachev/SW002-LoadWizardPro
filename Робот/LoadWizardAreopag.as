.PROGRAM cnc.pick.bush (.grip.no)
  ;
  .$temp = "Put bushing workpiece in CNC with tool:" + $ENCODE (.grip.no)
  CALL log (.$temp)
  ;
  SPEED 100 ALWAYS
  ACCURACY 10 ALWAYS
  CALL set.tool (grip.no.dbl[.grip.no])
  CALL gripper.open (grip.no.dbl[.grip.no], 0, gr.dbl.inv[.grip.no])
  CALL calc.rot.dbl (.grip.no)
  ;
  ; Calculate shifts
  .c1 = bush.wp2.len + gr.dbl.work[.grip.no] + cnc.ch.work
  .dz = .c1 - cnc.overshoot ;
  .c2 = cnc.ch.full - cnc.ch.work
  .z.appro = .c2 + cnc.overshoot + 10
  ;
  ; Calculate points
  POINT .temp = cnc.point.bush[.grip.no]
  POINT .put = .temp + TRANS (0, 0, -.dz)
  ;
  ; Approach
  SPEED 20 ALWAYS
  JMOVE #cnc.in
  ACCURACY 0.1
  LAPPRO .put, .z.appro
  BREAK;
  SPEED 30 MM/S
  LMOVE .put
  BREAK
  CALL gripper.close (grip.no.dbl[.grip.no], gp.dbl.cl.tmr[.grip.no], gr.dbl.inv[.grip.no])
  CALL chuck.open
  ;
  SIGNAL s.mcode.req
  gripper.dbl.id[.grip.no] = cnc.id
  gripper.dbl.st[.grip.no] = cnc.st
  cnc.id = 0
  cnc.st = -1
  ;
  ACCURACY 0.1
  LAPPRO .put, .z.appro
  BREAK
  LMOVE #cnc.in
  ;
.END
.PROGRAM cnc.pick.shaft ()
  ;
  .$temp = "Put shaft workpiece in CNC:"
  CALL log (.$temp)
  ;
  SPEED 100 ALWAYS
  ACCURACY 10 ALWAYS
  CALL set.tool (grip.no.par[1])
  CALL chuck.open
  CALL calc.rot.prl (shaft.rotate)
  ;
  IF shaft.rotate THEN
    .shaft.l = shaft.wp2.l1-shaft.wp2.l2
    .rz = 180
    .dir = -1
  ELSE
    .shaft.l = shaft.wp2.l2
    .rz = 0
    .dir = 1
  END
  ;
  .gc.len = gr.prl.full
  .gc.body = gr.prl.work
  .cncc.full = cnc.ch.full
  .cncc.body = cnc.ch.work
  ;
  ; Calculate shifts
  .dz = gr.prl.full - gr.prl.work
  .dy = .shaft.l + cnc.ch.work - cnc.overshoot
  .y.appro = cnc.ch.full + cnc.overshoot + 10
  ;
  ; Calculate points
  POINT .temp = cnc.point.shaft
  POINT .temp = .temp + RZ(.rz)
  POINT .pick = .temp + TRANS (0, .dir*.dy, -.dz)
  POINT .pick.appro[1]= .pick  + TRANS (0, 0, -100)
  POINT .pick.appro[2]= .pick  + TRANS (0, .dir*.y.appro, 0)
  ;
  ; Approach
  SPEED 20 ALWAYS
  JMOVE #cnc.in
  ACCURACY 0.1
  LMOVE .pick.appro[1]
  BREAK;
  SPEED 30 MM/S
  LMOVE .pick
  BREAK
  ;
  CALL gripper.close (grip.no.par[1], gp.par.cl.tmr, FALSE)
  CALL chuck.open
  ;
  gripper.prl.id = cnc.id
  gripper.prl.st = cnc.st
  cnc.id = 0
  cnc.st = -1
  ;
  ACCURACY 0.1
  LMOVE .pick.appro[2]
  BREAK
  LMOVE #cnc.in
  ;
.END
.PROGRAM cnc.put.bush (.grip.no)
  ;
  .$temp = "Put bushing workpiece in CNC with tool:" + $ENCODE (.grip.no)
  CALL log (.$temp)
  ;
  SPEED 100 ALWAYS
  ACCURACY 10 ALWAYS
  CALL set.tool (grip.no.dbl[.grip.no])
  CALL chuck.open 
  CALL calc.rot.dbl (.grip.no)
  ;
  IF NOT d.chg.required THEN
    .gr.dbl.work = gr.dbl.work[.grip.no]
  ELSE
    .gr.dbl.work = gr.dbl.work[3]
  END
  ;
  ; Calculate shifts
  .c1 = bush.wp0.len + gr.dbl.work[.grip.no] + cnc.ch.work
  .dz = .c1 - cnc.overshoot ;
  .c2 = cnc.ch.full - cnc.ch.work
  .z.appro = .c2 + cnc.overshoot + 10
  ;
  ; Calculate points
  POINT .temp = cnc.point.bush[.grip.no]
  POINT .put = .temp + TRANS (0, 0, -.dz)
  ;
  ; Approach
  SPEED 20 ALWAYS
  JMOVE #cnc.in
  ACCURACY 0.1
  LAPPRO .put, .z.appro
  BREAK;
  SPEED 30 MM/S
  LMOVE .put
  BREAK
  IF cnc.first THEN
    CALL log ("CNC close chuck first")
    CALL chuck.close 
    CALL gripper.open (grip.no.dbl[.grip.no], gp.dbl.op.tmr[.grip.no], gr.dbl.inv[.grip.no])
  ELSE
    CALL log ("Robot open chuck first")
    CALL gripper.open (grip.no.dbl[.grip.no], gp.dbl.op.tmr[.grip.no], gr.dbl.inv[.grip.no])
    CALL chuck.close 
  END
  ;
  SIGNAL s.mcode.req
  cnc.id = gripper.dbl.id[.grip.no]
  cnc.st = gripper.dbl.st[.grip.no]
  gripper.dbl.id[.grip.no] = 0
  gripper.dbl.st[.grip.no] = -1
  ;
  ACCURACY 0.1
  LAPPRO .put, .z.appro
  BREAK
  LMOVE #cnc.in
  CALL gripper.close (grip.no.dbl[.grip.no], 0, gr.dbl.inv[.grip.no])
  ;
.END
.PROGRAM cnc.put.shaft ()
  ;
  .$temp = "Put shaft workpiece in CNC" 
  CALL log (.$temp)
  ;
  SPEED 100 ALWAYS
  ACCURACY 10 ALWAYS
  CALL set.tool (grip.no.par[1])
  CALL calc.rot.prl (chg.required)
  ;
  IF chg.required THEN
    .shaft.l = shaft.wp0.l1-shaft.wp0.l2
    .rz = 180
    .dir = -1
  ELSE
    .shaft.l = shaft.wp0.l2
    .rz = 0
    .dir = 1
  END
  ;
  .gc.len = gr.prl.full
  .gc.body = gr.prl.work
  .cncc.full = cnc.ch.full
  .cncc.body = cnc.ch.work
  ;
  ; Calculate shifts
  .dz = gr.prl.full - gr.prl.work
  .dy = .shaft.l + cnc.ch.work - cnc.overshoot
  .y.appro = cnc.ch.full + cnc.overshoot + 10
  ;
  ; Calculate points
  POINT .temp = cnc.point.shaft
  POINT .temp = .temp + RZ(.rz)
  POINT .put = .temp + TRANS (0, .dir*.dy, -.dz)
  POINT .put.appro[1] = .put  + TRANS (0, .dir*.y.appro, 0)
  POINT .put.appro[2] = .put  + TRANS (0, 0, -100)
  ;
  ; Approach
  SPEED 20 ALWAYS
  JMOVE #cnc.in
  ACCURACY 0.1
  LMOVE .put.appro[1]
  BREAK;
  SPEED 30 MM/S
  LMOVE .put
  BREAK
  IF cnc.first THEN
    CALL log ("CNC close chuck first")
    CALL chuck.close
    CALL gripper.open (grip.no.par[1], gp.par.op.tmr, FALSE)
  ELSE
    CALL log ("Robot open chuck first")
    CALL gripper.open (grip.no.par[1], gp.par.op.tmr, FALSE)
    CALL chuck.close
  END
  ;
  SIGNAL s.mcode.req
  cnc.id = gripper.prl.id
  cnc.st = gripper.prl.st
  gripper.prl.id = 0
  gripper.prl.st = -1
  ;
  ACCURACY 0.1
  LMOVE .put.appro[2]
  BREAK
  LMOVE #cnc.in
  CALL gripper.close (grip.no.par[1], 0, FALSE)
  ;
.END
