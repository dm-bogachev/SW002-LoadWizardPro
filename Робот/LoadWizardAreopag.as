.PROGRAM cnc.pick.bush (.grip.no)
  ;
  .$temp = "Pick bushing workpiece in CNC with tool:" + $ENCODE (.grip.no)
  CALL log (.$temp)
  ;
  SPEED 100 ALWAYS
  ACCURACY 10 ALWAYS
  CALL set.tool (grip.no.dbl[.grip.no])
  CALL gripper.open (grip.no.dbl[.grip.no], 0, gr.dbl.inv[.grip.no])
  CALL calc.rot.dbl (.grip.no)
  ;
  ; Calculate shifts
  .c1 = bush.wp2.len + gr.dbl.work[.grip.no] + cnc.ch.work
  .dz = .c1 - cnc.overshoot ;
  .c2 = cnc.ch.full - cnc.ch.work
  .z.appro = .c2 + cnc.overshoot + 50
  ;
  ; Calculate points
  POINT .temp = cnc.point.bush[task.id, .grip.no]
  POINT .put = .temp + TRANS (0, 0, -.dz)
  ;
  ; Approach
  SPEED 20 ALWAYS
  JMOVE #cnc.in
  ACCURACY 0.1
  LAPPRO .put, .z.appro
  BREAK;
  SPEED 30 MM/S
  LMOVE .put
  BREAK
  CALL gripper.close (grip.no.dbl[.grip.no], gp.dbl.cl.tmr[.grip.no], gr.dbl.inv[.grip.no])
  CALL chuck.open
  ;
  SIGNAL s.mcode.req
  gripper.dbl.id[.grip.no] = cnc.id
  gripper.dbl.st[.grip.no] = cnc.st
  cnc.id = 0
  cnc.st = -1
  ;
  ACCURACY 0.1
  LAPPRO .put, .z.appro + 50
  BREAK
  LMOVE #cnc.in
  ;
.END
.PROGRAM cnc.pick.shaft ()
  ;
  .$temp = "Pick shaft workpiece in CNC:"
  CALL log (.$temp)
  ;
  SPEED 100 ALWAYS
  ACCURACY 10 ALWAYS
  CALL set.tool (grip.no.par[1])
  CALL gripper.open (grip.no.par[1], 0, FALSE)
  CALL calc.rot.prl (FALSE)
  ;
  BREAK
  IF shaft.rotate THEN
    .shaft.l = shaft.wp2.l1 - shaft.wp2.l2
    .rz = 0;180
    .dir = 1;-1
  ELSE
    .shaft.l = shaft.wp2.l2
    .rz = 0
    .dir = 1
  END
  ;
  IF cnc.through THEN
    .cnc.depth = cnc.put.dpth
  ELSE
    .cnc.depth = 0
  END
  ;
  .gc.len = gr.prl.full[1]
  .gc.body = gr.prl.work[1]
  .cncc.full = cnc.ch.full
  .cncc.body = cnc.ch.work
  ;
  ; Calculate shifts
  .dz = .gc.len - .gc.body
  IF NOT pick.stub THEN
    .dy = .shaft.l + .cncc.body  - .cnc.depth
    .y.appro = .cncc.full + .cnc.depth  + 30
  ELSE
    .dy = .cncc.body  + cnc.pick.ovr
    .y.appro = .cncc.full + .cncc.body  + cnc.pick.ovr  + 100
  END
  ;
  ; Calculate points
  POINT .temp = cnc.point.shaft[task.id]
  POINT .temp = .temp + RZ (.rz)
  POINT .pick = .temp + TRANS (0, .dir * .dy, -.dz)
  POINT .pick.appro[1]= .pick  + TRANS (0, .dir * .y.appro, -100)
  POINT .pick.appro[2]= .pick  + TRANS (0, .dir * .y.appro, 0)
  ;
  ; Approach
  SPEED 20 ALWAYS
  JMOVE #cnc.in
  ACCURACY 0.1
  LMOVE .pick.appro[1]
  LMOVE .pick.appro[2]
  BREAK;
  SPEED 30 MM/S
  LMOVE .pick
  BREAK
  ;
  CALL gripper.close (grip.no.par[1], gp.par.cl.tmr, FALSE)
  CALL chuck.open
  ;
  gripper.prl.id = cnc.id
  gripper.prl.st = cnc.st
  cnc.id = 0
  cnc.st = -1
  ;
  ACCURACY 0.1
  LMOVE .pick.appro[2]
  LMOVE .pick.appro[1]
  BREAK
  LMOVE #cnc.in
  ;
.END
.PROGRAM cnc.put.bush (.grip.no)
  ;
  .$temp = "Put bushing workpiece in CNC with tool:" + $ENCODE (.grip.no)
  CALL log (.$temp)
  ;
  SPEED 100 ALWAYS
  ACCURACY 10 ALWAYS
  CALL set.tool (grip.no.dbl[.grip.no])
  CALL chuck.open 
  CALL calc.rot.dbl (.grip.no)
  ;
  IF NOT d.chg.required THEN
    .gr.dbl.work = gr.dbl.work[.grip.no]
  ELSE
    .gr.dbl.work = gr.dbl.work[3]
  END
  ;
  ; Calculate shifts
  .c1 = bush.wp0.len + gr.dbl.work[.grip.no] + cnc.ch.work
  .dz = .c1 - cnc.overshoot ;
  .c2 = cnc.ch.full - cnc.ch.work
  .z.appro = .c2 + cnc.overshoot + 50
  ;
  ; Calculate points
  POINT .temp = cnc.point.bush[task.id, .grip.no]
  POINT .put = .temp + TRANS (0, 0, -.dz)
  ;
  ; Approach
  SPEED 20 ALWAYS
  JMOVE #cnc.in
  ACCURACY 0.1
  LAPPRO .put, .z.appro
  BREAK;
  SPEED 30 MM/S
  LMOVE .put
  BREAK
  IF cnc.first THEN
    CALL log ("CNC close chuck first")
    CALL chuck.close 
    CALL gripper.open (grip.no.dbl[.grip.no], gp.dbl.op.tmr[.grip.no], gr.dbl.inv[.grip.no])
  ELSE
    CALL log ("Robot open chuck first")
    CALL gripper.open (grip.no.dbl[.grip.no], gp.dbl.op.tmr[.grip.no], gr.dbl.inv[.grip.no])
    CALL chuck.close 
  END
  ;
  SIGNAL s.mcode.req
  cnc.id = gripper.dbl.id[.grip.no]
  cnc.st = gripper.dbl.st[.grip.no]
  gripper.dbl.id[.grip.no] = 0
  gripper.dbl.st[.grip.no] = -1
  ;
  ACCURACY 0.1
  LAPPRO .put, .z.appro + 50
  BREAK
  LMOVE #cnc.in
  CALL gripper.close (grip.no.dbl[.grip.no], 0, gr.dbl.inv[.grip.no])
  ;
.END
.PROGRAM cnc.put.shaft ()
  ;
  .$temp = "Put shaft workpiece in CNC"
  CALL log (.$temp)
  ;
  SPEED 100 ALWAYS
  ACCURACY 10 ALWAYS
  CALL set.tool (grip.no.par[1])
  CALL chuck.open 
  CALL calc.rot.prl (FALSE)
  ;
  BREAK
  ;.shaft.l = shaft.wp0.l2
  IF chg.required THEN
    .shaft.l = shaft.wp0.l1 - shaft.wp0.l2
  ELSE
    .shaft.l = shaft.wp0.l2
  END
  ;
  IF cnc.through THEN
    .cnc.depth = cnc.put.dpth 
  ELSE
    .cnc.depth = 0
  END
  ;
  .gc.len = gr.prl.full[2]
  .gc.body = gr.prl.work[2]
  .cncc.full = cnc.ch.full
  .cncc.body = cnc.ch.work
  ;
  ; Calculate shifts
  .dz = .gc.len - .gc.body
  .dy = .shaft.l - .cnc.depth + .cncc.body - cnc.overshoot
  .y.appro = .cnc.depth + .cncc.full + cnc.overshoot + 30
  ;
  ; Calculate points
  POINT .temp = cnc.point.shaft[task.id]
  POINT .put = .temp + TRANS (0, .dy, -.dz)
  POINT .put.appro[1] = .put  + TRANS (0, .y.appro, 0)
  POINT .put.appro[2] = .put  + TRANS (0, .y.appro, -100)
  ;
  ; Approach
  SPEED 20 ALWAYS
  JMOVE #cnc.in
  ACCURACY 0.1
  LMOVE .put.appro[1]
  BREAK;
  SPEED 30 MM/S
  LMOVE .put
  BREAK
  CALL log ("CNC close chuck first")
  CALL chuck.close
  CALL gripper.open (grip.no.par[1], gp.par.op.tmr, FALSE)
  ;
  SIGNAL s.mcode.req
  cnc.id = gripper.prl.id
  cnc.st = gripper.prl.st
  gripper.prl.id = 0
  gripper.prl.st = -1
  ;
  ACCURACY 0.1
  LMOVE .put.appro[1]
  LMOVE .put.appro[2]
  BREAK
  LMOVE #cnc.in
  CALL gripper.close (grip.no.par[1], 0, FALSE)
  ;
.END
.PROGRAM copy.buff (.source,.dest)
  ;
  POINT #buff.put.appro[.dest] = #buff.put.appro[.source]
  POINT #buff.put[.dest] = #buff.put[.source]
  POINT #buff.put.depar[.dest] = #buff.put.depar[.source]
  POINT #buff.pick.appro[.dest] = #buff.pick.appro[.source]
  POINT #buff.pick[.dest] = #buff.pick[.source]
  POINT #buff.pick.depar[.dest] = #buff.pick.depar[.source]
  ;
.END
