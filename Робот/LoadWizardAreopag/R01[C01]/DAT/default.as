; Move to home and home standby pos
  JMOVE #transport
;
.END
.PROGRAM autostart.pc()@26/10/05 17:40 #0
;
  CALL initialize.pc
;
;
  WHILE TRUE DO
;
    IF TASK(1002)<>1 THEN
      PCEXECUTE 2: safe.trace.pc
      TWAIT 1
    END
;
    CALL check.speed.pc
    CALL check.teach.pc
    CALL check.reset.pc
    CALL check.limits.pc
    CALL send.plc.pc
  END
;
.END
.PROGRAM buffer.flip(.task.id)@26/10/05 17:40 #0
;
  CALL log("Performing buffer flip")
  CALL set.tool(grip.no.dbl[1])
;
  SPEED 350 MM/S ALWAYS
  ACCURACY 10 ALWAYS
;
  JMOVE #shelf.safe.dbl
  LMOVE #buff.appro
  LMOVE #buff.safe[1]
  LMOVE #buff.put.appro[.task.id]
  SPEED 50 MM/S ALWAYS
  ACCURACY 0.1 ALWAYS
  LMOVE #buff.put[.task.id]
  BREAK
  CALL gripper.open(grip.no.dbl[1],gp.dbl.op.tmr[1],gr.dbl.inv[1])
  chg.id = gripper.dbl.id[1]
  chg.st = 0
  gripper.dbl.id[1] = 0
  gripper.dbl.st[1] = -1
;
  LMOVE #buff.put.depar[.task.id]
  SPEED 350 MM/S ALWAYS
  ACCURACY 10 ALWAYS
  LMOVE #buff.safe[1]
;
  chg.st = 1
;
  JMOVE #buff.safe[2]
  LMOVE #buff.pick.appro[.task.id]
  SPEED 50 MM/S ALWAYS
  ACCURACY 0.1 ALWAYS
  LMOVE #buff.pick[.task.id]
  BREAK
  CALL gripper.close(grip.no.dbl[1],gp.dbl.cl.tmr[1],gr.dbl.inv[1])
  gripper.dbl.id[1] = chg.id
  gripper.dbl.st[1] = chg.st
  chg.id = 0
  chg.st = -1
;
  LMOVE #buff.pick.depar[.task.id]
  SPEED 350 MM/S ALWAYS
  ACCURACY 10 ALWAYS
  LMOVE #buff.safe[2]
  JMOVE #buff.safe[1]
  LMOVE #buff.appro
  JMOVE #shelf.safe.dbl
  HOME
;
.END
.PROGRAM calc.rot.dbl(.grip.no)@26/10/05 17:40 #0
;
  .j6 = cnc.dbl.rot[.grip.no]
  DECOMPOSE .j[1] = #cnc.out.dbl.bas
  POINT #cnc.out = #PPOINT(.j[1],.j[2],.j[3],.j[4],.j[5],.j[6]+.j6)
  DECOMPOSE .j[1] = #cnc.in.dbl.base
  POINT #cnc.in = #PPOINT(.j[1],.j[2],.j[3],.j[4],.j[5],.j[6]+.j6)
;
  .$temp = "Calculated JT6 degree:"+$ENCODE(.j[6]+.j6)
  CALL log(.$temp)
;
.END
.PROGRAM calc.rot.prl(.rot.required)@26/10/05 17:40 #0
;
  IF NOT .rot.required THEN
    .j6 = cnc.prl.rot[1]
  ELSE
    .j6 = cnc.prl.rot[2]
  END
;
  DECOMPOSE .j[1] = #cnc.out.prl.bas
  POINT #cnc.out = #PPOINT(.j[1],.j[2],.j[3],.j[4],.j[5],.j[6]+.j6)
  DECOMPOSE .j[1] = #cnc.in.prl.base
  POINT #cnc.in = #PPOINT(.j[1],.j[2],.j[3],.j[4],.j[5],.j[6]+.j6)
;
  .$temp = "Calculated JT6 degree:"+$ENCODE(.j[6]+.j6)
  CALL log(.$temp)
;
.END
.PROGRAM calc.state.flag()@26/10/05 17:40 #0
;
  shelf.opened = SIG(eo.shelf.opened[current.shelf])
  shelf.closed = NOT shelf.opened
;
  gp.dbl.empty[1] = gripper.dbl.st[1]==-1
  gp.dbl.full[1] = NOT gp.dbl.empty[1]
  gp.dbl.wp0[1] = gripper.dbl.st[1]==0
  gp.dbl.wp1[1] = gripper.dbl.st[1]==1
  gp.dbl.wp2[1] = gripper.dbl.st[1]==2
;
  gp.dbl.empty[2] = gripper.dbl.st[2]==-1
  gp.dbl.full[2] = NOT gp.dbl.empty[2]
  gp.dbl.wp0[2] = gripper.dbl.st[2]==0
  gp.dbl.wp1[2] = gripper.dbl.st[2]==1
  gp.dbl.wp2[2] = gripper.dbl.st[2]==2
;
  gp.prl.empty = gripper.prl.st==-1
  gp.prl.full = NOT gp.prl.empty
  gp.prl.wp0 = gripper.prl.st==0
  gp.prl.wp1 = gripper.prl.st==1
  gp.prl.wp2 = gripper.prl.st==2
;
  cnc.empty = cnc.st==-1
  cnc.full = NOT cnc.empty
  cnc.wp0 = cnc.st==0
  cnc.wp1 = cnc.st==1
  cnc.wp2 = cnc.st==2
;
  .inside.cnc = SIG(s.inside.cnc)
  .outside.cnc = NOT .inside.cnc
  rout = shelf.opened AND .outside.cnc
  rin = shelf.opened AND .inside.cnc
;
  mfinish = SIG(s.mcode.req)
  n.max.pick = current.wp<=wp.count
  max.pick = NOT n.max.pick
;
.END
.PROGRAM check.limits.pc()@26/10/05 17:40 #7334598
;
  hmi.shelf.no = MINVAL(hmi.shelf.no,4)
  hmi.shelf.no = MAXVAL(hmi.shelf.no,1)
  hmi.task.no = MINVAL(hmi.task.no,180)
  hmi.task.no = MAXVAL(hmi.task.no,1)
;
.END
.PROGRAM check.reset.pc()@26/10/05 17:40 #7334598
;
  IF NOT SIG(di.ext.pgreset) THEN
    SIGNAL -s.reset.perf
  END
  IF SIG(di.ext.pgreset) THEN
    IF NOT SIG(s.reset.perf) THEN
      CALL log.pc1("Reset command executed")
; Resetting signals
      BITS eo.shelf.opened[1],4 = 0
;
      SIGNAL -eo.robot.ready
      SIGNAL -s.mcode.req
      SIGNAL -s.inside.cnc
;
      gripper.dbl.id[1] = 0
      gripper.dbl.st[1] = -1
      gripper.dbl.id[2] = 0
      gripper.dbl.st[2] = -1
;
      gripper.prl.id = 0
      gripper.prl.st = -1
;
      cnc.id = 0
      cnc.st = -1
;
      chg.id = 0
      chg.st = -1
;
      current.wp = 1
      processed.wp = 0
      current.shelf = 5
;
      state = 0
;
    END
    SIGNAL s.reset.perf
  END
;
.END
.PROGRAM check.speed.pc()@26/10/05 17:40 #7334604
;
  IF SIG(o.debug) THEN
    RETURN
  END
; Set speed from HMI at any time
  .speed = BITS(ei.robot.speed[0],16)
  .speed = MAXVAL(.speed,1)
  .speed = MINVAL(.speed,100)
  IF .speed<>MSPEED THEN
    MON_SPEED .speed
    CALL log.pc1("Speed"+$ENCODE(.speed)+" was applied")
  END
;
.END
.PROGRAM check.teach.pc()@26/10/05 17:40 #7334598
;
  IF NOT SWITCH(REPEAT ) THEN
;
    IF SIG(s.pr.a.home) THEN
      MC PRIME a.home
    END
; +
    IF SIG(s.tch.shlf.dbl) THEN
      MC PRIME teach.shelf.dbl
    END
; +
    IF SIG(s.tst.shlf.dbl) THEN
      MC PRIME test.shelf.dbl
    END
; +
    IF SIG(s.tch.shlf.prl) THEN
      MC PRIME teach.shelf.par
    END
; +
    IF SIG(s.tst.shlf.prl) THEN
      MC PRIME test.shelf.par
    END
;
; +
    IF SIG(s.tch.plate.dbl) THEN
      MC PRIME tch.dbl.plate
    END
; +
    IF SIG(s.tst.plate.dbl) THEN
      MC PRIME tst.dbl.plate
    END
; +
    IF SIG(s.tch.plate.prl) THEN
      MC PRIME tch.prl.plate
    END
; +
    IF SIG(s.tst.plate.prl) THEN
      MC PRIME tst.prl.plate
    END
;
    IF SIG(s.copy.plate) THEN
      IF hmi.task.copy>0 THEN
        .$src = $ENCODE(hmi.task.copy)
        .$dst = $ENCODE(hmi.task.no)
        CALL log.pc1("Perform copy from"+.$src+" to"+.$dst)
        CALL copy.plate.bush(hmi.task.copy,hmi.task.no)
        CALL copy.plate.shaf(hmi.task.copy,hmi.task.no)
        hmi.task.copy = -1
      END
    END
; +
    IF SIG(s.tst.wp.dbl.pi) THEN
      MC PRIME tst.wp.dbl.pick
    END
; +
    IF SIG(s.tst.wp.dbl.pu) THEN
      MC PRIME tst.wp.dbl.put
    END
; +
    IF SIG(s.tst.wp.prl.pi) THEN
      MC PRIME tst.wp.prl.pick
    END
; +
    IF SIG(s.tst.wp.prl.pu) THEN
      MC PRIME tst.wp.prl.put
    END
; +
    IF SIG(s.tch.buffer) THEN
      MC PRIME tch.buffer.flip
    END
; +
    IF SIG(s.tst.buffer) THEN
      MC PRIME tst.buffer.flip
    END
; +
    IF SIG(s.tch.cnc.d.app) THEN
      MC PRIME tch.cnc.dbl.app
    END
; +
    IF SIG(s.tch.cnc.p.app) THEN
      MC PRIME tch.cnc.prl.app
    END
; +
    IF SIG(s.tch.cnc.bush) THEN
      MC PRIME tch.cnc.bushing
    END
; +
    IF SIG(s.tch.cnc.shaft) THEN
      MC PRIME tch.cnc.shaft
    END
; +
    IF SIG(s.tst.cnc.bush) THEN
      MC PRIME tst.cnc.bushing
    END
; +
    IF SIG(s.tst.cnc.shaft) THEN
      MC PRIME tst.cnc.shaft
    END
;
  END
;
.END
