.PROGRAM a.home()@26/10/05 17:40 #0
;
; Set small speed
  SPEED 100 MM/S ALWAYS
  ACCURACY 0.01 ALWAYS
; Move to home pos
  HOME
;
.END
.PROGRAM a.main()@26/10/05 17:40 #0
;
  CALL log("Main program executed")
  CALL safe.home
;
  RUNMASK s.start.trace
  SIGNAL s.start.trace
;
  WHILE TRUE DO
    .$pg.string = "state"+$ENCODE(/L,state)
    IF EXISTPGM(.$pg.string) THEN
      SCALL .$pg.string
    ELSE
      CALL log("Error! Program is in wrong state. Reset state to 0")
      RETURN
    END
  END
;
.END
.PROGRAM a.transport()@26/10/05 17:40 #0
;
; Set small speed
