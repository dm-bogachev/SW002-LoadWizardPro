.PROGRAM safe.home()@26/10/05 17:40 #0
;
; Set small speed
  SPEED 100 MM/S ALWAYS
  ACCURACY 0.01 ALWAYS
;
  SIGNAL gripper.close[1],-gripper.open[1]
  SIGNAL gripper.close[2],-gripper.open[2]
  TWAIT 0.2
  SIGNAL gripper.open[1],-gripper.close[1]
  SIGNAL gripper.open[2],-gripper.close[2]
;
  BITS eo.shelf.unlock[1],4 = ^B1111
; Move to home pos
  .$tc = $ENCODE(max.trace.count)
  CALL log("Start moving to HOME position. Trace count ="+.$tc)
  FOR .i = max.trace.count-1 TO 0 STEP -1
    JMOVE #trace[.i]
  END
;
  BITS eo.shelf.unlock[1],4 = ^B0
;
.END
.PROGRAM safe.trace.pc()@26/10/05 17:40 #0
;
  max.trace.count = 0
  HERE .last.pos
  WHILE TRUE DO
    IF SIG(do.home) THEN
      max.trace.count = 1
      HERE .last.pos
      HERE #trace[0]
      TWAIT 1
    ELSE
      IF SIG(s.start.trace) THEN
        HERE .current.pos
        IF DISTANCE(.current.pos,.last.pos)>5 THEN
          HERE #trace[max.trace.count]
          HERE .last.pos
          max.trace.count = max.trace.count+1
        END
        TWAIT 0.1
;
      END
    END
  END
;
.END
