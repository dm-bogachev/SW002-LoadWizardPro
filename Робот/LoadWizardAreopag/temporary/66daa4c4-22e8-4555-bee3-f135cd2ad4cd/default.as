.PROGRAM shelf.close.dbl(.shelf.no)@26/09/26 21:20 #0
;
  CALL log("Closing shelf"+$ENCODE(.shelf.no)+" with double gripper")
;
  CALL gripper.close(grip.no.dbl[1],0,FALSE)
  CALL gripper.close(grip.no.dbl[2],0,FALSE)
  CALL set.tool(pin.double)
;
  POINT .#safe = #shelf.safe.dbl
  POINT .start = shelf.close.dbl[.shelf.no,1]
  POINT .end = shelf.close.dbl[.shelf.no,2]
;
  SPEED 350 MM/S ALWAYS
  ACCURACY 50 ALWAYS
;
  JMOVE .#safe
  $safe.flag = "shelf.safe"
; Change zone to small for avoiding lidar crossing
  IF .shelf.no==3 OR .shelf.no==4 THEN
    SIGNAL eo.lidar.small
  END
;
  LMOVE .start+TRANS(-150,0,200)
  LMOVE .start+TRANS(-150,0,-20)
  LMOVE .start+TRANS(0,0,-20)
  BREAK
  $safe.flag = "shelf.work"
; Set smaller speed
  SPEED 50 MM/S ALWAYS
  ACCURACY 0.1 ALWAYS
  LMOVE .start
  BREAK
; Open shelf
  CALL log("Request shelf"+$ENCODE(.shelf.no)+" unlock")
  SIGNAL eo.shelf.unlock[.shelf.no]
  WAIT BITS(ei.shelf.state[1],5)<>0
;
  IF NOT SIG(ei.shelf.failed) THEN
    CALL log("Shelf"+$ENCODE(.shelf.no)+" successfully unlocked")
    LMOVE .end
    BREAK
    LMOVE .end+TRANS(0,0,-20)
    BREAK
;
; Lock shelf
    SIGNAL -eo.shelf.unlock[.shelf.no]
    SIGNAL -eo.shelf.opened[.shelf.no]
;
    SPEED 350 MM/S ALWAYS
    ACCURACY 50 ALWAYS
    LMOVE .end+TRANS(-350,0,-20)
    LMOVE .#safe
    $safe.flag = "shelf.safe"
    BREAK
;
    RETURN
  ELSE
    CALL log("Failed to open shelf"+$ENCODE(.shelf.no)+". Task will be stopped")
    SIGNAL s.shelf.failed
    SIGNAL -eo.shelf.unlock[.shelf.no]
    LMOVE .start+TRANS(0,0,-20)
    BREAK
;
    SPEED 350 MM/S ALWAYS
    ACCURACY 50 ALWAYS
    LMOVE .start+TRANS(-150,0,-20)
    LMOVE .start+TRANS(-150,0,200)
    JMOVE .#safe
    $safe.flag = "shelf.safe"
    BREAK
;
    RETURN
  END
;
.END
.PROGRAM shelf.close.par(.shelf.no)@26/09/26 21:20 #2
;
  CALL log("Closing shelf"+$ENCODE(.shelf.no)+" with parallel gripper")
;
  CALL gripper.close(grip.no.par[1],0,FALSE)
  CALL set.tool(pin.parallel)
;
  POINT .#safe = #shelf.safe.par
  POINT .start = shelf.close.par[.shelf.no,1]
  POINT .end = shelf.close.par[.shelf.no,2]
;
  SPEED 350 MM/S ALWAYS
  ACCURACY 50 ALWAYS
;
  JMOVE .#safe
  $safe.flag = "shelf.safe"
; Change zone to small for avoiding lidar crossing
  IF .shelf.no==3 OR .shelf.no==4 THEN
    SIGNAL eo.lidar.small
  END
;
  LMOVE .start+TRANS(-150,-150,200)+RZ(70)
  LMOVE .start+TRANS(-150,-150,-20)+RZ(70)
  LMOVE .start+TRANS(-150,-150,-20)
  LMOVE .start+TRANS(0,0,-20)
  BREAK
;
  $safe.flag = "shelf.work"
; Set smaller speed
  SPEED 50 MM/S ALWAYS
  ACCURACY 0.1 ALWAYS
  LMOVE .start
  BREAK
; Open shelf
  CALL log("Request shelf"+$ENCODE(.shelf.no)+" unlock")
  SIGNAL eo.shelf.unlock[.shelf.no]
  WAIT BITS(ei.shelf.state[1],5)<>0
;
  IF NOT SIG(ei.shelf.failed) THEN
    CALL log("Shelf"+$ENCODE(.shelf.no)+" successfully unlocked")
    LMOVE .end
    BREAK
    LMOVE .end+TRANS(0,0,-20)
    BREAK
;
; Lock shelf
    SIGNAL -eo.shelf.unlock[.shelf.no]
    SIGNAL -eo.shelf.opened[.shelf.no]
;
    SPEED 350 MM/S ALWAYS
    ACCURACY 50 ALWAYS
    LMOVE .end+TRANS(-350,-350,-20)
    LMOVE .#safe
    $safe.flag = "shelf.safe"
    BREAK
;
    RETURN
  ELSE
    CALL log("Failed to open shelf"+$ENCODE(.shelf.no)+". Task will be stopped")
    SIGNAL s.shelf.failed
    SIGNAL -eo.shelf.unlock[.shelf.no]
    LMOVE .start+TRANS(0,0,-20)
    LMOVE .start+TRANS(-150,-150,-20)
    LMOVE .start+TRANS(-150,-150,-20)+RZ(70)
    LMOVE .start+TRANS(-150,-150,200)+RZ(70)
    BREAK
;
    SPEED 350 MM/S ALWAYS
    ACCURACY 50 ALWAYS
    LMOVE .start+TRANS(-350,-350,-20)
    JMOVE .#safe
    $safe.flag = "shelf.safe"
    BREAK
;
    RETURN
  END
;
