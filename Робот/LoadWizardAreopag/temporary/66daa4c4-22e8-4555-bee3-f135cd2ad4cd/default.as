.PROGRAM state1()@26/09/26 21:44 #3; Check ready shelves
;
  CALL log("State 1: Check ready shelves")
  WHILE TRUE DO
    IF NOT SIG(ei.task.start) THEN
      CALL log("Task signal was turned off by operator")
      state = 255
      RETURN
    END
;
    current.shelf = current.shelf-1
    IF current.shelf==0 THEN
      current.shelf = 4
    END
;
    IF SIG(ei.shelf.ready[current.shelf]) THEN
      CALL log("Shelf"+$ENCODE(current.shelf)+" is ready. Request data!")
;
      SIGNAL eo.data.request[current.shelf]
      SWAIT ei.data.ready
      SIGNAL -eo.data.request[current.shelf]
;
      gripper.dbl.id[1] = 0
      gripper.dbl.st[1] = -1
      gripper.dbl.id[2] = 0
      gripper.dbl.st[2] = -1
;
      gripper.prl.id = 0
      gripper.prl.st = -1
;
      cnc.id = 0
      cnc.st = -1
;
      chg.id = 0
      chg.st = -1
;
      current.wp = 1
      processed.wp = 0
;
      CALL get.task.data
;
      state = 99
      RETURN
    END
    HOME
  END
;
.END
