  .cx = 1/DISTANCE(.p0,.px)
  POINT .x.vec = TRANS(DX(.px)-DX(.p0),DY(.px)-DY(.p0),DZ(.px)-DZ(.p0))
  POINT .x.norm = TRANS(DX(.x.vec)*.cx,DY(.x.vec)*.cx,DZ(.x.vec)*.cx)
