  LMOVE shelf.close.dbl[hmi.shelf.no,1]+TRANS(0,0,-20)
  LMOVE shelf.close.dbl[hmi.shelf.no,1]+TRANS(-150,0,-20)
  LMOVE shelf.close.dbl[hmi.shelf.no,1]+TRANS(-150,0,200)
