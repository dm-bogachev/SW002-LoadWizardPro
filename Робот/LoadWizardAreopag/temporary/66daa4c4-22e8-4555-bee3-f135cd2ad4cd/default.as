  plt.cell.even = hmi.plate.col.e
  plt.dy = hmi.plate.dy
  plt.dx = hmi.plate.dx
  plt.even.dy = hmi.plate.e.dy
;
  cond.stp.cell = hmi.cond.cy
  cond.stp.row = hmi.cond.cx
  cond.stp.oy = hmi.cond.shift
;
  bush.wp0.len = hmi.bush.length
  bush.wp0.d = 0
  bush.wp2.len = hmi.bush.length
  bush.wp2.d = 0
;
  shaft.wp0.l1 = hmi.shaft.full
  shaft.wp0.l2 = hmi.shaft.pick
  shaft.wp0.l3 = hmi.cond.thick
  shaft.wp0.h = hmi.shaft.h
  shaft.wp0.d = 0
  shaft.wp2.l1 = hmi.shaft.full
  shaft.wp2.l2 = hmi.shaft.pick
  shaft.wp2.l3 = hmi.cond.thick
  shaft.wp2.h = hmi.shaft.h
