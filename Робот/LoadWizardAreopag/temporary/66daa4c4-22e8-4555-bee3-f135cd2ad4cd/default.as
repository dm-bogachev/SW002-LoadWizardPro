.PROGRAM id.to.ij.bush(.id,.i,.j)@26/09/26 21:20 #0
;
  .p = plt.cell.odd+plt.cell.even
  .pair = INT((.id-1)/.p)
  .offset = (.id-1) MOD .p
;
  IF .offset<plt.cell.odd THEN
    .i = 2*.pair
    .j = .offset
  ELSE
    .i = 2*.pair+1
    .j = .offset-plt.cell.odd
  END
;
  CALL log("ID:"+$ENCODE(.id)+" --> i:"+$ENCODE(.i)+" j:"+$ENCODE(.j))
;
.END
.PROGRAM id.to.ij.shaft(.id,.i,.j)@26/09/26 21:20 #24
;
;.cond.cell = INT(plt.cell.odd/cond.stp.cell)
;
  .p = 2+2
;
  .pair = INT((.id-1)/.p)
  .offset = (.id-1) MOD .p
;
  IF .offset<2 THEN
    .i = 2*.pair
    .j = .offset
  ELSE
    .i = 2*.pair+1
    .j = .offset-2
  END
;
  .i = .i*cond.stp.row
  .j = .j*cond.stp.cell
;
  CALL log("ID:"+$ENCODE(.id)+" --> i:"+$ENCODE(.i)+" j:"+$ENCODE(.j))
;
.END
