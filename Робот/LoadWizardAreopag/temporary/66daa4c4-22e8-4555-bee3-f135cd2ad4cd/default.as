.PROGRAM prep.points()@26/09/26 21:20 #0
;
  TOOL t.calib[3]
;
  JMOVE #wp.shaft.safe
;
  FOR .t = 1 TO 20
    hmi.task.no = .t
    .draw = 0
    FOR .i = 1 TO 4
      LMOVE #p0.shaft[1,1]; ***TEACH POINT***
      DRAW 0,0,-.draw
      BREAK
      HERE #p0.shaft[.i,.t]
;
      LMOVE #px.shaft[1,1]; ***TEACH POINT***
      DRAW 0,0,-.draw
      BREAK
      HERE #px.shaft[.i,.t]
;
      LMOVE #py.shaft[1,1]; ***TEACH POINT***
      DRAW 0,0,-.draw
      BREAK
      HERE #py.shaft[.i,.t]
      .draw = .draw+180
      hmi.shelf.no = .i
      CALL tch.prl.plate
    END
  END
.END
