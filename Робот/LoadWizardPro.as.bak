  ei.xmove.spd[0] = 1161 ; 8 bit
  ei.blow.spd[0] = 1169 ; 8 bit
  ei.overshoot[0] = 1177 ; 4 bit
  ;
  ei.t.grip.op[1, 0] = 1193 ; 8 bit
  ei.t.grip.cl[1, 0] = 1201 ; 8 bit
  ei.t.grip.op[2, 0] = 1209 ; 8 bit
  ei.t.grip.cl[2, 0] = 1217 ; 8 bit
