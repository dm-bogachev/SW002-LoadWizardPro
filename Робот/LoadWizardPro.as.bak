.PROGRAM pg0 ()
  ;
  state = 0
  CALL a.main
  ;
.END
.PROGRAM plate.teach ()
  ;
  ; Preparations for teaching
  IF SIG (s.hmi.tool.1) THEN
    .tool = 1
  ELSE
    .tool = 2
  END
  TOOL t.calib[.tool]
  ;
  JMOVE #wp.safe[.tool]
  ;
  JAPPRO #shelf.pt.o[hmi.shelf.no, .tool], 50
  LMOVE #shelf.pt.o[hmi.shelf.no, .tool] ; **== TEACH POINT ==**
  LAPPRO #shelf.pt.o[hmi.shelf.no, .tool], 50
  ;
  JAPPRO #shelf.pt.x[hmi.shelf.no, .tool], 50
  LMOVE #shelf.pt.x[hmi.shelf.no, .tool] ; **== TEACH POINT ==**
  LAPPRO #shelf.pt.x[hmi.shelf.no, .tool], 50
  ;
  JAPPRO #shelf.pt.y[hmi.shelf.no, .tool], 50
  LMOVE #shelf.pt.y[hmi.shelf.no, .tool] ; **== TEACH POINT ==**
  LAPPRO #shelf.pt.y[hmi.shelf.no, .tool], 50
  ;
  ; Calculation
  POINT .po = #shelf.pt.o[hmi.shelf.no, .tool]
  POINT .px = #shelf.pt.x[hmi.shelf.no, .tool]
  POINT .py = #shelf.pt.y[hmi.shelf.no, .tool]
  POINT .f = FRAME (.po, .px, .py, .py)
  POINT .f = .f + TRANS(-80, 0, 0)
  POINT shelf.frame[hmi.shelf.no, .tool] = .f
  ;
  JMOVE #wp.safe[.tool]
  ;
.END
.PROGRAM plate.test ()
  ; 
  ; Preparations for teaching
  IF SIG (s.hmi.tool.1) THEN
    .tool = 1
  ELSE
    .tool = 2
  END
  TOOL t.calib[.tool]
  ;
  JMOVE #wp.safe[.tool]
  ;
  JMOVE shelf.frame[hmi.shelf.no, .tool] + TRANS(80, 0, -20)
  LMOVE shelf.frame[hmi.shelf.no, .tool] + TRANS(80, 0, 0)
  LMOVE shelf.frame[hmi.shelf.no, .tool] + TRANS(80, 0, -20)
  ;
  JMOVE shelf.frame[hmi.shelf.no, .tool] + TRANS(390+80, 0, -20)
  LMOVE shelf.frame[hmi.shelf.no, .tool] + TRANS(390+80, 0, 0)
  LMOVE shelf.frame[hmi.shelf.no, .tool] + TRANS(390+80, 0, -20)
  ;
  JMOVE shelf.frame[hmi.shelf.no, .tool] + TRANS(80, -630, -20)
  LMOVE shelf.frame[hmi.shelf.no, .tool] + TRANS(80, -630, 0)
  LMOVE shelf.frame[hmi.shelf.no, .tool] + TRANS(80, -630, -20)
  ;
  JMOVE shelf.frame[hmi.shelf.no, .tool] + TRANS(390+80, -630, -20)
  LMOVE shelf.frame[hmi.shelf.no, .tool] + TRANS(390+80, -630, 0)
  LMOVE shelf.frame[hmi.shelf.no, .tool] + TRANS(390+80, -630, -20)
  ;
  JMOVE #wp.safe[.tool]
  ;
.END
.PROGRAM safe.home ()
  ;
  CALL gripper.close (1, 0, st3.reverse)
  CALL gripper.close (2, 0, st6.reverse)
  ;
  IF SIG (do.home) THEN
    CALL log ("Move robot from HOME to HOME STANDBY")
    JMOVE #homyak.sby
    $safe.flag = " "
    RETURN
  END
  ;
  IF SIG (do.home2) THEN
    CALL log ("Robot is already at home. Skip safe.home program")
    $safe.flag = " "
    RETURN
  END
  ;
  CALL log ("Performing safe movement to home position")
  SPEED 100 MM/S ALWAYS
  ACCURACY 0.01 ALWAYS
  ;
  SCASE $safe.flag OF
    SVALUE "shelf.work":
      CALL log ("Safe move from shelf")
      CALL set.tool (3)
      TDRAW -40, 0, 0
      TDRAW 0, 0, -60
      TDRAW 250, 0, 0
      JMOVE #shelf.safe
    SVALUE "shelf.safe":
      CALL log ("Safe move from shelf")
      CALL set.tool (3)
      JMOVE #shelf.safe
    SVALUE "wp.safe":
      CALL log ("Safe move from shelf")
      TDRAW 0, 0, -10
      JMOVE #wp.safe[current.tool]
    SVALUE "cnc.out":
      CALL log ("Safe move from CNC")
      LMOVE #cnc.out
    SVALUE "cnc.in":
      CALL log ("Safe move from CNC")
      TDRAW 0, 0, -40
      LMOVE #cnc.in
      LMOVE #cnc.out
  END
  ;
  JMOVE #homyak
  JMOVE #homyak.sby
  $safe.flag = " "
  CALL log ("Robot in home position")
  ;
  SIGNAL -s.inside.cnc
  ;
.END
.PROGRAM send.plc.pc ()
  ;
  SOUT eo.grip.opened[1] = gripper.opened[1]
  SOUT eo.grip.opened[2] = gripper.opened[2]
  SOUT eo.gp.sensor[1] = gripper.sensor[1]
  SOUT eo.gp.sensor[2] = gripper.sensor[2]
  ;
  BITS eo.grip.state[1, 0], 16 = gripper.id[1]
  BITS eo.grip.state[2, 0], 16 = gripper.id[2]
  BITS eo.cnc.state[1, 0], 16 = cnc.id[1]
  BITS eo.cnc.state[2, 0], 16 = cnc.id[2]
  BITS eo.wp.processed[0], 16 = processed.wp
  IF current.wp > wp.count THEN
    BITS eo.next.wp[0], 16 = -1
  ELSE
    BITS eo.next.wp[0], 16 = current.wp
  END
  ;
  ;IF SIG(do.error) THEN
  ;  BITS(eo.error.code[0], 16) = -ERROR
  ;END
  ;
.END
