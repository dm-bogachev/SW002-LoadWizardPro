.PROGRAM state1()@26/09/10 15:03 #0; Check ready shelves
;
  CALL log("State 1: Check ready shelves")
  WHILE TRUE DO
    IF NOT SIG(ei.task.start) THEN
      state = 255
      RETURN
    END
;
    current.shelf = current.shelf+1
    IF current.shelf==5 THEN
      current.shelf = 1
    END
;
    IF SIG(ei.shelf.ready[current.shelf]) THEN
      CALL log("Shelf"+$ENCODE(current.shelf)+" is ready. Request data!")
;
      SIGNAL eo.data.request[current.shelf]
      SWAIT ei.data.ready
      SIGNAL -eo.data.request[current.shelf]
;
      gripper.id[1] = 0
      gripper.id[2] = 0
      cnc.id[1] = 0
      cnc.id[2] = 0
      current.wp = 1
      processed.wp = 0
;
      CALL get.task.data
;
      IF air.blow[1] THEN
        SIGNAL s.p.put.air.req
      END
      IF air.blow[2] THEN
        SIGNAL s.a.pic.air.req
      END
;
      SPEED 100
      HOME
;
      state = 100
      RETURN
    END
    HOME 2
  END
;
.END
