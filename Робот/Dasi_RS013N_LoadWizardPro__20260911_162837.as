.PROGRAM state18()@26/09/10 15:03 #0; MCODE Execute
;
  CALL log("State 18: MCODE Execute")
;
  PULSE eo.cnc.mfinish,1
;
  IF cnc.id[1]<>0 THEN
    .current.chuck = 1
  ELSE
    .current.chuck = 2
  END
  IF wp2.pick[1] THEN
    .new.chuck = 1
  ELSE
    .new.chuck = 2
  END
;
  cnc.id[.current.chuck] = -cnc.id[.new.chuck]
  IF .current.chuck<>.new.chuck THEN
    cnc.id[.current.chuck] = 0
  END
  SIGNAL -s.mcode.req
;
  state = decision.state
;
.END
.PROGRAM state2()@26/09/10 15:03 #0; Open shelf
;
