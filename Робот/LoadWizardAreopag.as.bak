.PROGRAM get.from.hmi ()
  ;
  task.id = 1
  wp.count = hmi.wp.count
  ;
  wp.type.shaft = FALSE
  ;
  chg.required = FALSE
  shaft.return = FALSE
  shaft.rotate = FALSE
  gr.dbl.inv[1] = FALSE
  gr.dbl.inv[2] = FALSE
  ;
  gr.dbl.full[1] = hmi.dbl.ch.full[1]
  gr.dbl.work[1] = hmi.dbl.ch.work[1]
  gr.dbl.full[2] = hmi.dbl.ch.full[2]
  gr.dbl.work[2] = hmi.dbl.ch.work[2]
  ;
  gr.prl.full = hmi.prl.ch.full
  gr.prl.work = hmi.prl.ch.work
  ;
  cnc.ch.full = hmi.cnc.ch.full
  cnc.ch.work = hmi.cnc.ch.work
  ;
  plt.rows = hmi.plate.rows
  plt.cell.odd = hmi.plate.col.o
  plt.cell.even = hmi.plate.col.e
  plt.dy = hmi.plate.dy
  plt.dx = hmi.plate.dx
  plt.even.dy = hmi.plate.e.dy
  ;
  cond.stp.cell = hmi.cond.cy
  cond.stp.row = hmi.cond.cx
  cond.stp.oy = hmi.cond.shift
  ;
  bush.wp0.len = hmi.bush.length
  bush.wp0.d = 0
  bush.wp2.len = hmi.bush.length
  bush.wp2.d = 0
  ;
  shaft.wp0.l1 = hmi.shaft.full
  shaft.wp0.l2 = hmi.shaft.pick
  shaft.wp0.l3 = hmi.cond.thick
  shaft.wp0.h = hmi.shaft.h
  shaft.wp0.d = 0
  shaft.wp2.l1 = hmi.shaft.full
  shaft.wp2.l2 = hmi.shaft.pick
  shaft.wp2.l3 = hmi.cond.thick
  shaft.wp2.h = hmi.shaft.h
  shaft.wp2.d = 0
  ;
  chg.no = 1
  chg.h.cor = 0
  ;
.END
.PROGRAM get.from.plc ()
  ;
  task.id = BITS(d.task.id[0], 8)
  wp.count = BITS(d.wp.count[0], 8)
  ;
  wp.type.shaft = SIG(d.wp.type.shaft)
  chg.required = SIG (d.chg.required)
  shaft.return = SIG (d.shaft.return)
  shaft.rotate = SIG (d.shaft.rotate)
  gr.dbl.inv[1] = SIG (d.gr.dbl.inv[1])
  gr.dbl.inv[1] = SIG (d.gr.dbl.inv[1])
  ;
  gr.dbl.full[1] = BITS (d.gr.dbl.full[1, 0], 16)
  gr.dbl.work[1] = BITS (d.gr.dbl.work[1, 0], 16)
  gr.dbl.full[2] = BITS (d.gr.dbl.full[2, 0], 16)
  gr.dbl.work[2] = BITS (d.gr.dbl.work[2, 0], 16)
  ;
  gr.prl.full = BITS (d.gr.prl.full[0], 16)
  gr.prl.work = BITS (d.gr.prl.work[0], 16)
  ;
  cnc.ch.full = BITS (d.cnc.ch.full[0], 16)
  cnc.ch.work = BITS (d.cnc.ch.work[0], 16)
  ;
  plt.rows = BITS (d.plt.rows[0], 4)
  plt.cell.odd = BITS (d.plt.cell.odd[0], 4)
  plt.cell.even = BITS (d.plt.cell.even[0], 4)
  plt.dy = BITS (d.plt.dy[0], 16)
  plt.dx = BITS (d.plt.dx[0], 16)
  plt.even.dy = BITS (d.plt.even.dy[0], 16)
  ;
  cond.stp.cell = BITS (d.cond.stp.cell[0], 4)
  cond.stp.row = BITS (d.cond.stp.row[0], 4)
  cond.stp.oy = BITS (d.cond.stp.oy[0], 4)
  ;
  bush.wp0.len = BITS (d.bush.wp0.len[0], 16)
  bush.wp0.d = BITS (d.bush.wp0.d[0], 16)
  bush.wp2.len = BITS (d.bush.wp2.len[0], 16)
  bush.wp2.d = BITS (d.bush.wp2.d[0], 16)
  ;
  shaft.wp0.l1 = BITS (d.shaft.wp0.l1[0], 16)
  shaft.wp0.l2 = BITS (d.shaft.wp0.l2[0], 16)
  shaft.wp0.l3 = BITS (d.shaft.wp0.l3[0], 16)
  shaft.wp0.h = BITS (d.shaft.wp0.h[0], 16)
  shaft.wp0.d = BITS (d.shaft.wp0.d[0], 16)
  shaft.wp2.l1 = BITS (d.shaft.wp2.l1[0], 16)
  shaft.wp2.l2 = BITS (d.shaft.wp2.l2[0], 16)
  shaft.wp2.l3 = BITS (d.shaft.wp2.l3[0], 16)
  shaft.wp2.h = BITS (d.shaft.wp2.h[0], 16)
  shaft.wp2.d = BITS (d.shaft.wp2.d[0], 16)
  ;
  chg.no = BITS (d.chg.no[0], 4)
  chg.h.cor = BITS (d.chg.h.cor[0], 8)
  ;
.END
.PROGRAM get.system.data ()
  ;
  gp.par.op.tmr = 2
  gp.par.cl.tmr = 2
  gp.dbl.op.tmr[1] = 2
  gp.dbl.cl.tmr[1] = 2
  gp.dbl.op.tmr[2] = 2
  gp.dbl.cl.tmr[2] = 2
  ;
  cnc.first = FALSE
  ;
.END
.PROGRAM get.task.data ()
  ;
  CALL get.system.data
  ;
  IF SIG (o.debug) THEN
    CALL log ("DEBUG mod activated. Get task data from Robot HMI")
    CALL get.from.hmi
  ELSE
    CALL log ("Get task data from PLC")
    CALL get.from.plc
  END
  ;
.END
.PROGRAM grip.close.dbl (.gripper.no,.close.time,.inverse)
  ;
  ;IF SIG (ei.check.grip[.grip.no]) AND SIG (grip.opened[.grip.no]) THEN
  ;  CALL log ("Gripper" + $ENCODE (.grip.no) + "already opened")
  ;  RETURN
  ;END
  ;
  CALL log ("Command close double gripper" + $ENCODE (.close.time))
  ;
  IF NOT .inverse THEN
    SIGNAL gripper.close[.gripper.no], -gripper.open[.gripper.no]
  ELSE
    SIGNAL gripper.open[.gripper.no], -gripper.close[.gripper.no]
  END
  TWAIT .close.time
  
  ;
.END
.PROGRAM grip.close.par (.close.time)
  ;
  ;IF SIG (ei.check.grip[.grip.no]) AND SIG (grip.opened[.grip.no]) THEN
  ;  CALL log ("Gripper" + $ENCODE (.grip.no) + "already opened")
  ;  RETURN
  ;END
  ;
  CALL log ("Command close parallel gripper")
  ;
  SIGNAL gripper.close[2], -gripper.open[2]
  SIGNAL gripper.close[1], -gripper.open[1]
  TWAIT .close.time
  ;
.END
.PROGRAM grip.open.dbl (.gripper.no,.open.time,.inverse)
  ;
  ;IF SIG (ei.check.grip[.grip.no]) AND SIG (grip.opened[.grip.no]) THEN
  ;  CALL log ("Gripper" + $ENCODE (.grip.no) + "already opened")
  ;  RETURN
  ;END
  ;
  CALL log ("Command open double gripper" + $ENCODE (.gripper.no))
  ;
  IF NOT .inverse THEN
    SIGNAL gripper.open[.gripper.no], -gripper.close[.gripper.no]
  ELSE
    SIGNAL gripper.close[.gripper.no], -gripper.open[.gripper.no]
  END
  TWAIT .open.time
  ;
.END
.PROGRAM grip.open.par (.open.time)
  ;
  ;IF SIG (ei.check.grip[.grip.no]) AND SIG (grip.opened[.grip.no]) THEN
  ;  CALL log ("Gripper" + $ENCODE (.grip.no) + "already opened")
  ;  RETURN
  ;END
  ;
  CALL log ("Command open parallel gripper")
  ;
  SIGNAL gripper.close[2], -gripper.open[2]
  SIGNAL gripper.open[1], -gripper.close[1]
  TWAIT .open.time
  ;
.END
.PROGRAM grip.test.dbl ()
  ;
  FOR .i = 1 TO 5
    CALL gripper.open(1, 1.5, FALSE)
    CALL gripper.open(2, 1.5, FALSE)
    TWAIT 2
    CALL gripper.close(1, 1.5, FALSE)
    CALL gripper.close(2, 1.5, FALSE)
    TWAIT 2
  END
  ;
.END
.PROGRAM grip.test.prl ()
  ;
  FOR .i = 1 TO 5
    CALL gripper.open(3, 1.5, FALSE)
    TWAIT 2
    CALL gripper.close(3, 1.5, FALSE)
    TWAIT 2
  END
  ;
.END
.PROGRAM gripper.close (.gripper.no,.close.time,.inverse)
  ;
  ; .gripper.no:
  ; 1, 2 - Double
  ; 3 - Parallel
  ;
  IF .gripper.no == grip.no.par[1] THEN
    CALL grip.close.par(.close.time)
  ELSE
    CALL grip.close.dbl(.gripper.no, .close.time, .inverse)
  END
  ;
.END
.PROGRAM gripper.open (.gripper.no,.open.time,.inverse)
  ;
  ; .gripper.no:
  ; 1, 2 - Double
  ; 3 - Parallel
  ;
  IF .gripper.no == grip.no.par[1] THEN
    CALL grip.open.par(.open.time)
  ELSE
    CALL grip.open.dbl(.gripper.no, .open.time, .inverse)
  END
  ;
.END
.PROGRAM id.to.ij.bush (.id,.i,.j)
  ;
  .P = plt.cell.odd + plt.cell.even
  .pair = INT ((.id - 1) / .P)
  .offset = (.id - 1) MOD .P
  ;
  IF .offset < plt.cell.odd THEN
    .i = 2 * .pair
    .j = .offset
  ELSE
    .i = 2 * .pair + 1
    .j = .offset - plt.cell.odd
  END
  ;
  CALL log ("ID:" + $ENCODE (.id) + " --> i:" + $ENCODE (.i) + " j:" + $ENCODE (.j))
  ;
.END
.PROGRAM id.to.ij.shaft (.id,.i,.j)
  ;
  ;.cond.cell = INT(plt.cell.odd/cond.stp.cell)
  ;
  .P = 2 + 2
  ;
  .pair = INT ((.id - 1) / .P)
  .offset = (.id - 1) MOD .P
  ;
  IF .offset < 2 THEN
    .i = 2 * .pair
    .j = .offset
  ELSE
    .i = 2 * .pair + 1
    .j = .offset - 2
  END
  ;
  .i = .i*cond.stp.row
  .j = .j*cond.stp.cell
  ;
  CALL log ("ID:" + $ENCODE (.id) + " --> i:" + $ENCODE (.i) + " j:" + $ENCODE (.j))
  ;
.END
.PROGRAM initialize.pc ()
  ;
  CALL log.init
  CALL set.switches.pc
  CALL set.io.pc
  CALL set.vars.pc
  CALL disp.info.pc("F60")
  ;
  MC PRIME a.main
  TWAIT 0.5
  ;
  CALL log.pc1 ("Robot boot initialize completed")
  ;
.END
.PROGRAM log (.$msg)
	;
	IF LEN (.$msg) > 55 THEN
		.$msg = $LEFT (.$msg, 55)
	END
	;
	FOR .i = 1 TO log.max.count - 1
		$log.entry[.i] = $log.entry[.i + 1]
	END
	$log.entry[log.max.count] = $TIME + " " + .$msg
	;
	FOR .i = 0 TO 11
		.$tmp[.i] = $log.entry[log.max.count - (11 - .i)]
	END
	;
	IFPWPRINT 1, 1, 1, 9, 10 = .$tmp[0], .$tmp[1], .$tmp[2],  .$tmp[3]
	IFPWPRINT 2, 1, 1, 9, 10 = .$tmp[4], .$tmp[5], .$tmp[6],  .$tmp[7]
	IFPWPRINT 3, 1, 1, 9, 10 = .$tmp[8], .$tmp[9], .$tmp[10], .$tmp[11]
	;
.END
.PROGRAM log.clear ()
	;
	FOR .i = 1 TO log.max.count
		$log.entry[.i] = ""
	END
	;
.END
.PROGRAM log.init ()
	;
	; Change this number if needed
	log.max.count = 256
	;
	.$tmp1 = $ENCODE (/L, log.max.count)
	.$tmp2 = "$log.entry[" + .$tmp1 + "]"
	IF NOT EXISTCHAR (.$tmp2) THEN
		FOR .i = 1 TO log.max.count
			$log.entry[.i] = ""
		END
	END
	;
.END
.PROGRAM log.pc1 (.$msg)
	;
	IF LEN (.$msg) > 55 THEN
		.$msg = $LEFT (.$msg, 55)
	END
	;
	FOR .i = 1 TO log.max.count - 1
		$log.entry[.i] = $log.entry[.i + 1]
	END
	$log.entry[log.max.count] = $TIME + " " + .$msg
	;
	FOR .i = 0 TO 11
		.$tmp[.i] = $log.entry[log.max.count - (11 - .i)]
	END
	;
	IFPWPRINT 1, 1, 1, 9, 10 = .$tmp[0], .$tmp[1], .$tmp[2],  .$tmp[3]
	IFPWPRINT 2, 1, 1, 9, 10 = .$tmp[4], .$tmp[5], .$tmp[6],  .$tmp[7]
	IFPWPRINT 3, 1, 1, 9, 10 = .$tmp[8], .$tmp[9], .$tmp[10], .$tmp[11]
	;
.END
.PROGRAM pg0 ()
  ;
  state = 0
  CALL a.main 
  ;
.END
.PROGRAM prep.points ()
  ;
  TOOL t.calib[3]
  ;
  JMOVE #wp.shaft.safe
  ;
  FOR .t = 1 TO 20
    hmi.task.no = .t
    .draw = 0
    FOR .i = 1 TO 4
      LMOVE #p0.shaft[1, 1] ; ***TEACH POINT***
      DRAW 0, 0, -.draw
      BREAK
      HERE #p0.shaft[.i, .t]
      ;
      LMOVE #px.shaft[1, 1] ; ***TEACH POINT***
      DRAW 0, 0, -.draw
      BREAK
      HERE #px.shaft[.i, .t]
      ;
      LMOVE #py.shaft[1, 1] ; ***TEACH POINT***
      DRAW 0, 0, -.draw
      BREAK
      HERE #py.shaft[.i, .t]
      .draw = .draw + 180
      hmi.shelf.no = .i
      CALL tch.prl.plate
    END
    
    
  END
.END
.PROGRAM safe.home ()
  ;
  ; Set small speed
  SPEED 100 MM/S ALWAYS
  ACCURACY 0.01 ALWAYS
  ; Move to home pos
  HOME
  ;
.END
