.PROGRAM state0 () ; Initialization
  ;
  CALL log ("State 0: Initialization")
  ;
  SIGNAL eo.robot.ready
  CALL log ("Waiting for task start")
  SWAIT ei.task.start
  CALL log ("Task start command received")
  ;
  ; Resetting signals
  BITS eo.shelf.opened[1], 4 = 0
  ;
  SIGNAL eo.task.exec
  SIGNAL -eo.robot.ready
  SIGNAL -s.mcode.req
  SIGNAL -s.inside.cnc
  current.shelf = 0
  ;
  state = 1
  RETURN
  ;
.END
.PROGRAM state1 () ; Check ready shelves
  ;
  CALL log ("State 1: Check ready shelves")
  WHILE TRUE DO
    IF NOT SIG (ei.task.start) THEN
      CALL log ("Task signal was turned off by operator")
      state = 255
      RETURN
    END
    ;
    current.shelf = current.shelf + 1
    IF current.shelf == 5 THEN
      current.shelf = 1
    END
    ;
    IF SIG (ei.shelf.ready[current.shelf]) THEN
      CALL log ("Shelf" + $ENCODE (current.shelf) + " is ready. Request data!")
      ;
      SIGNAL eo.data.request[current.shelf]
      SWAIT ei.data.ready
      SIGNAL -eo.data.request[current.shelf]
      ;
      gripper.dbl.id[1] = 0
      gripper.dbl.st[1] = -1
      gripper.dbl.id[2] = 0
      gripper.dbl.st[2] = -1
      ;
      gripper.prl.id = 0
      gripper.prl.st = -1
      ;
      cnc.id = 0
      cnc.st = -1
      ;
      chg.id = 0
      chg.st = -1
      ;
      current.wp    = 1
      processed.wp  = 0
      ;
      CALL get.task.data
      ;
      SPEED 100
      HOME
      ;
      state = 99
      RETURN
    END
    HOME
  END
  ;
.END
.PROGRAM state100 () ; Select decision state for bushing type
  ;
  CALL log ("State 100: Select decision state for bushing type")
  ;
  IF NOT chg.required THEN
    decision.state = 101
  ELSE
    decision.state = 102
  END
  ;
  state = decision.state
  RETURN
  ;
.END
.PROGRAM state101 () ; Decision making module. Type: bushing; No buffer
  ;
  CALL log ("State 101: Decision making module. Type: bushing; No buffer")
  ;
  WHILE TRUE DO
    ;
    CALL calc.state.flag
    ;
    ; Open shelf in not opened
    IF shelf.closed THEN
      state = 110
      RETURN
    END
    ;
    ; Send MFINISH
    IF rout AND cnc.full AND mfinish THEN
      state = 116
      RETURN
    END
    ;
    ; Pick workpiece from shelf
    IF rout AND gp.dbl.empty[1] AND gp.dbl.empty[2] AND n.max.pick THEN
      state = 111
      RETURN
    END
    ;
    ; Move inside CNC
    ;
    IF rout AND (gp.dbl.full[1] AND cnc.empty OR gp.dbl.empty[2] AND cnc.full) THEN
      state = 112
      RETURN
    END
    ;
    ; Put workpiece to CNC
    IF rin AND gp.dbl.full[1] AND cnc.empty THEN
      state = 113
      RETURN
    END
    ;
    ; Pick detail from CNC
    IF rin AND gp.dbl.empty[2] AND cnc.wp2 THEN
      state = 114
      RETURN
    END
    ;
    ; Move outside cnc.in
    IF rin AND (gp.dbl.empty[1] AND cnc.full OR gp.dbl.full[2] AND cnc.empty) THEN
      state = 115
      RETURN
    END
    ;
    ; Put detail to stocker
    IF rout AND gp.dbl.full[2] AND gp.dbl.empty[1] THEN
      state = 117
      RETURN
    END
    ;
    ; Close shelf
    .ge = gp.dbl.empty[1] AND gp.dbl.empty[2]
    .ce = cnc.empty
    IF rout AND .ge AND .ce AND max.pick
      state = 118
      RETURN
    END
  END
  ;
.END
.PROGRAM state102 () ; Decision making module. Type: bushing; With buffer
  ;
  CALL log ("State 102: Decision making module. Type: bushing; With buffer")
  ;
  WHILE TRUE DO
    CALL calc.state.flag
    ;
  END
  ;
.END
.PROGRAM state110 () ; Open shelf with double gripper
  ;
  CALL log ("State 110: Open shelf with double gripper")
  CALL shelf.open (current.shelf, type.double)
  ;
  IF NOT SIG (s.shelf.failed) THEN
    state = decision.state
    RETURN
  ELSE
    state = 999
    RETURN
  END
  ;
.END
.PROGRAM state111 () ; Pick workpiece from shelf
  ;
  CALL log ("State 111: Pick workpiece from shelf")
  ;
  .grip.no = 1
  ;
  ;IF NOT SIG (do.home) THEN
  ;  HOME
  ;END
  ;
  JMOVE #wp.bush.safe[.grip.no]
  ;
  CALL wp.dbl.pick (.grip.no, current.shelf, current.wp)
  current.wp = current.wp + 1
  state = decision.state
  ;
  RETURN
  ;
.END
.PROGRAM state112 () ; Move inside CNC
  ;
  CALL log ("State 112: Move inside CNC")
  ;
  IF gp.dbl.full[1] AND cnc.empty THEN
    .grip.no = 1
  ELSE
    .grip.no = 2
  END
  ;
  HOME
  CALL cnc.in.bush (.grip.no)
  ;
  state = decision.state
  RETURN
  ;
.END
.PROGRAM state113 () ; Put workpiece to CNC
  ;
  CALL log ("State 113: Put workpiece to CNC")
  ;
  .grip.no = 1
  ;
  CALL cnc.put.bush(.grip.no)
  ;
  state = decision.state
  ;
.END
.PROGRAM state114 () ; Pick workpiece from CNC
  ;
  CALL log ("State 114: Pick workpiece from CNC")
  ;
  .grip.no = 2
  ;
  CALL cnc.pick.bush(.grip.no)
  ;
  state = decision.state
  ;
.END
.PROGRAM state115 () ; Move outside CNC
  ;
  CALL log ("State 115: Move outside CNC")
  ;
  IF gp.dbl.full[2] AND cnc.empty THEN
    .grip.no = 2
  ELSE
    .grip.no = 1
  END
  ;
  CALL cnc.out.bush (.grip.no)
  ;
  state = decision.state
  RETURN
  ;
.END
.PROGRAM state116 () ; MCODE Exexute
  ;
  CALL log ("State 116: MCODE Execute")
  ;
  PULSE eo.cnc.mfinish, 1
  SIGNAL -s.mcode.req
  cnc.st = 2
  ;
  state = decision.state
  ;
.END
.PROGRAM state117 () ; Put workpiece to shelf
  ;
  CALL log ("State 117: Put workpiece to shelf")
  ;
  .grip.no = 2 ;
  ;
  JMOVE #wp.bush.safe[.grip.no]
  ;
  .wp.id = ABS (gripper.dbl.id[.grip.no])
  CALL wp.dbl.put (.grip.no, current.shelf, .wp.id)
  ;
  state = decision.state
  ;
.END
.PROGRAM state118 () ; Close shelf with double gripper
  ;
  CALL log ("State 118: Close shelf with double gripper")
  CALL shelf.close (current.shelf, type.double)
  ;
  IF NOT SIG (s.shelf.failed) THEN
    state = 119
    RETURN
  ELSE
    state = 999
    RETURN
  END
  ;
.END
.PROGRAM state119 () ; Finish shelf
  ;
  CALL log("State 119: Finish shelf")
  PULSE eo.shelf.cmplt[current.shelf], 1
  ;
  SPEED 100 ALWAYS
  HOME
  ;
  state = 1
  ;
.END
.PROGRAM state200 () ; Select decision state for shaft type
  ;
  CALL log ("State 200: Select decision state for shaft type")
  ;
  IF NOT shaft.return THEN
    decision.state = 201
  ELSE
    decision.state = 202
  END
  ;
  state = decision.state
  RETURN
  ;
.END
