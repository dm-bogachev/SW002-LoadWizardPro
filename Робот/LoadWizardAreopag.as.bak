.PROGRAM set.switches.pc ()
	;
	; System switches
	CP ON
	PREFETCH.SIGINS OFF
	QTOOL OFF
	REP_ONCE ON
	HOLD.STEP ON
	DISP.EXESTEP ON
	PROG.DATE ON
	ABS.SPEED ON
	ERRSTART.PC ON
	autostart.pc ON
	;
.END
.PROGRAM set.tool (.tool.no)
  ;
  CASE .tool.no OF
    VALUE 1:
      ; Double gripper, tool 1
      TOOL t.gripper[1]
      CALL log ("Double gripper, tool 1 set")
    VALUE 2:
      ; Double gripper, tool 2
      TOOL t.gripper[2]
      CALL log ("Double gripper, tool 2 set")
    VALUE 3:
      ; Parallel gripper
      TOOL t.gripper[3]
      CALL log ("Parallel gripper set")
    VALUE 4:
      ; Double gripper, pin
      TOOL t.pin[1]
      CALL log ("Double gripper, pin set")
    VALUE 5:
      ; Parallel gripper, pin
      TOOL t.pin[2]
      CALL log ("Parallel gripper, pin set")
  END
  current.tool = .tool.no
  ;
  WEIGHT 20, 0, 0, 100, 0.1, 0.1, 0.1
  ;
.END
.PROGRAM set.vars.pc()@26/09/24 22:38 #1
  ;
  SETHOME 100, #PPOINT (0, 60, 120, 0, -90, 90)
  POINT #transport = #PPOINT (0, 50, -145, 0, -120, 0)
  ;
  POINT t.gripper[1] = TRANS (0, -83.3, 168, -90, 90, -180)
  POINT t.gripper[2] = TRANS (0, 83.3, 168, 90, 90, 180)
  POINT t.gripper[3] = TRANS (0, 0, 180, 90, 0, 0)
  POINT t.calib[3] = TRANS (0, 0, 280, 90, 0, 0)
  POINT t.pin[1] = TRANS (82, 0, 167, 0, 90, 180) ; +
  POINT t.pin[2] = TRANS (0, -80, 75, -90, 90, 90) ; +
  ;
  type.double = 0
  type.parallel = 1
  ;
  ; For set.tool function
  grip.no.dbl[1] = 1
  grip.no.dbl[2] = 2
  grip.no.par[1] = 3
  pin.double = 4
  pin.parallel = 5
  ;
  hmi.shelf.no = 1
  hmi.task.no = 1
  ;
  CALL ciner ("hmi.wp.count", hmi.wp.count, 16)
  ;
  CALL ciner ("hmi.bush.length", hmi.bush.length, 50)
  ;
  CALL ciner ("hmi.shaft.full", hmi.shaft.full, 130)
  CALL ciner ("hmi.shaft.pick", hmi.shaft.pick, 60)
  CALL ciner ("hmi.shaft.h", hmi.shaft.h, 78)
  CALL ciner ("hmi.cond.thick", hmi.cond.thick, 12)
  CALL ciner ("hmi.cond.shift", hmi.cond.shift, 28)
  CALL ciner ("hmi.cond.cx", hmi.cond.cx, 1)
  CALL ciner ("hmi.cond.cy", hmi.cond.cy, 4)
  CALL ciner ("hmi.prl.ch.full", hmi.prl.ch.full, 90)
  CALL ciner ("hmi.prl.ch.work", hmi.prl.ch.work, 16)
  ;
  CALL ciner ("hmi.plate.rows", hmi.plate.rows, 4)
  CALL ciner ("hmi.plate.col.o", hmi.plate.col.o, 6)
  CALL ciner ("hmi.plate.col.e", hmi.plate.col.e, 6)
  CALL ciner ("hmi.plate.dx", hmi.plate.dx, 110)
  CALL ciner ("hmi.plate.dy", hmi.plate.dy, 104)
  CALL ciner ("hmi.plate.e.dy", hmi.plate.e.dy, 0)
  CALL ciner ("hmi.dbl.ch.full[1]", hmi.dbl.ch.full[1], 40)
  CALL ciner ("hmi.dbl.ch.full[2]", hmi.dbl.ch.full[2], 40)
  CALL ciner ("hmi.dbl.ch.work[1]", hmi.dbl.ch.work[1], 29)
  CALL ciner ("hmi.dbl.ch.work[2]", hmi.dbl.ch.work[2], 29)
  CALL ciner ("hmi.cnc.ch.full", hmi.cnc.ch.full, 40)
  CALL ciner ("hmi.cnc.ch.work", hmi.cnc.ch.work, 28)
  ;
  shelf.overshoot = 5 ; Replace from HMI
  cnc.overshoot = 5 ; Replace from HMI
