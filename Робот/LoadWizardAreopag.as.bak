.PROGRAM a.home ()
  ;
  ; Set small speed
  SPEED 100 MM/S ALWAYS
  ACCURACY 0.01 ALWAYS
  ; Move to home pos
  HOME
  ;
.END
.PROGRAM a.main ()
  ;
  CALL log ("Main program executed")
  CALL safe.home
  ;
  WHILE TRUE DO
    .$pg.string = "state" + $ENCODE (/L, state)
    IF EXISTPGM (.$pg.string) THEN
      SCALL .$pg.string
    ELSE
      CALL log ("Error! Program is in wrong state. Reset state to 0")
      RETURN
    END
  END
  ;
.END
.PROGRAM a.transport ()
  ;
  ; Set small speed
  SPEED 100 MM/S ALWAYS
  ACCURACY 0.01 ALWAYS
  ; Move to home and home standby pos
  JMOVE #transport 
  ;
.END
.PROGRAM autostart.pc ()
  ;
  CALL initialize.pc
  ;
  WHILE TRUE DO
    CALL check.ifp.pc
  END
  ;
.END
.PROGRAM calc.rot.dbl (.grip.no)
  ;
  .j6 = cnc.dbl.rot[.grip.no]
  DECOMPOSE .j[1] = #cnc.out.dbl.bas
  POINT #cnc.out = #PPOINT (.j[1], .j[2], .j[3], .j[4], .j[5], .j[6] + .j6)
  DECOMPOSE .j[1] = #cnc.in.dbl.base
  POINT #cnc.in = #PPOINT (.j[1], .j[2], .j[3], .j[4], .j[5], .j[6] + .j6)
  ;
  .$temp = "Calculated JT6 degree:" + $ENCODE (.j[6] + .j6)
  CALL log(.$temp)
  ;
.END
.PROGRAM calc.rot.prl (.rot.required)
  ;
  IF NOT .rot.required THEN
    .j6 = cnc.prl.rot[1]
  ELSE
    .j6 = cnc.prl.rot[2]
  END
  ;
  DECOMPOSE .j[1] = #cnc.out.prl.bas
  POINT #cnc.out = #PPOINT (.j[1], .j[2], .j[3], .j[4], .j[5], .j[6] + .j6)
  DECOMPOSE .j[1] = #cnc.in.prl.base
  POINT #cnc.in = #PPOINT (.j[1], .j[2], .j[3], .j[4], .j[5], .j[6] + .j6)
  ;
  .$temp = "Calculated JT6 degree:" + $ENCODE (.j[6] + .j6)
  CALL log(.$temp)
  ;
.END
.PROGRAM calc.state.flag ()
  ;
  shelf.opened = SIG (eo.shelf.opened[current.shelf])
  shelf.closed = NOT shelf.opened
  ;
  gp.dbl.empty[1] = gripper.dbl.st[1] == -1
  gp.dbl.full[1] = NOT gp.dbl.empty[1]
  gp.dbl.wp0[1] = gripper.dbl.st[1] == 0
  gp.dbl.wp1[1] = gripper.dbl.st[1] == 1
  gp.dbl.wp2[1] = gripper.dbl.st[1] == 2
  ;
  gp.dbl.empty[2] = gripper.dbl.st[2] == -1
  gp.dbl.full[2] = NOT gp.dbl.empty[2]
  gp.dbl.wp0[2] = gripper.dbl.st[2] == 0
  gp.dbl.wp1[2] = gripper.dbl.st[2] == 1
  gp.dbl.wp2[2] = gripper.dbl.st[2] == 2
  ;
  gp.prl.empty = gripper.prl.st == -1
  gp.prl.full = NOT gp.prl.empty
  gp.prl.wp0 = gripper.prl.st == 0
  gp.prl.wp1 = gripper.prl.st == 1
  gp.prl.wp2 = gripper.prl.st == 2
  ;
  cnc.empty = cnc.st == -1
  cnc.full = NOT cnc.empty
  cnc.wp0 = cnc.st == 0
  cnc.wp1 = cnc.st == 1
  cnc.wp2 = cnc.st == 2
  ;
  .inside.cnc = SIG (s.inside.cnc)
  .outside.cnc = NOT .inside.cnc
  rout = shelf.opened AND .outside.cnc
  rin = shelf.opened AND .inside.cnc
  ;
  mfinish = SIG (s.mcode.req)
  n.max.pick = current.wp <= wp.count
  max.pick = NOT n.max.pick
  ;
.END
.PROGRAM check.ifp.pc ()
  ;
  IF SIG (s.grip.open[1]) THEN
    SIGNAL gripper.open[1], -gripper.close[1]
  END
  ;
  IF SIG (s.grip.open[2]) THEN
    SIGNAL gripper.open[2], -gripper.close[2]
  END
  ;
  IF SIG (s.grip.open[3]) THEN
    SIGNAL gripper.open[1], -gripper.close[1]
    SIGNAL gripper.close[2], -gripper.open[2]
  END
  ;
  IF SIG (s.grip.close[1]) THEN
    SIGNAL gripper.close[1], -gripper.open[1]
  END
  ;
  IF SIG (s.grip.close[2]) THEN
    SIGNAL gripper.close[2], -gripper.open[2]
  END
  ;
  IF SIG (s.grip.close[3]) THEN
    SIGNAL gripper.close[1], -gripper.open[1]
    SIGNAL gripper.close[2], -gripper.open[2]
  END
  ;
.END
.PROGRAM check.speed.pc ()
  ;
  IF SIG (o.debug) THEN
    RETURN
  END
  ; Set speed from HMI at any time
  .speed = BITS (ei.robot.speed[0], 16)
  .speed = MAXVAL (.speed, 1)
  .speed = MINVAL (.speed, 100)
  IF .speed <> MSPEED THEN
    MON_SPEED .speed
    CALL log.pc1 ("Speed" + $ENCODE (.speed) + " was applied")
  END
  ;
.END
.PROGRAM check.teach.pc ()
  ;
  IF NOT SWITCH (REPEAT ) THEN
    ;
    IF SIG(s.pr.a.home) THEN
      MC PRIME a.home
    END
  END
  ;
.END
.PROGRAM chuck.close ()
  ;
  CALL log ("Send CNC close chuck command")
  PULSE eo.cnc.ch.close, 2
  SWAIT ei.cnc.ch.clsd
  ;
.END
.PROGRAM chuck.open ()
  ;
  CALL log ("Send CNC open chuck command")
  PULSE eo.cnc.ch.open, 2
  SWAIT ei.cnc.ch.opd
  ;
.END
.PROGRAM ciner (.$var.name,.var,.default)
	;
	IF NOT EXISTREAL (.$var.name) THEN
		CALL log ("Variable " + .$var.name + " is not exist. Default:" + $ENCODE (.default))
		.var = .default
	END
	;
.END
.PROGRAM cnc.in.bush (.grip.no)
  ;
  .$temp = "Move inside CNC with double tool" + $ENCODE (.grip.no)
  CALL log (.$temp)
  ;
  SPEED 80 ALWAYS
  ACCURACY 10 ALWAYS
  CALL set.tool (grip.no.dbl[.grip.no])
  CALL calc.rot.dbl(.grip.no)
  ;
  HOME
  ;
  CALL log ("Waiting for CNC ready")
  SWAIT ei.cnc.ready
  CALL log ("CNC ready signal received")
  ;
  JMOVE #cnc.out
  BREAK
  SPEED 30
  LMOVE #cnc.in
  BREAK
  CALL log ("Robot inside CNC")
  SIGNAL s.inside.cnc
  ;
.END
.PROGRAM cnc.in.shaft (.rot.required)
  ;
  .$temp = "Move inside CNC with parallel tool"
  CALL log (.$temp)
  ;
  SPEED 80 ALWAYS
  ACCURACY 10 ALWAYS
  CALL set.tool (grip.no.par[1])
  CALL calc.rot.prl(.rot.required)
  ;
  HOME
  ;
  CALL log ("Waiting for CNC ready")
  SWAIT ei.cnc.ready
  CALL log ("CNC ready signal received")
  ;
  JMOVE #cnc.out
  BREAK
  SPEED 30
  LMOVE #cnc.in
  BREAK
  CALL log ("Robot inside CNC")
  SIGNAL s.inside.cnc
  ;
.END
.PROGRAM cnc.out.bush (.grip.no)
  ;
  .$temp = "Move outside CNC with double tool" + $ENCODE (.grip.no)
  CALL log (.$temp)
  ;
  SPEED 30 ALWAYS
  ACCURACY 10 ALWAYS
  CALL set.tool (grip.no.dbl[.grip.no])
  CALL calc.rot.dbl(.grip.no)
  ;
  LMOVE #cnc.in
  LMOVE #cnc.out
  BREAK
  CALL log ("Robot outside CNC")
  SIGNAL -s.inside.cnc
  ;
  SPEED 80
  HOME
  ;
.END
.PROGRAM cnc.out.shaft (.rot.required)
  ;
  .$temp = "Move outside CNC with parallel tool"
  CALL log (.$temp)
  ;
  SPEED 30 ALWAYS
  ACCURACY 10 ALWAYS
  CALL set.tool (grip.no.par[1])
  CALL calc.rot.prl(.rot.required)
  ;
  LMOVE #cnc.in
  LMOVE #cnc.out
  BREAK
  CALL log ("Robot outside CNC")
  SIGNAL -s.inside.cnc
  ;
  SPEED 80
  HOME
  ;
.END
.PROGRAM cnc.pick.bush (.grip.no)
  ;
  .$temp = "Put bushing workpiece in CNC with tool:" + $ENCODE (.grip.no)
  CALL log (.$temp)
  ;
  SPEED 100 ALWAYS
  ACCURACY 10 ALWAYS
  CALL set.tool (grip.no.dbl[.grip.no])
  CALL gripper.open (grip.no.dbl[.grip.no], 0, gr.dbl.inv[.grip.no])
  CALL calc.rot.dbl (.grip.no)
  ;
  ; Calculate shifts
  .c1 = bush.wp2.len + gr.dbl.work[.grip.no] + cnc.ch.work
  .dz = .c1 - cnc.overshoot ;
  .c2 = cnc.ch.full - cnc.ch.work
  .z.appro = .c2 + cnc.overshoot + 10
  ;
  ; Calculate points
  POINT .temp = cnc.point.bush[.grip.no]
  POINT .put = .temp + TRANS (0, 0, -.dz)
  ;
  ; Approach
  SPEED 20 ALWAYS
  JMOVE #cnc.in
  ACCURACY 0.1
  LAPPRO .put, .z.appro
  BREAK;
  SPEED 30 MM/S
  LMOVE .put
  BREAK
  CALL gripper.close (grip.no.dbl[.grip.no], gp.dbl.cl.tmr[.grip.no], gr.dbl.inv[.grip.no])
  CALL chuck.open
  ;
  SIGNAL s.mcode.req
  gripper.dbl.id[.grip.no] = cnc.id
  gripper.dbl.st[.grip.no] = cnc.st
  cnc.id = 0
  cnc.st = -1
  ;
  ACCURACY 0.1
  LAPPRO .put, .z.appro
  BREAK
  LMOVE #cnc.in
  ;
.END
.PROGRAM cnc.pick.shaft ()
  ;
  .$temp = "Put shaft workpiece in CNC:"
  CALL log (.$temp)
  ;
  SPEED 100 ALWAYS
  ACCURACY 10 ALWAYS
  CALL set.tool (grip.no.par[1])
  CALL chuck.open
  CALL calc.rot.prl (FALSE)
  ;
  .gc.len = gr.prl.full
  .gc.body = gr.prl.work
  .cncc.full = cnc.ch.full
  .cncc.body = cnc.ch.work
  ;
  ; Calculate shifts
  .dz = gr.prl.full - gr.prl.work
  .dy = shaft.wp0.l2 + cnc.ch.work - cnc.overshoot
  .y.appro = cnc.ch.full + cnc.overshoot + 10
  ;
  ; Calculate points
  POINT .temp = cnc.point.shaft
  POINT .pick = .temp + TRANS (0, .dy, -.dz)
  POINT .pick.appro = .pick  + TRANS (0, .y.appro, 0)
  ;
  ; Approach
  SPEED 20 ALWAYS
  JMOVE #cnc.in
  ACCURACY 0.1
  LMOVE .pick.appro
  BREAK;
  SPEED 30 MM/S
  LMOVE .pick
  BREAK
  ;
  CALL gripper.close (grip.no.par[1], gp.par.cl.tmr, FALSE)
  CALL chuck.open
  ;
  gripper.prl.id = cnc.id
  gripper.prl.st = cnc.st
  cnc.id = 0
  cnc.st = -1
  ;
  ACCURACY 0.1
  LMOVE .pick.appro
  BREAK
  LMOVE #cnc.in
  ;
.END
.PROGRAM cnc.put.bush (.grip.no)
  ;
  .$temp = "Put bushing workpiece in CNC with tool:" + $ENCODE (.grip.no)
  CALL log (.$temp)
  ;
  SPEED 100 ALWAYS
  ACCURACY 10 ALWAYS
  CALL set.tool (grip.no.dbl[.grip.no])
  CALL chuck.open 
  CALL calc.rot.dbl (.grip.no)
  ;
  ; Calculate shifts
  .c1 = bush.wp0.len + gr.dbl.work[.grip.no] + cnc.ch.work
  .dz = .c1 - cnc.overshoot ;
  .c2 = cnc.ch.full - cnc.ch.work
  .z.appro = .c2 + cnc.overshoot + 10
  ;
  ; Calculate points
  POINT .temp = cnc.point.bush[.grip.no]
  POINT .put = .temp + TRANS (0, 0, -.dz)
  ;
  ; Approach
  SPEED 20 ALWAYS
  JMOVE #cnc.in
  ACCURACY 0.1
  LAPPRO .put, .z.appro
  BREAK;
  SPEED 30 MM/S
  LMOVE .put
  BREAK
  IF cnc.first THEN
    CALL log ("CNC close chuck first")
    CALL chuck.close 
    CALL gripper.open (grip.no.dbl[.grip.no], gp.dbl.op.tmr[.grip.no], gr.dbl.inv[.grip.no])
  ELSE
    CALL log ("Robot open chuck first")
    CALL gripper.open (grip.no.dbl[.grip.no], gp.dbl.op.tmr[.grip.no], gr.dbl.inv[.grip.no])
    CALL chuck.close 
  END
  ;
  SIGNAL s.mcode.req
  cnc.id = gripper.dbl.id[.grip.no]
  cnc.st = gripper.dbl.st[.grip.no]
  gripper.dbl.id[.grip.no] = 0
  gripper.dbl.st[.grip.no] = -1
  ;
  ACCURACY 0.1
  LAPPRO .put, .z.appro
  BREAK
  LMOVE #cnc.in
  CALL gripper.close (grip.no.dbl[.grip.no], 0, gr.dbl.inv[.grip.no])
  ;
.END
.PROGRAM cnc.put.shaft ()
  ;
  .$temp = "Put shaft workpiece in CNC" 
  CALL log (.$temp)
  ;
  SPEED 100 ALWAYS
  ACCURACY 10 ALWAYS
  CALL set.tool (grip.no.par[1])
  CALL calc.rot.prl (FALSE)
  ;
  .gc.len = gr.prl.full
  .gc.body = gr.prl.work
  .cncc.full = cnc.ch.full
  .cncc.body = cnc.ch.work
  ;
  ; Calculate shifts
  .dz = gr.prl.full - gr.prl.work
  .dy = shaft.wp0.l2 + cnc.ch.work - cnc.overshoot
  .y.appro = cnc.ch.full + cnc.overshoot + 10
  ;
  ; Calculate points
  POINT .temp = cnc.point.shaft
  POINT .put = .temp + TRANS (0, .dy, -.dz)
  POINT .put.appro = .put  + TRANS (0, .y.appro, 0)
  ;
  ; Approach
  SPEED 20 ALWAYS
  JMOVE #cnc.in
  ACCURACY 0.1
  LMOVE .put.appro
  BREAK;
  SPEED 30 MM/S
  LMOVE .put
  BREAK
  IF cnc.first THEN
    CALL log ("CNC close chuck first")
    CALL chuck.close
    CALL gripper.open (grip.no.par[1], gp.par.op.tmr, FALSE)
  ELSE
    CALL log ("Robot open chuck first")
    CALL gripper.open (grip.no.par[1], gp.par.op.tmr, FALSE)
    CALL chuck.close
  END
  ;
  SIGNAL s.mcode.req
  cnc.id = gripper.prl.id
  cnc.st = gripper.prl.st
  gripper.prl.id = 0
  gripper.prl.st = -1
  ;
  ACCURACY 0.1
  LMOVE .put.appro
  BREAK
  LMOVE #cnc.in
  CALL gripper.close (grip.no.par[1], 0, FALSE)
  ;
.END
.PROGRAM disp.info.pc (.$cont.name)
  ;
  .$robot.name = $SYSDATA (ZROB.NAME)
  .robot.sn = SYSDATA (ZROB.MGFNO)
  .cont.sn = SYSDATA (CONT.NO)
  .$robot.str = "Robot: " + .$robot.name +" S/N: C" + $ENCODE (/L, .robot.sn)
  .$cont.str = "Controller: " + .$cont.name + " S/N: C" + $ENCODE (/L, .cont.sn)
  IFPWPRINT 8, 1, 1, 5, 10 = .$robot.str, .$cont.str, " ", "Powered by Robowizard Co.Ltd."
  ;
.END
