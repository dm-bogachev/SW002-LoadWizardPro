.PROGRAM state210 () ; Open shelf with parallel gripper
  ;
  CALL log ("State 210: Open shelf with parallel gripper")
  CALL shelf.open (current.shelf, type.parallel)
  ;
  IF NOT SIG (s.shelf.failed) THEN
    state = decision.state
    RETURN
  ELSE
    state = 999
    RETURN
  END
  ;
.END
.PROGRAM state211 () ; Pick workpiece from shelf
  ;
  CALL log ("State 211: Pick workpiece from shelf")
  ;
  IF NOT SIG (do.home) THEN
    HOME
  END
  ;
  JMOVE #wp.shaft.safe
  ;
  CALL wp.prl.pick (current.shelf, current.wp)
  current.wp = current.wp + 1
  state = decision.state
  ;
  RETURN
  ;
.END
.PROGRAM state212 () ; Move inside CNC
  ;
  CALL log ("State 212: Move inside CNC")
  ;
  HOME
  CALL cnc.in.shaft
  ;
  state = decision.state
  RETURN
  ;
.END
.PROGRAM state99 () ; Decide workpiece type
  ;
  CALL log ("State 99: Decide workpiece type")
  ;
  IF NOT wp.type.shaft THEN
    CALL log ("Work with bushing detail type")
    decision.type = 100
  ELSE
    CALL log ("Work with shaft detail type")
    decision.type = 200
  END
  ;
  state = decision.type
  RETURN
  ;
.END
.PROGRAM state999 () ; Task complete
  ;
  CALL log("State 999: Task complete")
  ;
  SIGNAL -eo.task.exec
  ;
  state = 0 
  RETURN
  ;
.END
.PROGRAM tch.cnc.bushing ()
  ;
  IF SIG (s.hmi.tool[1]) THEN
    .grip.no = 1
  ELSE
    .grip.no = 2
  END
  ;
  .gc.full = hmi.dbl.ch.full[.grip.no]
  .gc.body = hmi.dbl.ch.work[.grip.no]
  .cncc.full = hmi.cnc.ch.full
  .cncc.body = hmi.cnc.ch.work
  ;
  TOOL t.gripper[.grip.no]
  CALL calc.rot.dbl (.grip.no)
  ;
  JMOVE #cnc.out
  LMOVE #cnc.in
  ;
  LAPPRO #cnc.point.bush[.grip.no], 50
  ; Teach this point 
  BREAK
  LMOVE #cnc.point.bush[.grip.no]  ; **== TEACH POINT ==**
  LAPPRO #cnc.point.bush[.grip.no], 50
  ;
  POINT .temp = #cnc.point.bush[.grip.no]
  .zshift = .gc.body + .cncc.body + hmi.bush.length
  POINT cnc.point.bush[.grip.no] = .temp + TRANS (, , .zshift)
  ;
  POINT .temp = cnc.point.bush[.grip.no] + TRANS (, , -.zshift)
  LAPPRO .temp, 50
  LMOVE .temp
  LAPPRO .temp, 50
  ;
.END
.PROGRAM tch.cnc.dbl.app ()
  ;
  JMOVE #cnc.out.dbl.bas ; ***TEACH POINT***
  LMOVE #cnc.in.dbl.base ; ***TEACH POINT***
  ;
.END
.PROGRAM tch.cnc.prl.app ()
  ;
  JMOVE #cnc.out.prl.bas ; ***TEACH POINT***
  LMOVE #cnc.in.prl.base ; ***TEACH POINT***
  ;
.END
.PROGRAM tch.cnc.shaft ()
  ;
  .gc.len = hmi.prl.ch.full
  .gc.body = hmi.prl.ch.work
  .cncc.full = hmi.cnc.ch.full
  .cncc.body = hmi.cnc.ch.work
  ;
  TOOL t.gripper[3]
  CALL calc.rot.prl (FALSE)
  ;
  JMOVE #cnc.out
  LMOVE #cnc.in
  ;
  POINT .t = #cnc.point.shaft
  POINT .t = .t + TRANS(0,150,0)
  LMOVE .t
  ; Teach this point 
  BREAK
  LMOVE #cnc.point.shaft  ; **== TEACH POINT ==**
  POINT .t = #cnc.point.shaft
  POINT .t = .t + TRANS(0,150,0)
  LMOVE .t
  ;
  POINT .temp = #cnc.point.shaft
  .zshift = .gc.len - .gc.body;
  .yshift = hmi.cnc.ch.work + hmi.shaft.pick
  POINT cnc.point.shaft = .temp + TRANS (, -.yshift, .zshift)
  ;
  POINT .temp = cnc.point.shaft + TRANS (, .yshift, -.zshift)
  POINT .temp.appro = .temp + TRANS(0, 150, 0 )
  LMOVE .temp.appro
  LMOVE .temp
  LMOVE .temp.appro
  ;
.END
.PROGRAM tch.dbl.plate ()
  ;
  IF SIG (s.hmi.tool[1]) THEN
    .tool.no = 1
  ELSE
    .tool.no = 2
  END
  ;
  .z.cor = hmi.dbl.ch.work[.tool.no] + hmi.bush.length
  TOOL t.gripper[.tool.no] + TRANS(0, 0, .z.cor)
  ;
  JMOVE #wp.bush.safe[.tool.no]
  ;
  LAPPRO #p0.bush[hmi.shelf.no, hmi.task.no, .tool.no], 20
  BREAK
  ; Zero point
  LMOVE #p0.bush[hmi.shelf.no, hmi.task.no, .tool.no] ; ***TEACH POINT***
  LAPPRO #p0.bush[hmi.shelf.no, hmi.task.no, .tool.no], 20
  ;
  LAPPRO #px.bush[hmi.shelf.no, hmi.task.no, .tool.no], 20
  BREAK
  ; X-direction
  LMOVE #px.bush[hmi.shelf.no, hmi.task.no, .tool.no] ; ***TEACH POINT***
  LAPPRO #px.bush[hmi.shelf.no, hmi.task.no, .tool.no], 20
  ;
  LAPPRO #py.bush[hmi.shelf.no, hmi.task.no, .tool.no], 20
  BREAK
  ; Y-direction
  LMOVE #py.bush[hmi.shelf.no, hmi.task.no, .tool.no] ; ***TEACH POINT***
  LAPPRO #py.bush[hmi.shelf.no, hmi.task.no, .tool.no], 20
  ;
  ; Calculation
  POINT .p0 = #p0.bush[hmi.shelf.no, hmi.task.no, .tool.no]
  POINT .px = #px.bush[hmi.shelf.no, hmi.task.no, .tool.no]
  POINT .py = #py.bush[hmi.shelf.no, hmi.task.no, .tool.no]
  ;
  ; Direction vectors
  ; X
  .cx = 1 / DISTANCE (.p0, .px)
  POINT .x.vec = TRANS (DX (.px) - DX (.p0), DY (.px) - DY (.p0), DZ (.px) - DZ (.p0))
  POINT .x.norm = TRANS (DX (.x.vec) * .cx, DY (.x.vec) * .cx, DZ (.x.vec) * .cx)
  ; Y
  .cy = 1 / DISTANCE (.p0, .py)
  POINT .y.vec = TRANS (DX (.py) - DX (.p0), DY (.py) - DY (.p0), DZ (.py) - DZ (.p0))
  POINT .y.norm = TRANS (DX (.y.vec) * .cy, DY (.y.vec) * .cy, DZ (.y.vec) * .cy)
  ;
  POINT origin.bush[hmi.shelf.no, hmi.task.no, .tool.no] = .p0
  POINT x.norm.bush[hmi.shelf.no, hmi.task.no, .tool.no] =.x.norm
  POINT y.norm.bush[hmi.shelf.no, hmi.task.no, .tool.no] =.y.norm
  ;
.END
.PROGRAM tch.prl.plate ()
  ;
  TOOL t.calib[3]
  ;
  JMOVE #wp.shaft.safe
  ;
  LAPPRO #p0.shaft[hmi.shelf.no, hmi.task.no], 20
  BREAK
  ; Zero point
  LMOVE #p0.shaft[hmi.shelf.no, hmi.task.no] ; ***TEACH POINT***
  LAPPRO #p0.shaft[hmi.shelf.no, hmi.task.no], 20
  ;
  LAPPRO #px.shaft[hmi.shelf.no, hmi.task.no], 20
  BREAK
  ; X-direction
  LMOVE #px.shaft[hmi.shelf.no, hmi.task.no] ; ***TEACH POINT***
  LAPPRO #px.shaft[hmi.shelf.no, hmi.task.no], 20
  ;
  LAPPRO #py.shaft[hmi.shelf.no, hmi.task.no], 20
  BREAK
  ; Y-direction
  LMOVE #py.shaft[hmi.shelf.no, hmi.task.no] ; ***TEACH POINT***
  LAPPRO #py.shaft[hmi.shelf.no, hmi.task.no], 20
  ;
  ; Calculation
  POINT .p0 = #p0.shaft[hmi.shelf.no, hmi.task.no]
  POINT .px = #px.shaft[hmi.shelf.no, hmi.task.no]
  POINT .py = #py.shaft[hmi.shelf.no, hmi.task.no]
  ;
  ; Direction vectors
  ; X
  .cx = 1 / DISTANCE (.p0, .px)
  POINT .x.vec = TRANS (DX (.px) - DX (.p0), DY (.px) - DY (.p0), DZ (.px) - DZ (.p0))
  POINT .x.norm = TRANS (DX (.x.vec) * .cx, DY (.x.vec) * .cx, DZ (.x.vec) * .cx)
  ; Y
  .cy = 1 / DISTANCE (.p0, .py)
  POINT .y.vec = TRANS (DX (.py) - DX (.p0), DY (.py) - DY (.p0), DZ (.py) - DZ (.p0))
  POINT .y.norm = TRANS (DX (.y.vec) * .cy, DY (.y.vec) * .cy, DZ (.y.vec) * .cy)
  ;
  POINT origin.shaft[hmi.shelf.no, hmi.task.no] = .p0
  POINT x.norm.shaft[hmi.shelf.no, hmi.task.no] =.x.norm
  POINT y.norm.shaft[hmi.shelf.no, hmi.task.no] =.y.norm
  ;
.END
.PROGRAM teach.shelf.dbl ()
  ;
  TOOL t.pin[1]
  SIGNAL gripper.close[1], -gripper.open[1]
  SIGNAL gripper.close[2], -gripper.open[2]
  ;
  JMOVE #shelf.safe.dbl
  ;
  ; Teach points for open shelf
  LMOVE shelf.open.dbl[hmi.shelf.no, 1] + TRANS (-350, 0, -20)
  LMOVE shelf.open.dbl[hmi.shelf.no, 1] + TRANS (0, 0, -20)
  ; Teach this point for shelf open
  BREAK
  LMOVE shelf.open.dbl[hmi.shelf.no, 1] ; **== TEACH POINT ==**
  ; Teach this point for shelf close
  BREAK
  LMOVE shelf.close.dbl[hmi.shelf.no, 2] ; **== TEACH POINT ==**
  ;
  LMOVE shelf.open.dbl[hmi.shelf.no, 1] + TRANS (0, 0, -20)
  LMOVE shelf.open.dbl[hmi.shelf.no, 1] + TRANS (-350, 0, -20)
  JMOVE #shelf.safe.dbl
  ;
  ; Teach points for close shelf
  LMOVE shelf.close.dbl[hmi.shelf.no, 1] + TRANS (-150, 0, 200)
  LMOVE shelf.close.dbl[hmi.shelf.no, 1] + TRANS (-150, 0, -20)
  LMOVE shelf.close.dbl[hmi.shelf.no, 1] + TRANS (0, 0, -20)
  ; Teach this point for shelf close
  BREAK
  LMOVE shelf.close.dbl[hmi.shelf.no, 1] ; **== TEACH POINT ==**
  ; Teach this point for shelf open
  BREAK
  LMOVE shelf.open.dbl[hmi.shelf.no, 2] ; **== TEACH POINT ==**
  ;
  LMOVE shelf.close.dbl[hmi.shelf.no, 1] + TRANS (0, 0, -20)
  LMOVE shelf.close.dbl[hmi.shelf.no, 1] + TRANS (-150, 0, -20)
  LMOVE shelf.close.dbl[hmi.shelf.no, 1] + TRANS (-150, 0, 200)
  ;
  JMOVE #shelf.safe.dbl
  ;
.END
.PROGRAM teach.shelf.par ()
  ;
  TOOL t.pin[2]
  SIGNAL gripper.close[1], -gripper.open[1]
  SIGNAL gripper.close[2], -gripper.open[2]
  ;
  JMOVE #shelf.safe.par
  ;
  ; Teach points for open shelf
  LMOVE shelf.open.par[hmi.shelf.no, 1] + TRANS (-50, 0, -150)
  LMOVE shelf.open.par[hmi.shelf.no, 1] + TRANS (-50, 0, 0)
  ; Teach this point for shelf open
  BREAK
  LMOVE shelf.open.par[hmi.shelf.no, 1] ; **== TEACH POINT ==**
  ; Teach this point for shelf close
  BREAK
  LMOVE shelf.close.par[hmi.shelf.no, 2] ; **== TEACH POINT ==**
  ;
  LMOVE shelf.open.par[hmi.shelf.no, 1] + TRANS (-50, 0, 0)
  LMOVE shelf.open.par[hmi.shelf.no, 1] + TRANS (-50, 0, -150)
  JMOVE #shelf.safe.par
  ;
  ; Teach points for close shelf
  LMOVE shelf.close.par[hmi.shelf.no, 1] + TRANS (150, 0, -150)
  LMOVE shelf.close.par[hmi.shelf.no, 1] + TRANS (-50, 0, -150)
  LMOVE shelf.close.par[hmi.shelf.no, 1] + TRANS (-50, 0, 0)
  ; Teach this point for shelf close
  BREAK
  LMOVE shelf.close.par[hmi.shelf.no, 1] ; **== TEACH POINT ==**
  ; Teach this point for shelf open
  BREAK
  LMOVE shelf.open.par[hmi.shelf.no, 2] ; **== TEACH POINT ==**
  ;
  LMOVE shelf.close.par[hmi.shelf.no, 1] + TRANS (-50, 0, 0)
  LMOVE shelf.close.par[hmi.shelf.no, 1] + TRANS (-50, 0, -150)
  LMOVE shelf.close.par[hmi.shelf.no, 1] + TRANS (150, 0, -150)
  JMOVE #shelf.safe.par
  ;
.END
.PROGRAM test.shelf.dbl ()
  ;
  CALL shelf.open.dbl (hmi.shelf.no)
  CALL shelf.close.dbl (hmi.shelf.no)
  ;
.END
.PROGRAM test.shelf.par ()
  ;
  CALL shelf.open.par (hmi.shelf.no)
  CALL shelf.close.par (hmi.shelf.no)
  ;
.END
.PROGRAM tst.cnc.bushing ()
  ;
  CALL get.task.data
  ;
  CALL cnc.put.bush(1)
  CALL cnc.pick.bush(2)
  ;
.END
.PROGRAM tst.cnc.shaft ()
  ;
  CALL get.task.data
  ;
  CALL cnc.put.shaft
  CALL cnc.pick.shaft
  ;
.END
.PROGRAM tst.dbl.plate ()
  ;
  IF SIG (s.hmi.tool[1]) THEN
    .tool.no = 1
  ELSE
    .tool.no = 2
  END
  ;
  .z.cor = hmi.dbl.ch.work[.tool.no] + hmi.bush.length
  TOOL t.gripper[.tool.no] + TRANS (0, 0, .z.cor)
  ;
  POINT .p0 = origin.bush[hmi.shelf.no, hmi.task.no, .tool.no]
  POINT .x.norm = x.norm.bush[hmi.shelf.no, hmi.task.no, .tool.no]
  POINT .y.norm = y.norm.bush[hmi.shelf.no, hmi.task.no, .tool.no]
  ;
  JMOVE #wp.bush.safe[.tool.no]
  ;
  ; Test points
  ; Origin
  ;
  .dx = 0
  .dy = 0
  ;
  POINT .x.vec = TRANS (DX (.x.norm) * .dx, DY (.x.norm) * .dx, DZ (.x.norm) * .dx)
  POINT .y.vec = TRANS (DX (.y.norm) * .dy, DY (.y.norm) * .dy, DZ (.y.norm) * .dy)
  POINT .origin = TRANS (DX (.p0), DY (.p0), DZ (.p0))
  POINT .dest = .origin + .x.vec + .y.vec
  POINT/OAT .dest = .p0
  ;
  LAPPRO .dest, 30
  LMOVE .dest
  LAPPRO .dest, 30
  ;
  ; X-Direction
  ;
  .dx = (hmi.plate.rows - 1) * hmi.plate.dx
  .dy = 0
  ;
  POINT .x.vec = TRANS (DX (.x.norm) * .dx, DY (.x.norm) * .dx, DZ (.x.norm) * .dx)
  POINT .y.vec = TRANS (DX (.y.norm) * .dy, DY (.y.norm) * .dy, DZ (.y.norm) * .dy)
  POINT .origin = TRANS (DX (.p0), DY (.p0), DZ (.p0))
  POINT .dest = .origin + .x.vec + .y.vec
  POINT/OAT .dest = .p0
  ;
  LAPPRO .dest, 30
  LMOVE .dest
  LAPPRO .dest, 30
  ;
  ; Y-Direction
  ;
  .dx = 0
  .dy = (hmi.plate.col.o - 1) * hmi.plate.dy
  ;
  POINT .x.vec = TRANS (DX (.x.norm) * .dx, DY (.x.norm) * .dx, DZ (.x.norm) * .dx)
  POINT .y.vec = TRANS (DX (.y.norm) * .dy, DY (.y.norm) * .dy, DZ (.y.norm) * .dy)
  POINT .origin = TRANS (DX (.p0), DY (.p0), DZ (.p0))
  POINT .dest = .origin + .x.vec + .y.vec
  POINT/OAT .dest = .p0
  ;
  LAPPRO .dest, 30
  LMOVE .dest
  LAPPRO .dest, 30
  ;
  JMOVE #wp.bush.safe[.tool.no]
  ;
.END
.PROGRAM tst.prl.plate ()
  ;
  TOOL t.calib[3]
  ;
  POINT .p0 = origin.shaft[hmi.shelf.no, hmi.task.no]
  POINT .x.norm = x.norm.shaft[hmi.shelf.no, hmi.task.no]
  POINT .y.norm = y.norm.shaft[hmi.shelf.no, hmi.task.no]
  ;
  JMOVE #wp.shaft.safe
  ;
  ; Test points
  ; Origin
  ;
  .dx = 0
  .dy = 0
  ;
  POINT .x.vec = TRANS (DX (.x.norm) * .dx, DY (.x.norm) * .dx, DZ (.x.norm) * .dx)
  POINT .y.vec = TRANS (DX (.y.norm) * .dy, DY (.y.norm) * .dy, DZ (.y.norm) * .dy)
  POINT .origin = TRANS (DX (.p0), DY (.p0), DZ (.p0))
  POINT .dest = .origin + .x.vec + .y.vec
  POINT/OAT .dest = .p0
  ;
  LAPPRO .dest, 30
  LMOVE .dest
  LAPPRO .dest, 30
  ;
  ; X-Direction
  ;
  .dx = (hmi.plate.rows - 1) * hmi.plate.dx
  .dy = 0
  ;
  POINT .x.vec = TRANS (DX (.x.norm) * .dx, DY (.x.norm) * .dx, DZ (.x.norm) * .dx)
  POINT .y.vec = TRANS (DX (.y.norm) * .dy, DY (.y.norm) * .dy, DZ (.y.norm) * .dy)
  POINT .origin = TRANS (DX (.p0), DY (.p0), DZ (.p0))
  POINT .dest = .origin + .x.vec + .y.vec
  POINT/OAT .dest = .p0
  ;
  LAPPRO .dest, 30
  LMOVE .dest
  LAPPRO .dest, 30
  ;
  ; Y-Direction
  ;
  .dx = 0
  .dy = (hmi.plate.col.o - 1) * hmi.plate.dy
  ;
  POINT .x.vec = TRANS (DX (.x.norm) * .dx, DY (.x.norm) * .dx, DZ (.x.norm) * .dx)
  POINT .y.vec = TRANS (DX (.y.norm) * .dy, DY (.y.norm) * .dy, DZ (.y.norm) * .dy)
  POINT .origin = TRANS (DX (.p0), DY (.p0), DZ (.p0))
  POINT .dest = .origin + .x.vec + .y.vec
  POINT/OAT .dest = .p0
  ;
  LAPPRO .dest, 30
  LMOVE .dest
  LAPPRO .dest, 30
  ;
  JMOVE #wp.shaft.safe
  ;
.END
.PROGRAM tst.wp.dbl.pick ()
  ;
  CALL get.task.data
  FOR .i = 1 TO 10
    CALL wp.dbl.pick (1, 1, .i)
    CALL wp.dbl.pick (2, 1, .i)
  END
  ;
.END
.PROGRAM tst.wp.prl.pick ()
  ;
  CALL get.task.data
  CALL wp.prl.pick(1, hmi.wp.id)
  ;
.END
.PROGRAM wp.dbl.pick (.grip.no,.shelf.no,.wp.id)
  ;
  .$temp = "Pick bushing workpiece with id:" + $ENCODE (.wp.id)
  CALL log (.$temp)
  ;
  SPEED 100 ALWAYS
  ACCURACY 10 ALWAYS
  ;
  CALL set.tool (grip.no.dbl[.grip.no])
  CALL gripper.open (grip.no.dbl[.grip.no], 0, gr.dbl.inv[.grip.no])
  CALL id.to.ij.bush (.wp.id, .i, .j)
  ;
  .dx = plt.dx * .i
  IF .i MOD 2 == 0
    .dy = plt.dy * (plt.cell.odd - 1 - .j)
  ELSE
    .dy = plt.dy * (plt.cell.even - 1 - .j) + plt.even.dy
  END
  .dz = bush.wp0.len + gr.dbl.work[.grip.no] - shelf.overshoot ;
  .z.appro = gr.dbl.full[.grip.no] - gr.dbl.work[.grip.no] + shelf.overshoot + 10
  ;
  POINT .p0 = origin.bush[.shelf.no, task.id, .grip.no]
  POINT .x.norm = x.norm.bush[.shelf.no, task.id, .grip.no]
  POINT .y.norm = y.norm.bush[.shelf.no, task.id, .grip.no]
  ;
  POINT .x.vec = TRANS (DX (.x.norm) * .dx, DY (.x.norm) * .dx, DZ (.x.norm) * .dx)
  POINT .y.vec = TRANS (DX (.y.norm) * .dy, DY (.y.norm) * .dy, DZ (.y.norm) * .dy)
  POINT .origin = TRANS (DX (.p0), DY (.p0), DZ (.p0))
  POINT .pick = .origin + .x.vec + .y.vec
  POINT/OAT .pick = .p0
  POINT .pick = .pick + TRANS (0, 0, -.dz)
  ;
  JMOVE #wp.bush.safe[.grip.no]
  ;
  ; Pick workpiece
  ACCURACY 0.1
  LAPPRO .pick, .z.appro
  SPEED 30 MM/S
  ACCURACY 0.1
  LMOVE .pick
  BREAK
  CALL gripper.close (grip.no.dbl[.grip.no], gp.dbl.cl.tmr[.grip.no], gr.dbl.inv[.grip.no])
  CALL log ("Bush picked")
  gripper.dbl.id[.grip.no] = .wp.id
  gripper.dbl.st[.grip.no] = 0
  ;
  SPEED 80 MM/S
  ACCURACY 0.1
  LAPPRO .pick, .z.appro
  JMOVE #wp.bush.safe[.grip.no]
  ;
.END
.PROGRAM wp.dbl.put (.grip.no,.shelf.no,.wp.id)
  ;
  .$temp = "Put bushing workpiece with id:" + $ENCODE (.wp.id)
  CALL log (.$temp)
  ;
  SPEED 100 ALWAYS
  ACCURACY 10 ALWAYS
  ;
  CALL set.tool (grip.no.dbl[.grip.no])
  CALL id.to.ij.bush (.wp.id, .i, .j)
  ;
  .dx = plt.dx * .i
  IF .i MOD 2 == 0
    .dy = plt.dy * (plt.cell.odd - 1 - .j)
  ELSE
    .dy = plt.dy * (plt.cell.even - 1 - .j) + plt.even.dy
  END
  .dz = bush.wp0.len + gr.dbl.work[.grip.no] - shelf.overshoot ;
  .z.appro = gr.dbl.full[.grip.no] - gr.dbl.work[.grip.no] + shelf.overshoot + 10
  ;
  POINT .p0 = origin.bush[.shelf.no, task.id, .grip.no]
  POINT .x.norm = x.norm.bush[.shelf.no, task.id, .grip.no]
  POINT .y.norm = y.norm.bush[.shelf.no, task.id, .grip.no]
  ;
  POINT .x.vec = TRANS (DX (.x.norm) * .dx, DY (.x.norm) * .dx, DZ (.x.norm) * .dx)
  POINT .y.vec = TRANS (DX (.y.norm) * .dy, DY (.y.norm) * .dy, DZ (.y.norm) * .dy)
  POINT .origin = TRANS (DX (.p0), DY (.p0), DZ (.p0))
  POINT .put = .origin + .x.vec + .y.vec
  POINT/OAT .put = .p0
  POINT .put = .put + TRANS (0, 0, -.dz)
  ;
  JMOVE #wp.bush.safe[.grip.no]
  ;
  ; Pick workpiece
  ACCURACY 0.1
  LAPPRO .put, .z.appro
  SPEED 30 MM/S
  ACCURACY 0.1
  LMOVE .put
  BREAK
  CALL gripper.open (grip.no.dbl[.grip.no], gp.dbl.op.tmr[.grip.no], gr.dbl.inv[.grip.no])
  CALL log ("Bush put")
  gripper.dbl.id[.grip.no] = 0
  gripper.dbl.st[.grip.no] = -1
  ;
  SPEED 80 MM/S
  ACCURACY 0.1
  LAPPRO .put, .z.appro
  JMOVE #wp.bush.safe[.grip.no]
  ;
.END
.PROGRAM wp.prl.pick (.shelf.no,.wp.id)
  ;
  .$temp = "Pick shaft workpiece with id:" + $ENCODE (.wp.id)
  CALL log (.$temp)
  ;
  SPEED 100 ALWAYS
  ACCURACY 10 ALWAYS
  ;
  CALL set.tool (grip.no.par[1])
  CALL gripper.open (grip.no.par[1], 0, FALSE)
  CALL id.to.ij.shaft (.wp.id, .i, .j)
  ;
  .dx = plt.dx * .i
  .dy = plt.dy * .j + shaft.wp0.l2 + shaft.wp0.l3 - cond.stp.oy
  .dz = shaft.wp0.h + gr.prl.full - gr.prl.work
  ;
  .z.appro = shaft.wp0.h + 20
  ;
  POINT .p0 = origin.shaft[.shelf.no, task.id]
  POINT .x.norm = x.norm.shaft[.shelf.no, task.id]
  POINT .y.norm = y.norm.shaft[.shelf.no, task.id]
  ;
  POINT .x.vec = TRANS (DX (.x.norm) * .dx, DY (.x.norm) * .dx, DZ (.x.norm) * .dx)
  POINT .y.vec = TRANS (DX (.y.norm) * .dy, DY (.y.norm) * .dy, DZ (.y.norm) * .dy)
  POINT .origin = TRANS (DX (.p0), DY (.p0), DZ (.p0))
  POINT .pick = .origin + .x.vec + .y.vec
  POINT/OAT .pick = .p0
  POINT .pick = .pick + TRANS (0, 0, -.dz)
  ;
  ;IF
  ;
  JMOVE #wp.shaft.safe
  ;
  ; Pick workpiece
  ACCURACY 0.1
  LAPPRO .pick, .z.appro
  SPEED 30 MM/S
  ACCURACY 0.1
  LMOVE .pick
  BREAK
  CALL gripper.close (grip.no.par[1], gp.par.cl.tmr, FALSE)
  CALL log ("Shaft picked")
  gripper.prl.id = .wp.id
  gripper.prl.st = 0
  ;
  SPEED 80 MM/S
  ACCURACY 0.1
  LAPPRO .pick, .z.appro
  JMOVE #wp.shaft.safe
  ;
.END
.PROGRAM wp.prl.put (.shelf.no,.wp.id)
  ;
  .$temp = "Put shaft workpiece with id:" + $ENCODE (.wp.id)
  CALL log (.$temp)
  ;
  SPEED 100 ALWAYS
  ACCURACY 10 ALWAYS
  ;
  CALL set.tool (grip.no.par[1])
  CALL id.to.ij.shaft (.wp.id, .i, .j)
  ;
  .dx = plt.dx * .i
  .dy = plt.dy * .j + shaft.wp0.l2 + shaft.wp0.l3 - cond.stp.oy
  .dz = shaft.wp0.h + gr.prl.full - gr.prl.work
  ;
  .z.appro = shaft.wp0.h + 20
  ;
  POINT .p0 = origin.shaft[.shelf.no, task.id]
  POINT .x.norm = x.norm.shaft[.shelf.no, task.id]
  POINT .y.norm = y.norm.shaft[.shelf.no, task.id]
  ;
  POINT .x.vec = TRANS (DX (.x.norm) * .dx, DY (.x.norm) * .dx, DZ (.x.norm) * .dx)
  POINT .y.vec = TRANS (DX (.y.norm) * .dy, DY (.y.norm) * .dy, DZ (.y.norm) * .dy)
  POINT .origin = TRANS (DX (.p0), DY (.p0), DZ (.p0))
  POINT .put = .origin + .x.vec + .y.vec
  POINT/OAT .put = .p0
  POINT .put = .put + TRANS (0, 0, -.dz)
  ;
  JMOVE #wp.shaft.safe
  ;
  ; Pick workpiece
  ACCURACY 0.1
  LAPPRO .put, .z.appro
  SPEED 30 MM/S
  ACCURACY 0.1
  LMOVE .put
  BREAK
  CALL gripper.open(grip.no.par[1], gp.par.op.tmr, FALSE)
  CALL log ("Shaft put")
  gripper.prl.id = 0
  gripper.prl.st = -1
  ;
  SPEED 80 MM/S
  ACCURACY 0.1
  LAPPRO .put, .z.appro
  JMOVE #wp.shaft.safe
  ;
.END
