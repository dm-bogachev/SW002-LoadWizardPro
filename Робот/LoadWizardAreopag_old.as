.END
.PROGRAM process.bushing(.s.no)@26/07/27 15:49 #146
  task.id = BITS(fi.st.task[.s.no,0],8)
;task.id = 1 ;Для Отладки
  CALL log("Working on stocker "+$ENCODE(.s.no)+" with task "+$ENCODE(task.id))
  CALL task.get.data(task.id)
;Переопределение переменных для поддержки старых функций
  task.op2.c.no = 1 ; потом приравнять в get task шпиндель у нас 1
  task.op3.c.no = 1 ; потом приравнять в get task шпиндель у нас 1
  task.op1.g.no = 1 ; Всегда  1 захватом берем с полки
  task.op3.g.no = 2 ; Всегда  2 захватом возвращаем
;Для тестирования задачи
;IF task.id==16 THEN
;  task.buffer = 1
;ELSE
;  task.buffer = 0
;END
  IF current.state==0 THEN
;S0. Init State
    IF SIG(fi.cnc.err) THEN
      CALL log("Failed to run program "+$ENCODE(task.op2.pg))
      .s.no = 100 ; Dirty hack!
      RETURN
    END
    HOME
;Dirty hack - запуск цикла очистки перед установкой первой детали полки
    CALL cnc.run.pg(1)
;Остановка интерпретатора
    TWAIT 0.1
    BREAK
    SWAIT fi.cnc.ready
;Остановка интерпретатора
    TWAIT 0.1
    BREAK
;
    current.state = 100
    current.part = 1
    grip2haspart = FALSE
    first.iteration = TRUE ;
    detail.count = BITS(fi.detail.cnt[.s.no],16);
;detail.count = 3 ;Для Отладки
    CALL log("[Part ?/?] current state "+$ENCODE(current.state)+": INIT task="+$ENCODE(task.id)+" total_details="+$ENCODE(detail.count))
  END
  IF current.state==100 THEN
    CALL log("[Part ?/?] current state "+$ENCODE(current.state)+": Gripper validation")
;Проверка типа захват;
    IF TRUE THEN
      current.state = 1
    ELSE ;Нет
      current.state = 16
      GOTO errorstate
    END
  END
  IF current.state==1 THEN
    CALL log("[Part ?/?] current state "+$ENCODE(current.state)+": OPEN stocker "+$ENCODE(.s.no))
    IF NOT SIG(fo.st.opened[.s.no]) THEN
      CALL log("Required to open stocker "+$ENCODE(.s.no))
      CALL stocker.open(.s.no)
      IF SIG(fi.unlock.fail) THEN
        .s.no = 100 ; Dirty hack!
        current.state = 16
        GOTO errorstate
      END
    END
    IF detail.count==0 THEN
      current.state = 14
    ELSE
      current.state = 2
    END
  END
  IF (current.state==14) OR (current.state==15) OR (current.state==16) THEN
    CALL log("current state"+$ENCODE(current.state)+" :Goto Cycle Finish")
    GOTO cyclefinish
;
  END
; +1 деталь для учета последний итерации
  WHILE current.part<detail.count+1 DO
    CALL log("Current state:"+$ENCODE(current.state)+"")
    CASE current.state OF
     VALUE 2:
;S2.Взять деталь
      .pick.grip.id = 1
      CALL log("[Part "+$ENCODE(current.part)+"/"+$ENCODE(detail.count)+"] current state "+$ENCODE(current.state)+": PICK from stocker")
      CALL log(" Install grip no 1. Grip ID: "+$ENCODE(op.g.id[1]))
;При заборе всегда 1 номер кулачков
      chuck.g.full[1] = chuck.data[op.g.id[1],1]/10
      chuck.g.work[1] = chuck.data[op.g.id[1],2]/10
      CALL stock.pick.new(.s.no,.pick.grip.id,detail.l1);
;Переходы нужно ли кантовать?
;task.buffer = task.data[.t.id,10]
;Остановка интерпретатора
      TWAIT 0.1
      BREAK
;Переходы
      IF (task.buffer<>0) AND (bushing.reclamp) THEN
;Перекантовать деталь
        current.state = 3;
        .$if_msg = "Yes"
      ELSE
        current.state = 4;
        .$if_msg = "No"
      END
      CALL log("[Part "+$ENCODE(current.part)+"/"+$ENCODE(detail.count)+"] current state 101 next "+$ENCODE(current.state)+": BUFFER check enabled="+.$if_msg)
     VALUE 3:
;Разворот детали
      .b.in.claw = op.g.id[1]; Пока ставим задачу с 1 захватом и им вращаем
      .b.out.claw = op.g.id[3]
      .instgripid = 1;
      CALL log("[Part "+$ENCODE(current.part)+"/"+$ENCODE(detail.count)+"] current state "+$ENCODE(current.state)+": FLIP detail Claw_in="+$ENCODE(.b.in.claw)+"->Claw_out="+$ENCODE(.b.out.claw))
      CALL buffer.flip(task.buffer,.instgripid,detail.id)
;Остановка интерпретатора
      TWAIT 0.1
      BREAK
;Проверить на операции смены
; Dirty hack??
      IF (task.buffer<>0) AND (bushing.reclamp) THEN
;ДА ;Говорим системе что нужно использовать набор после буфера
        CALL log("Change of grip!!. Grip ID: "+$ENCODE(op.g.id[3]))
        chuck.g.full[1] = chuck.data[op.g.id[3],1]/10
        chuck.g.work[1] = chuck.data[op.g.id[3],2]/10
      ELSE
        CALL log("Grip has not changed. Grip ID: "+$ENCODE(op.g.id[1]))
; Нет ==0 ;Говорим системе что нужно использовать первый набор
        chuck.g.full[1] = chuck.data[op.g.id[1],1]/10
        chuck.g.work[1] = chuck.data[op.g.id[1],2]/10
      END
;Переходы
      current.state = 4;
     VALUE 4:
;Ожидание сигнала готовности от станка
      HOME
      CALL log("[Part "+$ENCODE(current.part)+"/"+$ENCODE(detail.count)+"] current state "+$ENCODE(current.state)+": WAIT CNC ready")
      SWAIT fi.cnc.ready
;так то он есть, но для ясности переходов
;Остановка интерпретатора
      TWAIT 0.1
      BREAK
;Переходы
      current.state = 5;
     VALUE 5:
; Подъезд к станку;
      IF first.iteration THEN
        .instgripid = 1;
      ELSE
        .instgripid = 2 ;
      END
      .cncslotinst = 1 ;
      CALL log("[Part "+$ENCODE(current.part)+"/"+$ENCODE(detail.count)+"] current state "+$ENCODE(current.state)+": MOVE to CNC slot="+$ENCODE(.cncslotinst)+" grip="+$ENCODE(.instgripid))
      CALL cnc.move.in(.instgripid,.cncslotinst);
;   .instGripId = 1  // номер захвата  1 итерации надо 1 захватом для последующих 2
;   .CncSlotInst = 1 // Номер патрона task.op2.c.no =1 константы в get.task для наглядности вынес судя
;Остановка интерпретатора
      TWAIT 0.1
      BREAK
;Переходы
      IF first.iteration THEN
        first.iteration = FALSE ;
        current.state = 11;
      ELSE
        current.state = 6;
      END
      CALL log("[Part "+$ENCODE(current.part)+"/"+$ENCODE(detail.count)+"] current 5  Next"+$ENCODE(current.state)+":  grip2HasPart="+$ENCODE(grip2haspart)+" first.iteration="+$ENCODE(first.iteration))
     VALUE 6:
; Забрать из станка деталь типа втулка;
      .cncslotinst = 1
      .pickgripid = 2
      CALL log("[Part "+$ENCODE(current.part)+"/"+$ENCODE(detail.count)+"] current state "+$ENCODE(current.state)+": PICK from CNC slot="+$ENCODE(.cncslotinst)+" pickGripId="+$ENCODE(.pickgripid))
      CALL cnc.pick(.cncslotinst,.pickgripid,.cncslotinst,detail.l2);
; cnc.pick(.c.no,.g.no,.cnc.g.no,.h) ждет
; .c.no == номер патрона .CncSlotInst = 1 (task.op3.c.no)
; .g.no == Номер захвата 1-2 у нас
; .cnc.g.no == номер кулачков в захвате он связан с патроном по этому он всегда равен 1 у нас (task.op3.c.no)
; .h высота детали берем из Высота готовой детали
;Запоминаем что в захвате 2 есть деталь
      grip2haspart = TRUE;
;Остановка интерпретатора
      TWAIT 0.1
      BREAK
; 104 не выйдет так ограничение на условия в цикле переход сразу
; Проверка то что это последняя деталь;
; ***
;IF (current.part == detail.count) THEN
;  ;Выезжаем для из станка
;  current.state = 10;
;  .$if_msg = "Yes"
;ELSE
;  ;Разворачиваемся и устанавливаем деталь
;  current.state = 7;
;  .$if_msg = "No"
;END
;***
      current.state = 10;
      CALL log("[Part "+$ENCODE(current.part)+"/"+$ENCODE(detail.count)+"] current state 6 Next"+$ENCODE(current.state)+": FINAL CHECK isLast="+.$if_msg)
;
     VALUE 7:
;Разворот в станке
      .cncslotinst = 1
      .pickgripid = 1 ; там сейчас деталь
      CALL log("[Part "+$ENCODE(current.part)+"/"+$ENCODE(detail.count)+"] current state "+$ENCODE(current.state)+": ROTATE MANEUVER grip="+$ENCODE(.pickgripid))
      CALL cnc.change.tool(.cncslotinst,.pickgripid)
;Остановка интерпретатора
      TWAIT 0.1
      BREAK
      current.state = 11;
     VALUE 10:
;Выехать из станка (Для без запуска цикла для последний детали );
      .pickgripid = 2
      .cncslotinst = 1
      CALL log("[Part "+$ENCODE(current.part)+"/"+$ENCODE(detail.count)+"] current state "+$ENCODE(current.state)+": EXIT CNC (LAST PART)")
      CALL cnc.move.out(.pickgripid,.cncslotinst);
;*** Запуск алгоритма очистки кулачков патрона в станке
;Остановка интерпретатора
      TWAIT 0.1
      BREAK
;
      IF current.part<detail.count THEN
        CALL cnc.run.pg(1)
;Остановка интерпретатора
        TWAIT 0.1
        BREAK
;
        SWAIT fi.cnc.ready
;так то он есть, но для ясности переходов
;Остановка интерпретатора
        TWAIT 0.1
        BREAK
      END
;Переходы
      IF (current.part<>detail.count) THEN
;Разворачиваемся и устанавливаем деталь
        current.state = 7;
        .$if_msg = "No"
      ELSE
        HOME
;Остановка интерпретатора
        TWAIT 0.1
        BREAK
        current.state = 8
      END
;***
     VALUE 11:
; Установить деталь типа втулка в станок
      .cncslotinst = 1;
      .instgripid = 1 ;
;Проверка была перестановка детали
;;Грязный хак подмена данных ??
      IF (task.buffer<>0) AND (bushing.reclamp) THEN
;ДА ;Говорим системе что нужно использовать набор после буфера
        CALL log("Change of grip. Grip ID: "+$ENCODE(op.g.id[3]))
        chuck.g.full[1] = chuck.data[op.g.id[3],1]/10
        chuck.g.work[1] = chuck.data[op.g.id[3],2]/10
      ELSE
        CALL log("Grip has not changed. Grip ID: "+$ENCODE(op.g.id[1]))
; Нет ==0 ;Говорим системе что нужно использовать первый набор
        chuck.g.full[1] = chuck.data[op.g.id[1],1]/10
        chuck.g.work[1] = chuck.data[op.g.id[1],2]/10
      END
      CALL log("[Part "+$ENCODE(current.part)+"/"+$ENCODE(detail.count)+"] current state "+$ENCODE(current.state)+": PUT to CNC slot="+$ENCODE(.cncslotinst)+" Grip="+$ENCODE(.instgripid)+"FLIP "+.$if_msg)
      CALL cnc.put(.cncslotinst,.instgripid,.cncslotinst,detail.l1);
; note right
;   cnc.put(.c.no,.g.no,.cnc.g.no,.h)       Ждет
;   .c.no = номер патрона в станке у нас 1 .CncSlotInst
;   .g.no = номер кулачков в захвате зависит от того был ли перехват
;   .cnc.g.no кулачки в станке ( у нас 1 так как get task заполняется массив chuck.cnc.full CncGripInst от номера кулачка CncGripInst=1 )
;   .h высота детали до обработки
; end note
;Остановка интерпретатора
      TWAIT 0.1
      BREAK
      current.state = 13;
     VALUE 13:
;Выехать из станка (Для запуска цикла);
      .pickgripid = 1
      .cncslotinst = 1
      CALL log("[Part "+$ENCODE(current.part)+"/"+$ENCODE(detail.count)+"] current state "+$ENCODE(current.state)+": EXIT CNC (For RUN CNC PG)")
      CALL cnc.move.out(.pickgripid,.cncslotinst);
;
;*** Запуск алгоритма очистки кулачков патрона в станке
;Остановка интерпретатора
;TWAIT 0.1
;BREAK
;
;IF current.part == 1 THEN
;  CALL cnc.run.pg (1)
;Остановка интерпретатора
;  TWAIT 0.1
;  BREAK
;
;  SWAIT fi.cnc.ready
;  так то он есть, но для ясности переходов
;  Остановка интерпретатора
;  TWAIT 0.1
;  BREAK
;END
;***
; note right
;   cnc.move.out(.g.no,.c.no) ждет
;   .g.no == номер захвата.Захват у нас 1 так мы устанавливали деталь 1 захватом
;   .c.no == Номер патрона в станке task.op2.c.no.  Патрон у нас 1 другого нет
; end note
;Остановка интерпретатора
      TWAIT 0.1
      BREAK
      current.state = 9;
     VALUE 9:
; Запуск станка М команды
      CALL log("[Part "+$ENCODE(current.part)+"/"+$ENCODE(detail.count)+"] current state "+$ENCODE(current.state)+": START CNC cycle | grip2HasPart="+$ENCODE(grip2haspart))
      HOME;
      CALL cnc.run.pg(1)
;CALL cnc.mfinish
;Остановка интерпретатора
      TWAIT 0.1
      BREAK
      IF (grip2haspart==TRUE) THEN
; (Да, есть деталь возвращаем)
        current.state = 8;
      ELSE
;*** Если на полке в задании была всего 1 деталь, то ждем готовности обработки и возвращаем на полку.
        IF detail.count<>1 THEN
; (Нет, детали берем следующею)
          current.state = 2;
        ELSE
          current.state = 4;
        END
;***
      END
     VALUE 8:
; Возврат в детали типа втулка в стокер;
      .putgripid = 2
      CALL log("[Part "+$ENCODE(current.part)+"/"+$ENCODE(detail.count)+"] current state "+$ENCODE(current.state)+": PUT to stocker St="+$ENCODE(.s.no)+" putGripId="+$ENCODE(.putgripid))
      CALL stock.put.new(.s.no,.putgripid,detail.l2)
      grip2haspart = FALSE
; note right
;   stocker.put(.s.no,.g.no,.h) ждет
;   .s.no = номер полки
;   .g.no == номер захвата.Захват у нас 2 так им возвращаем деталь
;   .h = высота детали после обработки
; end note
      current.part = current.part+1; Увеличиваем индекс детали
;Остановка интерпретатора
      TWAIT 0.1
      BREAK
;Переходы
      IF (current.part<detail.count) THEN
; Еще есть детали;
        current.state = 2;
        .$if_msg = "CONTINUE"
      ELSE ;(Нет)
        IF (current.part==detail.count) THEN
; Осталось 1 деталь;
          current.state = 4;
          .$if_msg = "LAST PART"
        ELSE ;(нет)
; current.part > detail.count
; Все детали закончились;
          current.state = 14;
          .$if_msg = "FINISH"
        END
      END
      CALL log("[Part "+$ENCODE(current.part)+"/"+$ENCODE(detail.count)+"] current state "+$ENCODE(current.state)+": CYCLE CHECK remaining="+$ENCODE(detail.count-current.part)+" next="+.$if_msg)
any:
;Your code
      CALL log("NEXT STATE: "+$ENCODE(current.state))
    END
  END
;
cyclefinish:
  IF current.state==14 THEN
    CALL log("[Part "+$ENCODE(current.part)+"/"+$ENCODE(detail.count)+"] current state "+$ENCODE(current.state)+": CLOSE stocker "+$ENCODE(.s.no))
    JMOVE #stocker.safe
    HOME
    CALL stocker.close(.s.no)
    IF SIG(fi.unlock.fail) THEN
      RETURN
    END
    current.state = 15
  END
;
  IF current.state==15 THEN
    CALL log("[Part "+$ENCODE(detail.count)+"/"+$ENCODE(detail.count)+"] current state "+$ENCODE(current.state)+": PROCESS COMPLETE ")
    CALL process.reset
    HOME
    PULSE fo.st.complete[.s.no]
    SIGNAL -fo.stocker.work[.s.no]
  END
errorstate:
  IF current.state==16 THEN
;Ошибка в при открытие или не тот захват;
;Пока просто выход
    CALL log("[Part "+$ENCODE(current.part)+"/"+$ENCODE(detail.count)+"] current state "+$ENCODE(current.state)+":  ERROR step="+$ENCODE(current.state)+" SIG_UNLOCK_FAIL="+$ENCODE(SIG(fi.unlock.fail)))
    RETURN
  END
  CALL log("END FILE PROCESS "+$ENCODE(.s.no)+" LAST STATE"+$ENCODE(current.state))
.END
.PROGRAM process.reset()@26/07/27 15:49 #1243;
