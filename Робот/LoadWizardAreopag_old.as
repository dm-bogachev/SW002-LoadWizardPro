.PROGRAM add.current()@26/07/27 15:48 #2534;
; Update values
  current.col = current.col+1
  PULSE fo.col.add
  IF current.row MOD 2==1 THEN
    IF current.col>stocker.n.odd THEN
      current.row = current.row+1
      PULSE fo.row.add
      current.col = 1
    END
  ELSE
    IF current.col>stocker.n.even THEN
      current.row = current.row+1
      PULSE fo.row.add
      current.col = 1
    END
  END
  detail.done = detail.done+1
.END
.PROGRAM add.last()@26/07/27 15:48 #2192;
; Update values
  last.col = last.col+1
  IF last.row MOD 2==1 THEN
    IF last.col>stocker.n.odd THEN
      last.row = last.row+1
      last.col = 1
    END
  ELSE
    IF last.col>stocker.n.even THEN
      last.row = last.row+1
      last.col = 1
    END
  END
.END
