  IFPWPRINT 1,1,1,9,10=$log.entry[112],$log.entry[113],$log.entry[114],$log.entry[115]
  IFPWPRINT 2,1,1,9,10=$log.entry[116],$log.entry[117],$log.entry[118],$log.entry[119]
