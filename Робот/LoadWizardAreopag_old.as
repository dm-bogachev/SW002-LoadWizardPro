.PROGRAM set.tool(.tool.no)@26/07/27 15:49 #19719
  CASE .tool.no OF
   VALUE 1:
    TOOL tool.gripper[1]
    POINT current.tool = tool.gripper[1]
   VALUE 2:
    TOOL tool.gripper[2]
    POINT current.tool = tool.gripper[2]
   VALUE 3:
    TOOL tool.pin
    POINT current.tool = tool.pin
   VALUE 4:
    TOOL tool.sensor
    POINT current.tool = tool.sensor
   VALUE 5:
    TOOL tool.gripper[3]
    POINT current.tool = tool.gripper[3]
   VALUE 6:
    TOOL tool.pin2
    POINT current.tool = tool.pin2
  END
  CALL log("Set tool #"+$ENCODE(.tool.no))
.END
.PROGRAM st.shaft.pick(.s.no,.g.no,.t.no)@26/07/27 15:49 #534
; .s.no - Stocker № (1-4)
; .g.no - Gripper № (1-2)
; .t.no - Tool Number
;
  .$str = "Stocker pick St = "+$ENCODE(.s.no)
  .$str = .$str+" Row = "+$ENCODE(current.row)
  .$str = .$str+" Col = "+$ENCODE(current.col)
  CALL log(.$str)
; add get_task
; Get data
  lx = stocker.ly
  ly = stocker.lx
  l.even = stocker.l.even
  g.cf = chuck.g.full[.g.no]
  g.cw = chuck.g.work[.g.no]
  step.x = stocker.clip.x
  step.y = stocker.clip.y
  clip.dx = stocker.clip.dy
  clip.dy = stocker.clip.dx
; Расчет смещения (Номер ячейки деталью)
; Calculation
  IF current.col%2<>0 THEN
    pick.shift.x = (current.col-1)*lx
    pick.shift.y = (current.row-1)*ly
  ELSE
    pick.shift.x = (current.col-1)*lx+l.even
    pick.shift.y = (current.row-1)*ly
  END
;base St. x ->base St.parl x
;base St. y ->base St.parl -z
;base St. z ->base St.parl -y
  pick.shift.x = pick.shift.x-clip.dx+shaft.orig.l1+shaft.orig.l2
  pick.shift.y = pick.shift.y+clip.dy
  pick.shift.z = shaft.orig.h+(g.cf-g.cw)
;
  POINT .dx.vec.temp = TRANS(DX(dx.vec.normal[.s.no,stocker.id,1])*pick.shift.x,DY(dx.vec.normal[.s.no,stocker.id,1])*pick.shift.x,DZ(dx.vec.normal[.s.no,stocker.id,1])*pick.shift.x,0,0,0)
  POINT .dy.vec.temp = TRANS(DX(dy.vec.normal[.s.no,stocker.id,1])*pick.shift.y,DY(dy.vec.normal[.s.no,stocker.id,1])*pick.shift.y,DZ(dy.vec.normal[.s.no,stocker.id,1])*pick.shift.y,0,0,0)
  POINT grip.point = TRANS(DX(stp.1[.s.no,stocker.id,1]),DY(stp.1[.s.no,stocker.id,1]),DZ(stp.1[.s.no,stocker.id,1]))          ;stocker.frame[.s.no, stocker.id] + .offset_vec
  POINT grip.point = grip.point+.dx.vec.temp+.dy.vec.temp+TRANS(0,0,pick.shift.z)
  IF shaft.reclamp==0 THEN
    CALL log("NOT ROT TOOL")
;Разворот инструмента не нужен
    POINT/OAT grip.point = TRANS(0,0,0,0,90,-90) ;Требуемая ориентация пар. захвата без разворота
  ELSE
;Разворот инструмента нужен
    CALL log("YES ROT TOOL")
    POINT/OAT grip.point = TRANS(0,0,0,180,90,-90) ;Требуемая ориентация пар. захвата с разворотом  
  END
;temp_point
;POINT tmp.pnt = target.st.frame + pick.offset
;Открытие захвата, Зато красиво
  CALL gripper.open(1,FALSE)
  CALL gripper.open(2,FALSE)
  BREAK
; Set motion aux defaults
  SPEED spd.max ALWAYS
  ACCURACY accu.free ALWAYS
  CALL set.tool(.t.no)
; Motion
  SPEED spd.max ALWAYS
  ACCURACY accu.big ALWAYS
  JMOVE #st.prl.safe
  BREAK
  JMOVE SHIFT(grip.point BY 0,0,100)
  $safe.flag = "stocker.any"
;
  SPEED spd.small
  ACCURACY accu.fine
;
  LMOVE grip.point
  TWAIT 0.1
  BREAK
;Закрытие захвата, Зато красиво
  CALL gripper.close(2,FALSE)
  CALL gripper.close(1,FALSE)
;Чтобы не менять логику работы с вспомогательных функции
; Update values
  current.col = current.col+step.x
  PULSE fo.col.add
  IF current.row MOD 2==1 THEN
    IF current.col>stocker.n.odd THEN
      current.row = current.row+step.y
      PULSE fo.row.add
      current.col = 1
    END
  ELSE
    IF current.col>stocker.n.even THEN
      current.row = current.row+step.y
      PULSE fo.row.add
      current.col = 1
    END
  END
  detail.done = detail.done+1
  BREAK
  TWAIT 0.1
;
  LMOVE SHIFT(grip.point BY 0,0,30)
;
  SPEED spd.medium ALWAYS
  ACCURACY accu.medium ALWAYS
  JMOVE SHIFT(grip.point BY 0,0,100)
;
  JMOVE #st.prl.safe
;
.END
.PROGRAM st.shaft.put(.s.no,.g.no,.t.no)@26/07/27 15:49 #181;
; .s.no - Stocker № (1-4)
; .t.no - Tool Number
;
  .$str = "Stocker put St = "+$ENCODE(.s.no)
  .$str = .$str+" G = "+$ENCODE(.g.no)
  .$str = .$str+" Row = "+$ENCODE(last.row)
  .$str = .$str+" Col = "+$ENCODE(last.col)
  CALL log(.$str)
;
; Get data
  lx = stocker.ly
  ly = stocker.lx
  l.even = stocker.l.even
  g.cf = chuck.g.full[.g.no]
  g.cw = chuck.g.work[.g.no]
  step.x = stocker.clip.x
  step.y = stocker.clip.y
  clip.dx = stocker.clip.dy
  clip.dy = stocker.clip.dx
; Расчет смещения (Номер ячейки деталью)
; Calculation
  IF last.col%2<>0 THEN
    pick.shift.x = (last.col-1)*lx
    pick.shift.y = (last.row-1)*ly
  ELSE
    pick.shift.x = (last.col-1)*lx+l.even
    pick.shift.y = (last.row-1)*ly
  END
;base St. x ->base St.parl x
;base St. y ->base St.parl -z
;base St. z ->base St.parl -y
  pick.shift.x = pick.shift.x-clip.dx+shaft.final.l1+shaft.final.l2
  pick.shift.y = pick.shift.y+clip.dy
  pick.shift.z = shaft.final.h+(g.cf-g.cw)
;
  POINT .dx.vec.temp = TRANS(DX(dx.vec.normal[.s.no,stocker.id,1])*pick.shift.x,DY(dx.vec.normal[.s.no,stocker.id,1])*pick.shift.x,DZ(dx.vec.normal[.s.no,stocker.id,1])*pick.shift.x,0,0,0)
  POINT .dy.vec.temp = TRANS(DX(dy.vec.normal[.s.no,stocker.id,1])*pick.shift.y,DY(dy.vec.normal[.s.no,stocker.id,1])*pick.shift.y,DZ(dy.vec.normal[.s.no,stocker.id,1])*pick.shift.y,0,0,0)
  POINT grip.point = TRANS(DX(stp.1[.s.no,stocker.id,1]),DY(stp.1[.s.no,stocker.id,1]),DZ(stp.1[.s.no,stocker.id,1]))          ;stocker.frame[.s.no, stocker.id] + .offset_vec
  POINT grip.point = grip.point+.dx.vec.temp+.dy.vec.temp+TRANS(0,0,pick.shift.z)
  IF shaft.rot==0 THEN
    CALL log("NOT ROT TOOL")
;Разворот инструмента не нужен
    POINT/OAT grip.point = TRANS(0,0,0,0,90,-90) ;Требуемая ориентация пар. захвата без разворота
  ELSE
;Разворот инструмента нужен
    CALL log("YES ROT TOOL")
    POINT/OAT grip.point = TRANS(0,0,0,180,90,-90) ;Требуемая ориентация пар. захвата с разворотом
  END
;
  SPEED spd.max ALWAYS
  ACCURACY accu.free ALWAYS
  CALL set.tool(.t.no)
; Motion
  JMOVE #st.prl.safe
  $safe.flag = "stocker.any"
  SPEED spd.max ALWAYS
  ACCURACY accu.big ALWAYS
  JMOVE SHIFT(grip.point BY 0,0,100)
;
  SPEED spd.small MM/S
  ACCURACY accu.fine
  LMOVE SHIFT(grip.point BY 0,0,1.5)
;
  BREAK
;Закрытие захвата, Зато красиво
  CALL gripper.open(1,FALSE)
  CALL gripper.open(2,FALSE)
  BREAK
  TWAIT 0.1
;CALL add.last
; Update values
  last.col = last.col+step.x
  IF last.row MOD 2==1 THEN
    IF last.col>stocker.n.odd THEN
      last.row = last.row+step.y
      last.col = 1
    END
  ELSE
    IF last.col>stocker.n.even THEN
      last.row = last.row+step.y
      last.col = 1
    END
  END
;
  LMOVE SHIFT(grip.point BY 0,0,30)
  SPEED spd.medium ALWAYS
  ACCURACY accu.medium ALWAYS
  JMOVE SHIFT(grip.point BY 0,0,100)
;
  JMOVE #st.prl.safe
;
.END
