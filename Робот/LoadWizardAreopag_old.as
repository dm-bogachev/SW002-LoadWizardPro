.PROGRAM buffer.flip(.b.id,.g.no,.det.id)@26/07/27 15:48 #243
; .b.id - Buffer id
;.g.no - gripper ID
  save.buffer.id = .b.id
  save.detail.id = .det.id
  $safe.flag = "buffer"
  CALL log("Expand the part in the buffer")
  IF .b.id==1 AND FALSE THEN
;Инициализация  для тестового показа
    POINT #buff.safe[.b.id,.det.id] = #PPOINT(112.64,-26.464,58.886,147.78,-101.25,129.59)
    POINT #buff.rot.pos[.b.id,.det.id] = #PPOINT(118.06,-19.453,66.924,155.14,-87.854,-45.873)
; bufferDropPos / bufferPickPos — (drop = положить, pick = взять).
    POINT buff.pick.pos[.b.id,.det.id] = TRANS(717.12,-208.34,478.8,0.36397,122.62,-36.213)
    POINT buff.drop.pos[.b.id,.det.id] = TRANS(820.88,-209.29,412.45,-179.03,57.01,35.886)
;Точки 1 и 2 для плавной установки
;    POINT buffer.flip[.b.id,1] = TRANS(834.99,-208.92,436.22,-179.04,57.009,35.887)
;    POINT buffer.flip[.b.id,2] = TRANS(820.1,-209.53,416.4,-179.04,57.008,35.887)
    CALL log("buffer.flip: point initialize")
  END
;
;
  .save.dist1 = 75;
  .save.dist2 = 5
;calculation
  .p1.x = .save.dist1*SIN(28);37.5 ;75 * SIN(30)
  .p1.z = .save.dist1*COS(30);64.95 ;75 * COS(30)
  .p2.x = .save.dist2*SIN(28) ;5 * SIN(30)
  .p2.z = .save.dist2*COS(30) ;5 * COS(30)
  DECOMPOSE .p[0] = buff.drop.pos[.b.id,.det.id]
;*** Выбор траектории движения на станции перехвата в зависимости от того,
; с какой стороны кладем/забираем деталь
  DECOMPOSE .buff.drop.pos[0] = buff.drop.pos[.b.id,.det.id]
  DECOMPOSE .buff.pick.pos[0] = buff.pick.pos[.b.id,.det.id]
  IF .buff.drop.pos[0]>.buff.pick.pos[0] THEN
    POINT .buffer.drop.off[1] = TRANS(.p[0]+.p1.x,.p[1],.p[2]+.p1.z,.p[3],.p[4],.p[5])
    POINT .buffer.drop.off[2] = TRANS(.p[0]+.p2.x,.p[1],.p[2]+.p2.z,.p[3],.p[4],.p[5])
  ELSE
    POINT .buffer.drop.off[1] = TRANS(.p[0]-.p1.x,.p[1],.p[2]+.p1.z,.p[3],.p[4],.p[5])
    POINT .buffer.drop.off[2] = TRANS(.p[0]-.p2.x,.p[1],.p[2]+.p2.z,.p[3],.p[4],.p[5])
  END
;***
  SPEED spd.high
  ACCURACY accu.big
  CALL set.tool(.g.no)
;
  JMOVE #stocker.safe
  $safe.flag = "stocker.safe"
  JMOVE #buff.safe[.b.id,.det.id]
  $safe.flag = "buffer.safe"
  SPEED spd.prec MM/S
  ACCURACY accu.small
  LMOVE .buffer.drop.off[1]
  $safe.flag = "buffer.p1"
  SPEED spd.prec MM/S
  LMOVE .buffer.drop.off[2]
  $safe.flag = "buffer.p2"
  SPEED spd.prec MM/S
  ACCURACY accu.fine
  LMOVE buff.drop.pos[.b.id,.det.id]
  $safe.flag = "buffer.drop.pos"
  TWAIT 0.1
  BREAK
  CALL gripper.open(.g.no,FALSE)
  TWAIT 0.1
  BREAK
  SPEED spd.small
  ACCURACY accu.small
  LDEPART 40
  $safe.flag = "buffer.drop.before"
;***
  IF .buff.drop.pos[0]>.buff.pick.pos[0] THEN
    DRAW 120,0,250,0,-35,0
  ELSE
    DRAW -120,0,250,35
  END
;***
  SPEED spd.high
  ACCURACY accu.big
  JMOVE #buff.rot.pos[.b.id,.det.id]
  $safe.flag = "buffer.rot.pos"
  SPEED spd.small
  ACCURACY accu.small
  LAPPRO buff.pick.pos[.b.id,.det.id],150
  $safe.flag = "buffer.pick.in"
  SPEED spd.prec MM/S
  ACCURACY accu.fine
  LMOVE buff.pick.pos[.b.id,.det.id]
  $safe.flag = "buffer.pick"
  TWAIT 0.1
  BREAK
  CALL gripper.close(.g.no,FALSE)
  TWAIT 0.1
  BREAK
  SPEED spd.small
  ACCURACY accu.small
  DRAW 0,0,100
  $safe.flag = "buffer.drop.before"
  SPEED spd.high
  ACCURACY accu.big
  JMOVE #buff.rot.pos[.b.id,.det.id]
  $safe.flag = "buffer.rot.pos"
  HOME
.END
.PROGRAM cnc.change.tool(.c.no,.g.no)@26/07/27 15:48 #2147
;WAIT FALSE
  IF (task.op2.c.no==task.op3.c.no) AND NOT first.iteration AND (task.op1.g.no<>task.op3.g.no) THEN
    IF .g.no==1 THEN
      TOOL NULL
      SPEED 30
      ACCEL 50
      LMOVE #kostil5
      $safe.flag = "cnc.change.tool1"
    END
    IF .g.no==2 THEN
      TOOL NULL
      SPEED 30
      ACCEL 50
      LMOVE #kostil7
      $safe.flag = "cnc.change.tool2"
    END
    CALL set.tool(.g.no)
    SPEED 30
    ACCEL 50
    $safe.flag = "cnc.put"
    JAPPRO cnc.c[.c.no,.g.no]+TRANS(put.shift.x,put.shift.y,-put.shift.z,0,0,0),80
  END
  IF MSPEED>50 THEN
    SPEED 20
    ACCEL 20
  END
  IF MSPEED>90 THEN
    MON_SPEED 90
  END
  BREAK
  safe.c = .c.no
  safe.g = .g.no
.END
