.PROGRAM a.main()@26/07/27 15:48 #0;
  SPEED 100 ALWAYS
  ACCURACY 100 ALWAYS
; Acceleration
  ACCEL 10 ALWAYS
  DECEL 10 ALWAYS
;
;CALL initialize
  CALL safe.home
;
  WHILE TRUE DO
; Reset process!
    IF SIG(fo.process.res) THEN
      CALL log("Process parameters was initialized")
      CALL process.reset
    END
;
; Move robot to HOME
;IF SIG(fi.robot.home) THEN
;  CALL log("Robot starts motion to home position")
;  CALL safe.home
;END
;
; Start process
    IF SIG(fi.proc.start) THEN
      CALL log("Process started")
      SIGNAL fo.proc.on
; IF par.type==1 THEN
; CALL cnc.run.pg(1)
; END;if
      DO
        FOR .stocker = 4 TO 1 STEP -1
;CALL process.reset
          CALL log("stocker "+$ENCODE(.stocker))
          IF SIG(fi.st.ready[.stocker]) THEN
            SIGNAL fo.stocker.work[.stocker]
            CALL log("Start working with stocker "+$ENCODE(.stocker))
            task.id = BITS(fi.st.task[.stocker,0],8)
            CALL log("Load task id ="+$ENCODE(task.id)+" data .. ")
            CALL task.get.data(task.id)
            IF par.type==1 THEN
              CALL process.shaft(.stocker)
            ELSE
              CALL process.bushing(.stocker)
            END
          END
        END
      UNTIL BITS(fi.st.ready[1],4)==0
      BREAK
      SIGNAL -fo.proc.on
      HOME
;
    END
  END
.END
