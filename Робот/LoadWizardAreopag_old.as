.PROGRAM a.teach.cnc()@26/09/03 14:26 #2
  robot.chuck = (hmi.chuck.full-hmi.chuck.work)
  cnc.chuck = (hmi.cnc.ch.full[1]-hmi.cnc.ch.work[1])
  cdz = hmi.cnc.h+robot.chuck+cnc.chuck
;
  HOME
  CALL set.tool(hmi.rob.gr)
  BREAK
;
  JMOVE #cnc.before[hmi.cnc.no,hmi.rob.gr];*** TEACH POINT ***
  LMOVE cnc.in[hmi.cnc.no,hmi.rob.gr];*** TEACH POINT ***
;
  JAPPRO #cnc.c[hmi.cnc.no,hmi.rob.gr],100
  LMOVE #cnc.c[hmi.cnc.no,hmi.rob.gr];*** TEACH POINT ***
  LAPPRO #cnc.c[hmi.cnc.no,hmi.rob.gr],100
;
;
  POINT cnc.c[hmi.cnc.no,hmi.rob.gr] = #cnc.c[hmi.cnc.no,hmi.rob.gr]
  POINT cnc.c[hmi.cnc.no,hmi.rob.gr] = cnc.c[hmi.cnc.no,hmi.rob.gr]+TRANS(0,0,cdz,0,0,0)
;
  LAPPRO cnc.c[hmi.cnc.no,hmi.rob.gr]+TRANS(0,0,-cdz,0,0,0),100
  LMOVE cnc.c[hmi.cnc.no,hmi.rob.gr]+TRANS(0,0,-cdz,0,0,0)
  LAPPRO cnc.c[hmi.cnc.no,hmi.rob.gr]+TRANS(0,0,-cdz,0,0,0),100
;
  LMOVE cnc.in[hmi.cnc.no,hmi.rob.gr]
  LMOVE #cnc.before[hmi.cnc.no,hmi.rob.gr]
  HOME
.END
.PROGRAM a.teach.cnc.prl()@26/09/11 11:12 #3
; Не универсальная программа для обучения параллельного захвата
  robot.chuck = (hmi.chuck.full-hmi.chuck.work)
  cnc.chuck = (hmi.cnc.ch.full[1]-hmi.cnc.ch.work[1])
;cdz = hmi.cnc.h + robot.chuck + cnc.chuck
;hmi.part.len = 24
;hmi.grip.width = 23.8
  .offset.z = cnc.chuck+hmi.part.len+0.5*hmi.grip.width
  .offset.y = robot.chuck
;
  TWAIT 10
  HOME
  CALL set.tool(5)
  BREAK
;
  JMOVE #cnc.before[hmi.cnc.no,hmi.rob.gr]
  LMOVE cnc.in[hmi.cnc.no,hmi.rob.gr]
  JMOVE #cnc.in[hmi.cnc.no,hmi.rob.gr]
;
  JAPPRO #cnc.c[hmi.cnc.no,hmi.rob.gr],-100
  LMOVE #cnc.c[hmi.cnc.no,hmi.rob.gr];*** TEACH POINT ***
  LAPPRO #cnc.c[hmi.cnc.no,hmi.rob.gr],-100
;
  POINT tmp.pnt = #cnc.c[hmi.cnc.no,hmi.rob.gr]
  POINT tmp.pnt = tmp.pnt+TRANS(0,.offset.y,-.offset.z,0,0,0)
;
  LAPPRO tmp.pnt+TRANS(0,-(.offset.y),.offset.z,0,0,0),-100
  LMOVE tmp.pnt+TRANS(0,-(.offset.y),.offset.z,0,0,0)
  LAPPRO tmp.pnt+TRANS(0,-(.offset.y),.offset.z,0,0,0),-100
  TWAIT 0.1
  POINT cnc.c[hmi.cnc.no,hmi.rob.gr] = tmp.pnt
;
  LMOVE cnc.in[hmi.cnc.no,hmi.rob.gr]
  LMOVE #cnc.before[hmi.cnc.no,hmi.rob.gr]
  HOME
.END
.PROGRAM a.teach.flip()@26/09/16 15:44 #0
;
  .b.id = hmi.buf.id
  .det.id = hmi.det.id
  .save.dist1 = 85;
  .save.dist2 = 5
  .g.no = 1
;calculation
  .p1.x = .save.dist1*SIN(28);37.5 ;75 * SIN(30)
  .p1.z = .save.dist1*COS(30);64.95 ;75 * COS(30)
  .p2.x = .save.dist2*SIN(28) ;5 * SIN(30)
  .p2.z = .save.dist2*COS(30) ;5 * COS(30)
  DECOMPOSE .p[0] = buff.drop.pos[.b.id,.det.id]
  POINT .buffer.drop.off[1] = TRANS(.p[0]+.p1.x,.p[1],.p[2]+.p1.z,.p[3],.p[4],.p[5])
  POINT .buffer.drop.off[2] = TRANS(.p[0]+.p2.x,.p[1],.p[2]+.p2.z,.p[3],.p[4],.p[5])
  SPEED spd.high
  ACCURACY accu.big
  CALL set.tool(.g.no)
;
  JMOVE #stocker.safe
;
  JMOVE #buff.safe[.b.id,.det.id]; **** TEACH POINT ****
;
  SPEED spd.small
  ACCURACY accu.small
;
  LMOVE .buffer.drop.off[1]
;
  LMOVE .buffer.drop.off[2]
;
  SPEED spd.prec MM/S
  ACCURACY accu.fine
  LMOVE buff.drop.pos[.b.id,.det.id]; **** TEACH POINT ****
;
  TWAIT 0.1
  BREAK
  CALL gripper.open(.g.no,FALSE)
  TWAIT 0.1
  BREAK
  SPEED spd.small
  ACCURACY accu.small
  LDEPART 40
;
  SPEED spd.high
  ACCURACY accu.big
; JMOVE #buffer.rot.pos[.b.id]
  LMOVE #buff.rot.pos[.b.id,.det.id]; **** TEACH POINT ****
;
  SPEED spd.small
  ACCURACY accu.small
  LAPPRO buff.pick.pos[.b.id,.det.id],200
;
  SPEED spd.prec MM/S
  ACCURACY accu.fine
; LMOVE buffer.pick.pos[.b.id]
  LMOVE buff.pick.pos[.b.id,.det.id]; **** TEACH POINT ****
;
  TWAIT 0.1
  BREAK
  CALL gripper.close(.g.no,FALSE)
  TWAIT 0.1
  BREAK
;
  SPEED spd.small
  ACCURACY accu.small
  DRAW 0,0,100
;
  SPEED spd.high
  ACCURACY accu.big
  JMOVE #buff.rot.pos[.b.id,.det.id]
  HOME
.END
