.PROGRAM stocker.close(.s.no)@26/07/27 15:49 #229;
; .s.no - Stocker № (1-4)
;
  safe.st = .s.no
  $safe.flag = "stocker.start"
  CALL log("Program: Close stocker "+$ENCODE(.s.no))
  CALL gripper.close(1,FALSE)
  CALL gripper.close(2,FALSE)
;
  IF FALSE THEN
    .s.no = 1
    GOTO dbg
    .s.no = 2
    GOTO dbg
    .s.no = 3
    GOTO dbg
    .s.no = 4
    GOTO dbg
  END
dbg:
  SPEED spd.max ALWAYS
  ACCURACY accu.free ALWAYS
  CALL set.tool(3)
;
  JMOVE #stocker.safe
  IF .s.no==3 OR .s.no==4 THEN
    SIGNAL fo.lidar.small
    BREAK
  END
  $safe.flag = "stocker.safe"
;ADD 2025/12/14
  IF (.s.no==1) OR (.s.no==2) OR (.s.no==3) OR (.s.no==4) THEN
;JMOVE #kostil3
;JMOVE stocker.close[.s.no,1]+TRANS(0,0,-30)+RZ(25)+TRANS(0,250,0)+TRANS(0,0,300)
    JMOVE SHIFT(stocker.close[.s.no,1]+TRANS(0,0,-30)+RZ(25) BY 0,250,300)
    $safe.flag = "stocker.close.k3"
;JMOVE #kostil2
;JMOVE stocker.close[.s.no,1]+TRANS(0,0,-30)+RZ(25)+TRANS(0,250,0)
    JMOVE SHIFT(stocker.close[.s.no,1]+TRANS(0,0,-30)+RZ(25) BY 0,250,0)
    $safe.flag = "stocker.close.k2"
;JMOVE #kostil1
    LMOVE stocker.close[.s.no,1]+TRANS(0,0,-30)+RZ(25);+ TRANS(0,250,0)
    $safe.flag = "stocker.close.k1"
  END
  ACCURACY accu.fine
  JAPPRO stocker.close[.s.no,1],30
  $safe.flag = "stocker.close.above"
  IF .s.no==1 THEN
    $safe.flag = "stocker.close.above1"
  END
  BREAK
  CALL stocker.unlock(.s.no)
;
  IF NOT SIG(fi.unlock.fail) THEN
;
    SPEED spd.stocker MM/S
    ACCURACY accu.fine
    LMOVE stocker.close[.s.no,1]
    $safe.flag = "stocker.close1"
    IF .s.no==1 THEN
      $safe.flag = "stocker.close11"
    END
    BREAK
;
    CALL log("Stocker "+$ENCODE(.s.no)+" unlocked")
    SPEED spd.stocker MM/S
    ACCURACY accu.fine
    LMOVE stocker.close[.s.no,2]
    SPEED spd.stocker MM/S
    LMOVE stocker.close[.s.no,2]+TRANS(-3,0,0)
    $safe.flag = "stocker.close2"
    BREAK
;
    SPEED spd.stocker MM/S
    ACCURACY accu.fine
    LAPPRO stocker.close[.s.no,2]+TRANS(-3,0,0),14
    $safe.flag = "stocker.close.below"
    BREAK
    LMOVE stocker.close[.s.no,2]+TRANS(-350,0,-14)
    $safe.flag = "stocker.close.before"
    SIGNAL -fo.st.unlock[.s.no]
    SIGNAL -fo.st.opened[.s.no]
  ELSE
    CALL log("Failed to unlock stocker "+$ENCODE(.s.no))
    IF .s.no==1 THEN
      JMOVE #kostil1
      $safe.flag = "stocker.close.k1"
      JMOVE #kostil2
      $safe.flag = "stocker.close.k2"
      JMOVE #kostil3
      $safe.flag = "stocker.close.k3"
    END
  END
;
  BREAK
  JMOVE #stocker.safe
  IF .s.no==3 OR .s.no==4 THEN
    SIGNAL -fo.lidar.small
    BREAK
  END
;
.END
.PROGRAM stocker.open(.s.no)@26/07/27 15:49 #488;
  safe.st = .s.no
; .s.no - Stocker № (1-4)
;
  $safe.flag = "stocker.start"
;IF .s.no == 1 THEN
;  $safe.flag = "stocker2"
;END
  CALL log("Program: Open stocker "+$ENCODE(.s.no))
  CALL gripper.close(1,FALSE)
  CALL gripper.close(2,FALSE)
;
  IF FALSE THEN
    .s.no = 1
    GOTO dbg
    .s.no = 2
    GOTO dbg
    .s.no = 3
    GOTO dbg
    .s.no = 4
    GOTO dbg
  END
dbg:
  SPEED spd.max ALWAYS
  ACCURACY accu.free ALWAYS
  CALL set.tool(3)
;
  JMOVE #stocker.safe
; Switch zone on Lidar
  IF .s.no==3 OR .s.no==4 THEN
    SIGNAL fo.lidar.small
    BREAK
  END
;
  $safe.flag = "stocker.safe"
;
  ACCURACY accu.big
  JMOVE stocker.open[.s.no,1]+TRANS(-350,0,-14)
  $safe.flag = "stocker.open.before"
  ACCURACY accu.fine
  LAPPRO stocker.open[.s.no,1],14
  $safe.flag = "stocker.open.below"
  BREAK
  CALL stocker.unlock(.s.no)
;
  IF NOT SIG(fi.unlock.fail) THEN
    SPEED spd.stocker MM/S
    ACCURACY accu.fine
    LMOVE stocker.open[.s.no,1]
    $safe.flag = "stocker.open1"
    BREAK
;
    CALL log("Stocker "+$ENCODE(.s.no)+" unlocked")
    SPEED spd.stocker MM/S
    ACCURACY accu.fine
    LMOVE stocker.open[.s.no,2]
    SPEED spd.stocker MM/S
    LMOVE stocker.open[.s.no,2]+TRANS(3,0,0)
    $safe.flag = "stocker.open2"
    BREAK
;
    SPEED spd.stocker MM/S
    ACCURACY accu.big
    LAPPRO stocker.open[.s.no,2]+TRANS(3,0,0),30
    $safe.flag = "stocker.open.above"
    IF .s.no==1 THEN
      $safe.flag = "stocker.open.above1"
    END
    BREAK
;ADD 2025/12/14
    IF (.s.no==1) OR (.s.no==2) OR (.s.no==3) OR (.s.no==4) THEN
; RZ 25
; Dy 200
; DZ 300
      JMOVE stocker.open[.s.no,2]+TRANS(0,0,-30)+RZ(25)
;JMOVE #kostil1
      $safe.flag = "stocker.open.k1"
;JMOVE #kostil2
;LMOVE stocker.open[.s.no,2]+TRANS(0,0,-30)+RZ(25)+TRANS(0,250,0)
      LMOVE SHIFT(stocker.open[.s.no,2]+TRANS(0,0,-30)+RZ(25) BY 0,250,0)
      $safe.flag = "stocker.open.k2"
;JMOVE #kostil3
;LMOVE stocker.open[.s.no,2]+TRANS(0,0,-30)+RZ(25)+TRANS(0,250,0)+TRANS(0,0,300)
      LMOVE SHIFT(stocker.open[.s.no,2]+TRANS(0,0,-30)+RZ(25) BY 0,250,300)
      $safe.flag = "stocker.open.k3"
    END
    SIGNAL -fo.st.unlock[.s.no]
    SIGNAL fo.st.opened[.s.no]
  ELSE
    CALL log("Failed to unlock stocker "+$ENCODE(.s.no))
;ACCURACY accu.fine
;LAPPRO stocker.open[.s.no, 1], 30
;$safe.flag = "stocker.open.below"
;BREAK
    LMOVE stocker.open[.s.no,1]+TRANS(-350,0,-30)
    $safe.flag = "stocker.open.below"
  END
;
  JMOVE #stocker.safe
  IF .s.no==3 OR .s.no==4 THEN
    SIGNAL -fo.lidar.small
    BREAK
  END
  $safe.flag = "stocker.safe"
;
.END
.PROGRAM stocker.unlock(.s.no)@26/07/27 15:49 #1047
; .s.no - Stocker № (1-4)
;
  IF FALSE THEN
    .s.no = 1
    GOTO dbg
    .s.no = 2
    GOTO dbg
    .s.no = 3
    GOTO dbg
    .s.no = 4
    GOTO dbg
  END
dbg:
;
  CALL log("Request stocker "+$ENCODE(.s.no)+" unlock")
  SIGNAL fo.st.unlock[.s.no]
  WAIT BITS(fi.st.unlocked[1],5)<>0
.END
