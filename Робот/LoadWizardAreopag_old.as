      POINT .dy.vec.temp = TRANS(DX(dy.vec.normal[hmi.stock.no,hmi.stock.id,hmi.rob.gr])*.stock.ly,DY(dy.vec.normal[hmi.stock.no,hmi.stock.id,hmi.rob.gr])*.stock.ly,DZ(dy.vec.normal[hmi.stock.no,hmi.stock.id,hmi.rob.gr])*.stock.ly,0,0,0)
      POINT .origin = TRANS(DX(stp.1[hmi.stock.no,hmi.stock.id,hmi.rob.gr]),DY(stp.1[hmi.stock.no,hmi.stock.id,hmi.rob.gr]),DZ(stp.1[hmi.stock.no,hmi.stock.id,hmi.rob.gr]))
;Расчет точки
      POINT .test.grip = .origin+.dx.vec.temp+.dy.vec.temp
