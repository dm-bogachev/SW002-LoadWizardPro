.PROGRAM plc.control.pc()@26/07/31 14:09 #0
  RUNMASK fo.pc.error
  SIGNAL fo.pc.error
  WHILE TRUE DO
    IF NOT SWITCH(CS ) THEN
      IF SIG(fi.plc.g.open[1]) THEN
        CALL gripper.open(1,FALSE)
      END
;
      IF SIG(fi.plc.g.open[2]) THEN
        CALL gripper.open(2,FALSE)
      END
;
      IF SIG(fi.plc.g.close[1]) THEN
        CALL gripper.close(1,FALSE)
      END
;
      IF SIG(fi.plc.g.close[2]) THEN
        CALL gripper.close(2,FALSE)
      END
    END
;
;***
    .spd = BITS(fi.mon.speed[0],16)
    IF .spd<>last.mon.spd AND .spd>0 THEN
      MON_SPEED .spd
      last.mon.spd = .spd
    END
;***
;
    IF SIG(di.ext.ereset) THEN
      SIGNAL -fo.grip.chk.err
    END
    IF SIG(fi.proc.stop) THEN
      PRINT 0: "Process reset requested"
      SIGNAL fo.process.res
      SIGNAL -fo.proc.on
      SWAIT -fi.proc.stop
    END
    IF SIG(fo.grip.chk.err) THEN
      SOUT 82 = 33
      SOUT 83 = -33
      SOUT 84 = 34
      SOUT 85 = -34
    END
    SOUT 86 = 35
    TWAIT 0.1
  END
.END
.PROGRAM plc.data.pc()@25/12/18 13:49 #0;
  RUNMASK fo.pc.error
  SIGNAL fo.pc.error
  WHILE TRUE DO
    data.el = 0
    data.max = 32
    SWAIT fi.de.start
    CALL log("Data exchange started")
    SIGNAL fo.de.robot.rdy
    TWAIT 0.1
    WHILE data.el<=data.max DO
;CALL log ("Waiting for data")
      SWAIT fi.de.data.rdy
;IF SIG (fi.de.data.rdy) THEN
      data.type = BITS(fi.de.recipe[0],8)
      data.id = BITS(fi.de.table.id[0],8)
      data.el = BITS(fi.de.table.el[0],8)+1
      data = BITS(fi.de.data[0],16)
;
      CASE data.type OF
       VALUE 1:
        $type = "Detail "
        detail.data[data.id,data.el] = data
        data.max = 18
       VALUE 2:
        $type = "Stocker "
        stocker.data[data.id,data.el] = data
        data.max = 24
       VALUE 3:
        $type = "Chuck "
        chuck.data[data.id,data.el] = data
        data.max = 1
       VALUE 4:
        $type = "Task "
        task.data[data.id,data.el] = data
        data.max = 24
       VALUE 5:
        $type = "Corr"
;
        corr.data[data.id,data.el] = BITS(fi.de.data[0],15)
        IF SIG(fi.de.data[15]) THEN
          corr.data[data.id,data.el] = 32768-corr.data[data.id,data.el]
        END
        corr.data[data.id,data.el] = corr.data[data.id,data.el]/10
;IF (corr.data[data.id, data.el] > 20) THEN
;  corr.data[data.id, data.el] = 20
;END
        IF SIG(fi.de.data[15]) THEN
          corr.data[data.id,data.el] = -corr.data[data.id,data.el]
        END
;
      END
      CALL log("Loaded data: "+$type+"id = "+$ENCODE(data.id)+" PARAMETER "+$ENCODE(data.el)+" = "+$ENCODE(data))
;
      PULSE fo.de.data.ack,0.05
      TWAIT 0.1
    END
    SIGNAL -fo.de.robot.rdy
    TWAIT 1
  END
.END
.PROGRAM prl.close.shelf(.s.no)@26/07/27 15:49 #78
; .s.no - Stocker № (1-4)
  safe.st = .s.no
  $safe.flag = "stocker.start"
  CALL log("Program: Close stocker "+$ENCODE(.s.no))
  CALL gripper.close(1,FALSE)
  CALL gripper.close(2,FALSE)
;
  IF FALSE THEN
    .s.no = 1
    GOTO dbg
    .s.no = 2
    GOTO dbg
    .s.no = 3
    GOTO dbg
    .s.no = 4
    GOTO dbg
  END
dbg:
  SPEED spd.max ALWAYS
  ACCURACY accu.free ALWAYS
  CALL set.tool(6)
;
  JMOVE #st.prl.safe_2
; Switch zone on Lidar
  IF .s.no==3 OR .s.no==4 THEN
    SIGNAL fo.lidar.small
    BREAK
  END
  $safe.flag = "shelf.safe"
  LMOVE st.shaft.open[.s.no,2]+TRANS(-150,-150,500)+RZ(70)
  LMOVE st.shaft.open[.s.no,2]+TRANS(-150,-150,-19)+RZ(70)
  ACCURACY accu.fine
  LAPPRO SHIFT(st.shaft.open[.s.no,2] BY 0e+00,-2,-5),19
  $safe.flag = "shelf.close.above"
  BREAK
  CALL stocker.unlock(.s.no)
;
  IF NOT SIG(fi.unlock.fail) THEN
;
    SPEED spd.small MM/S
    ACCURACY accu.fine
    LMOVE st.shaft.open[.s.no,2]
    $safe.flag = "shelf.close1"
    BREAK
;
    CALL log("Shelf "+$ENCODE(.s.no)+" unlocked")
    SPEED spd.medium
    ACCURACY accu.fine
    LMOVE SHIFT(st.shaft.open[.s.no,1] BY 0e+00,-2,0)
    $safe.flag = "shelf.close2"
    BREAK
;
    SPEED spd.medium
    ACCURACY accu.fine
    LMOVE st.shaft.open[.s.no,1]
    $safe.flag = "shelf.close.below"
    BREAK
    LAPPRO st.shaft.open[.s.no,1],19
    $safe.flag = "shelf.close.before"
    SIGNAL -fo.st.unlock[.s.no]
    SIGNAL -fo.st.opened[.s.no]
  ELSE
    CALL log("Failed to unlock stocker "+$ENCODE(.s.no))
  END
;
  BREAK
  JMOVE st.shaft.open[.s.no,1]+TRANS(-350,-350,-19)
  JMOVE #st.prl.safe_2
; Switch zone on Lidar
  IF .s.no==3 OR .s.no==4 THEN
    SIGNAL -fo.lidar.small
    BREAK
  END
;
.END
.PROGRAM prl.open.shelf(.s.no)@26/07/27 15:49 #181
; .s.no - Stocker № (1-4)
  safe.st = .s.no
;
