.PROGRAM gripper.check(.g.no)@26/07/27 15:49 #13748
; .g.no - Gripper № (1-2)
;
;Check requirement
  SIGNAL -fo.grip.chk.err
  IF NOT SIG(fi.grip.check) THEN
    RETURN
  END
; Get data from PLC settings
  g.error.time = BITS(fi.plc.g.etime[0],8)/10
  IF (g.error.time<1) THEN
    g.error.time = 1
  END
  IF (g.error.time>10) THEN
    g.error.time = 10
  END
; Perform check
  TIMER 1 = 0
  g.failed = TRUE
  WHILE TIMER(1)<g.error.time DO
    IF SIG(i.grip.opened[.g.no]) THEN
      g.failed = FALSE
      TIMER 1 = g.error.time+1
    END
  END
; Set result
  IF g.failed THEN
    CALL log("Error opening gripper "+$ENCODE(.g.no))
    SIGNAL fo.grip.chk.err
    SWAIT -fo.grip.chk.err
  END
.END
.PROGRAM gripper.close(.g.no,.inverse)@26/07/27 15:49 #10980
; .g.no - Gripper № (1-2)
; .tmo - Gripper timeout
; .inverse - Inverse gripper
;
  CALL log("Gripper "+$ENCODE(.g.no)+"close")
; Get data from PLC settings
  g.close.time = BITS(fi.plc.g.ctime[0],8)/10
  IF (g.close.time<0) THEN
    g.close.time = 0
  END
  IF (g.close.time>10) THEN
    g.close.time = 10
  END
;
  IF .inverse THEN
    SIGNAL -o.grip.open[.g.no],o.grip.close[.g.no]
  ELSE
    SIGNAL o.grip.open[.g.no],-o.grip.close[.g.no]
  END
  IF SWITCH(CS ) THEN
    BREAK
  END
  TWAIT 0.5
;
  SIGNAL -fo.grip.opened[.g.no],fo.grip.closed[.g.no]
;
.END
.PROGRAM gripper.open(.g.no,.inverse)@26/07/27 15:49 #13851
; .g.no - Gripper № (1-2)
; .tmo - Gripper timeout
; .inverse - Inverse gripper
;
; Get data from PLC settings
  CALL log("Gripper "+$ENCODE(.g.no)+"open")
  g.open.time = BITS(fi.plc.g.otime[0],8)/10
  IF (g.open.time<0) THEN
    g.open.time = 0
  END
  IF (g.open.time>10) THEN
    g.open.time = 10
  END
;
  IF .inverse THEN
    SIGNAL o.grip.open[.g.no],-o.grip.close[.g.no]
  ELSE
    SIGNAL -o.grip.open[.g.no],o.grip.close[.g.no]
  END
  IF SWITCH(CS ) THEN
    BREAK
  END
  TWAIT 0.5
;
  CALL gripper.check(.g.no)
;
  IF NOT SIG(fo.grip.chk.err) THEN
    SIGNAL fo.grip.opened[.g.no],-fo.grip.closed[.g.no]
    TWAIT g.open.time
  END
;
.END
