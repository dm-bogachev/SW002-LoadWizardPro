  first.iteration = TRUE
  last.iteration = FALSE
  current.row = 1
  current.col = 1
  last.row = 1
  last.col = 1
  detail.done = 0
  detail.count = 0
  state = 0
;add 2025.12.12
  current.state = 0
  grip2haspart = FALSE
  SIGNAL -fo.process.res
  SIGNAL -fo.lidar.small
  RESET
.END
.PROGRAM process.shaft(.s.no)@26/07/27 15:49 #155
;
  task.id = BITS(fi.st.task[.s.no,0],8)
;task.id = 9 ;Для Отладки
  CALL log("Working on stocker "+$ENCODE(.s.no)+" with task "+$ENCODE(task.id))
  CALL task.get.data(task.id)
;Переопределение переменных для поддержки старых функций
  task.op2.c.no = 1 ; потом приравнять в get task шпиндель у нас 1
  task.op3.c.no = 1 ; потом приравнять в get task шпиндель у нас 1
  task.op1.g.no = 1 ; Всегда  1 захватом берем с полки
  task.op3.g.no = 2 ; Всегда  2 захватом возвращаем
  IF current.state==0 THEN
;S0. Init State
    IF SIG(fi.cnc.err) THEN
      CALL log("Failed to run program "+$ENCODE(task.op2.pg))
      .s.no = 100 ; Dirty hack!
      RETURN
    END
    HOME
;Dirty hack - запуск цикла очистки перед установкой первой детали полки
;CALL cnc.run.pg (1)
;Остановка интерпретатора
    TWAIT 0.1
    BREAK
    current.state = 100
    current.part = 1
    detail.count = BITS(fi.detail.cnt[.s.no],16);
;detail.count = 3 ;Для Отладки
    CALL log("[Part ?/?] current state "+$ENCODE(current.state)+": INIT task="+$ENCODE(task.id)+" total_details="+$ENCODE(detail.count))
  END
  IF current.state==100 THEN
    CALL log("[Part ?/?] current state "+$ENCODE(current.state)+": Gripper validation")
;Проверка типа захват;
    IF TRUE THEN
      current.state = 1
    ELSE ;Нет
      current.state = 16
      GOTO errorstate
    END
  END
  IF current.state==1 THEN
    CALL log("[Part ?/?] current state "+$ENCODE(current.state)+": OPEN stocker "+$ENCODE(.s.no))
    IF NOT SIG(fo.st.opened[.s.no]) THEN
      CALL log("Required to open stocker "+$ENCODE(.s.no))
;SWAIT mi.open.shelf
      CALL prl.open.shelf(.s.no)
      IF SIG(fi.unlock.fail) THEN
        .s.no = 100 ; Dirty hack!
        current.state = 16
        GOTO errorstate
      END
    END
    IF detail.count==0 THEN
      current.state = 14
    ELSE
      current.state = 2
    END
  END
  IF (current.state==14) OR (current.state==15) OR (current.state==16) THEN
    CALL log("current state"+$ENCODE(current.state)+" :Goto Cycle Finish")
    GOTO cyclefinish
;
  END
; +1 деталь для учета последний итерации
  WHILE current.part<detail.count+1 DO
    CALL log("Current state:"+$ENCODE(current.state)+"")
    CASE current.state OF
     VALUE 2:
;PICK PART
      .rob.grip.id = 1 ;ставим всегда первым
      .t.no = 5
      CALL log("[Part "+$ENCODE(current.part)+"/"+$ENCODE(detail.count)+"] current state "+$ENCODE(current.state)+": PICK to stocker St="+$ENCODE(.s.no)+" .rob.grip.id="+$ENCODE(.rob.grip.id))
      CALL st.shaft.pick(.s.no,.rob.grip.id,.t.no);
;Остановка интерпретатора
      TWAIT 0.1
      BREAK
;Переходы
      current.state = 3;
     VALUE 3:
;WAIT CNC READY
      HOME
      CALL log("[Part "+$ENCODE(current.part)+"/"+$ENCODE(detail.count)+"] current state "+$ENCODE(current.state)+": WAIT CNC ready")
      SWAIT fi.cnc.ready
;Остановка интерпретатора
      TWAIT 0.1
      BREAK
;Переходы
      current.state = 4;
     VALUE 4:
;INSTALL PART
      CALL log("[Part "+$ENCODE(current.part)+"/"+$ENCODE(detail.count)+"] current state "+$ENCODE(current.state)+": INSTALL PART")
      .cncslotinst = 1
      .t.no = 5
      .rob.grip.id = 1 ;ставим всегда первым
      .cnc.grip.id = 1; Кулачки в патроне
;Dirty hack - запуск цикла очистки перед установкой первой детали полки
      CALL cnc.run.pg(1)
;SWAIT fi.cnc.ready
      CALL cnc.shaft.in(.t.no,.cncslotinst)
      CALL cnc.shaft.put(.cncslotinst,.t.no,.cnc.grip.id,.rob.grip.id)
      CALL cnc.shaft.out(.t.no,.cncslotinst)
;Остановка интерпретатора
      TWAIT 0.1
      BREAK
;Переходы
      current.state = 5;
     VALUE 5:
; Запуск станка М команды
      CALL log("[Part "+$ENCODE(current.part)+"/"+$ENCODE(detail.count)+"] current state "+$ENCODE(current.state)+": START CNC cycle  ")
      HOME;
      BREAK
      TWAIT 0.1
      CALL cnc.run.pg(1)
;CALL cnc.mfinish
;Остановка интерпретатора
      TWAIT 0.1
      BREAK
;Переходы
      IF shatf.back==1 THEN
; Возврат вала в кондуктор требуется
        current.state = 6;
      ELSE
; Возврат вала в кондуктор не требуется
        current.part = current.part+1; Увеличиваем индекс детали
        IF (current.part<=detail.count) THEN
; Еще есть детали;
          current.state = 2;
          .$if_msg = "CONTINUE"
        ELSE ;(Нет)
; current.part > detail.count
; Все детали закончились;
          current.state = 14;
          .$if_msg = "FINISH"
        END
        CALL log("[Part "+$ENCODE(current.part)+"/"+$ENCODE(detail.count)+"] current state 5, Next state"+$ENCODE(current.state)+": CYCLE CHECK remaining="+$ENCODE(detail.count-current.part)+" next="+.$if_msg)
      END
     VALUE 6:
;WAIT CNC READY
      HOME
      CALL log("[Part "+$ENCODE(current.part)+"/"+$ENCODE(detail.count)+"] current state "+$ENCODE(current.state)+": WAIT CNC FINISH and READY")
      SWAIT fi.cnc.ready
;Остановка интерпретатора
      TWAIT 0.1
      BREAK
;Переходы
      current.state = 7;
     VALUE 7:
;RETURN PART
      CALL log("[Part "+$ENCODE(current.part)+"/"+$ENCODE(detail.count)+"] current state "+$ENCODE(current.state)+": RETURN PART")
      .cncslotinst = 1
      .t.no = 5
      .rob.grip.id = 2 ;Забираем всегда 2
      .cnc.grip.id = 1; Кулачки в патроне
      CALL cnc.shaft.in(.t.no,.cncslotinst)
      CALL cnc.shaft.pick(.cncslotinst,.t.no,.cnc.grip.id,.rob.grip.id)
      CALL cnc.shaft.out(.t.no,.cncslotinst)
      HOME
      BREAK
; CALL cnc.run.pg(1)
      CALL st.shaft.put(.s.no,.rob.grip.id,.t.no);
;CHECK LAST PART
      current.part = current.part+1; Увеличиваем индекс детали
;Остановка интерпретатора
      TWAIT 0.1
      BREAK
;Переходы
      IF (current.part<=detail.count) THEN
; Еще есть детали;
        current.state = 2;
        .$if_msg = "CONTINUE"
      ELSE ;(Нет)
; Все детали закончились;
        current.state = 14;
        .$if_msg = "FINISH"
      END
      CALL log("[Part "+$ENCODE(current.part)+"/"+$ENCODE(detail.count)+"] current state 7, Next state"+$ENCODE(current.state)+": CYCLE CHECK remaining="+$ENCODE(detail.count-current.part)+" next="+.$if_msg)
any:
;Your code
      CALL log("NEXT STATE: "+$ENCODE(current.state))
    END
  END
;
cyclefinish:
  IF current.state==14 THEN
    CALL log("[Part "+$ENCODE(current.part)+"/"+$ENCODE(detail.count)+"] current state "+$ENCODE(current.state)+": CLOSE stocker "+$ENCODE(.s.no))
;SWAIT mi.close.shelf
    CALL prl.close.shelf(.s.no)
    IF SIG(fi.unlock.fail) THEN
      RETURN
    END
    current.state = 15
  END
;
  IF current.state==15 THEN
    CALL log("[Part "+$ENCODE(detail.count)+"/"+$ENCODE(detail.count)+"] current state "+$ENCODE(current.state)+": PROCESS COMPLETE ")
    CALL process.reset
    HOME
    PULSE fo.st.complete[.s.no]
    SIGNAL -fo.stocker.work[.s.no]
  END
errorstate:
  IF current.state==16 THEN
;Ошибка в при открытие или не тот захват;
;Пока просто выход
    CALL log("[Part "+$ENCODE(current.part)+"/"+$ENCODE(detail.count)+"] current state "+$ENCODE(current.state)+":  ERROR step="+$ENCODE(current.state)+" SIG_UNLOCK_FAIL="+$ENCODE(SIG(fi.unlock.fail)))
    RETURN
  END
  CALL log("END FILE PROCESS "+$ENCODE(.s.no)+" LAST STATE"+$ENCODE(current.state))
;
.END
