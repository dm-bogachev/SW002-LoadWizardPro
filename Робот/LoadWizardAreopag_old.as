.PROGRAM cnc.shaft.pick(.c.no,.t.no,.cnc.g.no,.g.no)@26/07/27 15:49 #194;
; .c.g.no - CNC  No
; .t.no - Tool Number
; .g.no - набор кулачков 1 или 2
  safe.c = .c.no
  safe.g = .g.no
  safe.t = .t.no
  $safe.flag = "cnc.shaft.pick"
;
  .$str = "CNC num = "+$ENCODE(.c.no)
  .$str = "put grip id = "+$ENCODE(.g.no)
  .$str = .$str+"  cnc grip id  = "+$ENCODE(.cnc.g.no)
  .$str = .$str+" Tool Num  = "+$ENCODE(.t.no)
  CALL log(.$str)
;
; Get data
  g.cf = chuck.g.full[.g.no]
  g.cw = chuck.g.work[.g.no]
  cnc.cf = chuck.cnc.full[.cnc.g.no]
  cnc.cw = chuck.cnc.work[.cnc.g.no]
  g = g.cf-g.cw
  cnc = cnc.cf-cnc.cw
; 3 потому у нас это константа так 3 захват
  POINT .tmp.frame = cnc.c[.c.no,3]
;Добавляем разворот.Угол задаем сами
;DECOMPOSE .p[0]= cnc.c[.c.no, 3]
;POINT .tmp.frame = TRANS (.p[0], .p[1], .p[2])
;POINT .tmp.frame = .tmp.frame + RX (-90)+RZ(30)
  IF shaft.rot==0 THEN
;Разворот инструмента не нужен
    .part.len.ins = shaft.final.l-shaft.final.l2
    CALL log("NOT ROT TOOL, PART INSTALL LEN"+$ENCODE(.part.len.ins))
  ELSE
;Разворот инструмента
    .part.len.ins = shaft.final.l2
    CALL log("YES ROT TOOL, PART INSTALL LEN"+$ENCODE(.part.len.ins))
  END
;
; Calculation
  g = g.cf-g.cw
  cnc = cnc.cf-cnc.cw
  .safe.dist.y = 40
  .safe.inst.z = -shaft.final.l-50
;
  put.shift.x = 0e+00
  put.shift.y = -(g)
  put.shift.z = cnc+.part.len.ins
; Set motion aux defaults
  SPEED spd.high ALWAYS
  ACCURACY accu.big ALWAYS
;
  CALL set.tool(.t.no)
;
  BREAK
;Отрытие захвата, Зато красиво
  CALL gripper.open(1,FALSE)
  CALL gripper.open(2,FALSE)
; Motion
;Safe Point
;SPEED spd.prec MM/S
  ACCURACY accu.small
  JAPPRO .tmp.frame+TRANS(put.shift.x,put.shift.y,put.shift.z,0,0,0),.safe.inst.z
;Capture point
  SPEED spd.prec MM/S
  ACCURACY accu.fine
  LMOVE .tmp.frame+TRANS(put.shift.x,put.shift.y,put.shift.z,0,0,0)
  BREAK
;Закрытие захвата, Зато красиво
  CALL gripper.close(2,FALSE)
  CALL gripper.close(1,FALSE)
  BREAK
  CALL cnc.chuck.open(.c.no)
  IF SIG(fi.cnc.chuck.er[.c.no]) THEN
    CALL log("Error opening the CNC chuck Wait for reset or continue")
    WHILE SIG(fi.cnc.chuck.er[.c.no]) DO
      SWAIT -fi.cnc.chuck.er[.c.no]
    END
  END
  BREAK
;departure from the part
  SPEED spd.medium
  ACCURACY accu.medium
;LMOVE .tmp.frame + TRANS (0, 0, (cnc + .part.len.ins + .safe.inst.z)) + TRANS (0, - (g), 0)
;LMOVE .tmp.frame + TRANS (0, 0, (cnc + .part.len.ins + .safe.inst.z)) + TRANS (0, - (g + .safe.dist.y), 0)
  LAPPRO .tmp.frame+TRANS(put.shift.x,put.shift.y,put.shift.z,0,0,0),.safe.inst.z
;
.END
.PROGRAM cnc.shaft.put(.c.no,.t.no,.cnc.g.no,.g.no)@26/07/27 15:49 #455;
; .c.g.no - CNC  No
; .t.no - Tool Number
; .g.no - набор кулачков 1 или 2
  safe.c = .c.no
  safe.g = .g.no
  safe.t = .t.no
;
  .$str = "CNC num = "+$ENCODE(.c.no)
  .$str = "put grip id = "+$ENCODE(.g.no)
  .$str = .$str+"  cnc grip id  = "+$ENCODE(.cnc.g.no)
  .$str = .$str+" Tool Num  = "+$ENCODE(.t.no)
  CALL log(.$str)
; Get data
  g.cf = chuck.g.full[.g.no]
  g.cw = chuck.g.work[.g.no]
  cnc.cf = chuck.cnc.full[.cnc.g.no]
  cnc.cw = chuck.cnc.work[.cnc.g.no]
;
; Calculation
  g = g.cf-g.cw
  cnc = cnc.cf-cnc.cw
; 3 потому у нас это константа
  POINT .tmp.frame = cnc.c[.c.no,3]
;Добавляем разворот.Угол задаем сами
;DECOMPOSE .p[0]= cnc.c[.c.no, 3]
;POINT .tmp.frame = TRANS (.p[0], .p[1], .p[2])
;POINT .tmp.frame = .tmp.frame + RX (-90)+RZ(30)
  IF shaft.reclamp==0 THEN
;Разворот инструмента не нужен
;Длина детали для установки
    .part.len.ins = shaft.orig.l-shaft.orig.l2
    CALL log("NOT ROT TOOL, PART INSTALL LEN"+$ENCODE(.part.len.ins))
  ELSE
;Разворот инструмента
;Длина детали для установки
    .part.len.ins = shaft.orig.l2
    CALL log("YES ROT TOOL, PART INSTALL LEN"+$ENCODE(.part.len.ins))
  END
  put.shift.x = 0e+00
  put.shift.y = -(g)
  put.shift.z = cnc+.part.len.ins-4 ;4мм поджим детали
;
  .safe.dist.y = 40
  .safe.inst.z = -shaft.orig.l-50
;
; Set motion aux defaults
  SPEED spd.high ALWAYS
  ACCURACY accu.big ALWAYS
;
; Check chuck
  CALL cnc.chuck.open(.c.no)
  IF SIG(fi.cnc.chuck.er[.c.no]) THEN
    CALL log("Error opening the CNC chuck Wait for reset or continue")
    WHILE SIG(fi.cnc.chuck.er[.c.no]) DO
      SWAIT -fi.cnc.chuck.er[.c.no]
    END
  END
; Motion
  CALL set.tool(.t.no)
;Safe Point
  JAPPRO .tmp.frame+TRANS(put.shift.x,put.shift.y,put.shift.z,0,0,0),.safe.inst.z
  $safe.flag = "cnc.shaft.put"
;
  SPEED spd.prec MM/S
  ACCURACY accu.small
;Подъезд к кулачкам
  LAPPRO .tmp.frame+TRANS(put.shift.x,put.shift.y,put.shift.z),-(cnc.cf+10)
;
  SPEED spd.prec MM/S
  ACCURACY accu.fine
;Capture point
  LMOVE .tmp.frame+TRANS(put.shift.x,put.shift.y,put.shift.z)
;
  BREAK
  CALL cnc.chuck.close(.c.no)
  IF SIG(fi.cnc.chuck.er[.c.no]) THEN
    CALL log("Error closing the CNC chuck Wait for reset or continue")
    WHILE SIG(fi.cnc.chuck.er[.c.no]) DO
      SWAIT -fi.cnc.chuck.er[.c.no]
    END
  END
  BREAK
;Открытие захвата, Зато красиво
  CALL gripper.open(1,FALSE)
  CALL gripper.open(2,FALSE)
;
  SPEED spd.medium
  ACCURACY accu.medium
;Выезд
  LAPPRO .tmp.frame+TRANS(put.shift.x,put.shift.y,put.shift.z,0,0,0),.safe.inst.z
;
.END
