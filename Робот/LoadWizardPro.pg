.PROGRAM state0 () ; Initialization
  ;
  CALL log ("State 0: Initialization")
  ;
  SIGNAL eo.robot.ready
  CALL log ("Waiting for task start")
  SWAIT ei.task.start
  CALL log ("Task start command received")
  ;
  ; Resetting signals
  SIGNAL -s.shelf.failed
  BITS eo.shelf.opened[1], 4 = 0
  ;
  SIGNAL eo.task.exec
  SIGNAL -eo.robot.ready
  SIGNAL -s.p.put.air.req
  SIGNAL -s.a.pic.air.req
  SIGNAL -s.mcode.req
  SIGNAL -s.ext.chg.ok
  SIGNAL -s.ext.chg.req
  current.shelf = 0
  ;
  state = 1
  RETURN
  ;
.END
.PROGRAM state1 () ; Check ready shelves
  ;
  CALL log ("State 1: Check ready shelves")
  WHILE TRUE DO
    IF NOT SIG (ei.task.start) THEN
      CALL log ("Task signal was turned off by operator")
      state = 255
      RETURN
    END
    ;
    current.shelf = current.shelf + 1
    IF current.shelf == 5 THEN
      current.shelf = 1
    END
    ;
    IF SIG (ei.shelf.ready[current.shelf]) THEN
      CALL log ("Shelf" + $ENCODE (current.shelf) + " is ready. Request data!")
      ;
      SIGNAL eo.data.request[current.shelf]
      SWAIT ei.data.ready
      SIGNAL -eo.data.request[current.shelf]
      ;
      gripper.id[1] = 0
      gripper.id[2] = 0
      gripper.state[1] = -1
      gripper.state[2] = -1
      cnc.id[1]     = 0
      cnc.id[2]     = 0
      cnc.state[1] = -1
      cnc.state[2] = -1
      current.wp    = 1
      processed.wp  = 0
      ;
      CALL get.task.data
      ;
      IF air.blow[1] THEN
        SIGNAL s.p.put.air.req
      END
      IF air.blow[2] THEN
        SIGNAL s.a.pic.air.req
      END
      ;
      SPEED 100
      HOME
      ;
      state = 100
      RETURN
    END
    HOME2
  END
  ;
.END
.PROGRAM state2 () ; Open shelf
  ;
  CALL log ("State 2: Open shelf")
  CALL shelf.open (current.shelf)
  ;
  IF NOT SIG (s.shelf.failed) THEN
    state = decision.state
    RETURN
  ELSE
    state = 255
    RETURN
  END
  ;
.END
.PROGRAM state3 () ; Close shelf
  ;
  CALL log ("State 3: Close shelf")
  CALL shelf.close(current.shelf)
  ;
  IF NOT SIG(s.shelf.failed) THEN
    state = 6
    RETURN
  ELSE
    state = 255
    RETURN
  END
  ;
.END
.PROGRAM state4 () ; Pick WP[0] from shelf
  ;
  CALL log ("State 4: Pick workpiece from shelf")
  ;
  .grip.no = 1
  IF SIG (do.home2) THEN
    HOME
  END
  ;
  IF SIG (do.home) THEN
    JMOVE #wp.safe[.grip.no]
  END
  ;
  CALL wp.pick (current.shelf, .grip.no, current.wp)
  IF SIG (eo.grip.error[.grip.no]) THEN
    state = 255
  ELSE
    current.wp = current.wp + 1
    ;
    IF NOT SIG (s.search.fail) THEN
      state = decision.state
    ELSE
      state = 4
    END
  END
  ;
  RETURN
  ;
.END
.PROGRAM state5 () ; Put WP[2] to shelf
  ;
  CALL log ("State 5: Put WP[2] to shelf")
  ;
  .grip.no = 2 ; 
  ;
  IF SIG (do.home2) THEN
    HOME
  END
  ;
  IF SIG (do.home) THEN
    JMOVE #wp.safe[.grip.no]
  END
  ;
  .wp.id = ABS (gripper.id[.grip.no])
  CALL wp.put (current.shelf, .grip.no, .wp.id)
  ;
  state = decision.state
  ;
.END
.PROGRAM state6 () ; Finish shelf
  ;
  CALL log("State 6: Finish shelf")
  PULSE eo.shelf.cmplt[current.shelf], 1
  ;
  ;
  SPEED 100 ALWAYS
  HOME
  ;
  state = 1
  ;
.END
.PROGRAM state7 () ; Move inside CNC
  ;
  CALL log ("State 7: Move inside CNC")
  ;
  CASE decision.state OF
    VALUE 101:
      IF gp.full[1] AND cnc.empty[1] THEN
        .grip.no = 1
        .chuck.no = 1
      END
      IF gp.empty[2] AND cnc.full[1] THEN
        .grip.no = 2
        .chuck.no = 1
      END
    VALUE 102:
      .grip.no = 1
      .chuck.no = 1
    VALUE 103:
      IF gp.wp0[1] AND cnc.empty[1] THEN
        .grip.no = 1
        .chuck.no = 1
      END
      IF gp.empty[gp.int] AND cnc.wp1[2] THEN
        .grip.no = gp.int
        .chuck.no = 2
      END
      IF gp.empty[2] AND cnc.wp2[1] THEN
        .grip.no = 2
        .chuck.no = 1
      END
    VALUE 105:
      IF gp.wp0[1] AND cnc.empty[1] THEN
        .grip.no = 1
        .chuck.no = 1
      END
      IF gp.empty[gp.ext.1] AND cnc.wp1[1] THEN
        .grip.no = gp.ext.1
        .chuck.no = 1
      END
      IF gp.empty[2] AND cnc.wp2[1] THEN
        .grip.no = 2
        .chuck.no = 1
      END
  END
  ;
  IF SIG (do.home2) THEN
    HOME
  END
  ;
  CALL cnc.move.in (.grip.no, .chuck.no)
  state = decision.state
  RETURN
  ;
.END
.PROGRAM state8 () ; Move outside CNC
  CALL log ("State 8: Move outside CNC")
  ;
  CASE decision.state OF
    VALUE 101:
      IF gp.empty[1] AND cnc.full[1] THEN
        .grip.no = 1
        .chuck.no = 1
      END
      IF gp.full[2] AND cnc.empty[1] THEN
        .grip.no = 2
        .chuck.no = 1
      END
    VALUE 102:
      .grip.no = 1
      .chuck.no = 1
    VALUE 103:
      IF gp.empty[1] AND cnc.wp0[1] THEN
        .grip.no = 1
        .chuck.no = 1
      END
      IF gp.wp2[2] AND cnc.empty[1] THEN
        .grip.no = 2
        .chuck.no = 1
      END
      IF gp.empty[gp.int] AND cnc.wp1[1] THEN
        .grip.no = gp.int
        .chuck.no = 1
      END
    VALUE 105:
      IF gp.empty[1] AND cnc.wp0[1] THEN
        .grip.no = 1
        .chuck.no = 1
      END
      IF gp.empty[gp.ext.2] AND cnc.wp1[1] THEN
        .grip.no = gp.ext.2
        .chuck.no = 1
      END
      IF gp.wp2[2] AND cnc.empty[1] THEN
        .grip.no = 2
        .chuck.no = 1
      END
  END
  ;
  IF SIG (do.home2) THEN
    HOME
  END
  ;
  CALL cnc.move.out (.grip.no, .chuck.no)
  ;
  IF air.blow[1] THEN
    SIGNAL s.p.put.air.req
  END
  IF air.blow[2] THEN
    SIGNAL s.a.pic.air.req
  END
  SIGNAL -s.ext.chg.req
  ;
  state = decision.state
  ;
.END
.PROGRAM state9 () ; Put WP[0] to CNC
  ;
  CALL log ("State 9: Put wp[0] to CNC")
  ;
  .wp.state = 0
  .grip.no = 1 
  .chuck.no = 1 
  ;
  CALL cnc.put(.grip.no, .chuck.no, .wp.state)
  ;
  state = decision.state
  ;
.END
.PROGRAM state10 () ; Pick WP[1] from CNC
  ;
  CALL log ("State 10: Pick wp[1] from CNC")
  ;
  IF int.change THEN
    .chuck = 2
    IF grip.chg.int[1] THEN
      .gp.chg = 1
    ELSE
      .gp.chg = 2
    END
  END
  IF ext.change THEN
    .chuck = 1
    IF grip.chg.ext[1, 1] THEN
      .gp.chg = 1
    ELSE
      .gp.chg = 2
    END
  END
  ;
  .wp.state = 1
  .grip.no = .gp.chg
  .chuck.no = .chuck
  ;
  CALL cnc.pick (.grip.no, .chuck.no, .wp.state)
  ;
  IF SIG (eo.grip.error[.grip.no]) THEN
    state = 255
  ELSE
    state = decision.state
  END
  ;
  SIGNAL s.ext.chg.req
  SIGNAL s.ext.chg.ok
  ;
.END
.PROGRAM state11 () ; Put WP[1] to CNC
  ;
  CALL log ("State 11: Put wp[1] to CNC")
  ;
  IF int.change THEN
    IF grip.chg.int[1] THEN
      .gp.chg = 1
    ELSE
      .gp.chg = 2
    END
  END
  IF ext.change THEN
    IF grip.chg.ext[2, 1] THEN
      .gp.chg = 1
    ELSE
      .gp.chg = 2
    END
  END
  ;
  .wp.state = 1
  .grip.no = .gp.chg
  .chuck.no = 1
  ;
  CALL cnc.put (.grip.no, .chuck.no, .wp.state)
  ;
  state = decision.state
  ;
.END
.PROGRAM state12 () ; Pick WP[2] from CNC
  ;
  CALL log ("State 12: Pick wp[2] from CNC")
  ;
  .wp.state = 2
  .grip.no = 2
  IF wp2.pick[1] THEN
    .chuck.no = 1
  ELSE
    .chuck.no = 2
  END
  ;
  CALL cnc.pick (.grip.no, .chuck.no, .wp.state)
  ;
  IF SIG (eo.grip.error[.grip.no]) THEN
    state = 255
  ELSE
    state = decision.state
  END
  ;
.END
.PROGRAM state15 () ; Perform external change
  ; 
  CALL log ("State 15: Perform external change")
  CALL ext.change
  ;
  SIGNAL -s.ext.chg.ok
  state = decision.state
  ;
.END
.PROGRAM state16 () ; Air blow before put WP[0]
  ;
  CALL log ("State 16: CNC chuck air blow before put wp[0]")
  SIGNAL -s.p.put.air.req
  CALL air.blow(1)
  ;
  state = decision.state
  ;
.END
.PROGRAM state17 () ; Air blow after pick WP[2]
  ;
  CALL log ("State 17: CNC chuck air blow after pick wp[2]")
  SIGNAL -s.a.pic.air.req
  CALL air.blow (2)
  ;
  state = decision.state
  ;
  
.END
.PROGRAM state18 () ; MCODE Execute
  ;
  CALL log ("State 18: MCODE Execute")
  ;
  PULSE eo.cnc.mfinish, 1
  ;
  IF cnc.id[1] <> 0 THEN
    .current.chuck = 1
  ELSE
    .current.chuck = 2
  END
  IF wp2.pick[1] THEN
    .new.chuck = 1
  ELSE
    .new.chuck = 2
  END
  IF int.change AND cnc.wp0[1] THEN
    .new.chuck = 2
  END
  IF ext.change AND cnc.wp0[1] THEN
    .new.chuck = 1
  END
  ;
  IF decision.state == 101 OR decision.state == 102 THEN
    IF cnc.state[.current.chuck] == 0 THEN
      cnc.state[.new.chuck] = 2
      IF .current.chuck <> .new.chuck THEN
        cnc.state[.current.chuck] = -1
      END
    END
  ELSE
    .skip.2 = FALSE
    IF cnc.state[.current.chuck] == 0 THEN
      cnc.state[.new.chuck] = 1
      IF .current.chuck <> .new.chuck THEN
        cnc.state[.current.chuck] = -1
      END
      .skip.2 = TRUE
    END
    IF cnc.state[.current.chuck] == 1 AND NOT .skip.2 THEN
      cnc.state[.new.chuck] = 2
      IF .current.chuck <> .new.chuck THEN
        cnc.state[.current.chuck] = -1
      END
    END
  END
  ;
  cnc.id[.new.chuck] = cnc.id[.current.chuck]
  IF .current.chuck <> .new.chuck THEN
    cnc.id[.current.chuck] = 0
  END
  SIGNAL -s.mcode.req
  ;
  state = decision.state
  ;
.END
.PROGRAM state100 () ; Select decision making module state
  ;
  CALL log ("State 100: Select decision making module state")
  ;
  .config = BITS (ei.subspindel, 3)
  CASE .config OF
    VALUE 0:
      decision.state = 101
    VALUE 1:
      IF int.change THEN
        IF wp2.pick[1] THEN
          decision.state = 103
        ELSE
          CALL log ("Impossible configuration!")
          HALT
        END
      ELSE
        IF wp2.pick[1] THEN
          decision.state = 101
        ELSE
          decision.state = 102
        END
      END
    VALUE 2:
      IF int.change THEN
        decision.state = 103
      ELSE
        decision.state = 101
      END
    VALUE 3:
      CALL log ("Impossible configuration!")
      HALT
    VALUE 4:
      IF ext.change THEN
        decision.state = 105
      ELSE
        decision.state = 101
      END
    VALUE 5:
      IF ext.change THEN
        IF wp2.pick[1] THEN
          decision.state = 105
        ELSE
          CALL log ("Impossible configuration!")
          HALT
        END
      ELSE
        IF int.change THEN
          IF wp2.pick[1] THEN
            decision.state = 103
          ELSE
            CALL log ("Impossible configuration!")
            HALT
          END
        ELSE
          IF wp2.pick[1] THEN
            decision.state = 101
          ELSE
            decision.state = 102
          END
        END
      END
    VALUE 6:
      IF ext.change THEN
        decision.state = 105
      ELSE
        IF int.change THEN
          decision.state = 103
        ELSE
          decision.state = 101
        END
      END
  END
  state = decision.state
  RETURN
  ;
.END
.PROGRAM state101 () ; Decision making module 1
  ;
  CALL log ("State 101: Decision making module 1")
;
  WHILE TRUE DO
    CALL calc.state.flag
    ; Open shelf in not opened
    IF shelf.closed THEN
      state = 2
      RETURN
    END
    ;
    ; Send MFINISH
    IF rout AND cnc.full[1] AND mfinish THEN
      state = 18
      RETURN
    END
    ;
    ; Pick workpiece from shelf
    IF rout AND gp.empty[1] AND gp.empty[2] AND n.max.pick THEN
      state = 4
      RETURN
    END
    ;
    ; Move inside CNC
    ;
    IF rout AND (gp.full[1] AND cnc.empty[1] OR gp.empty[2] AND cnc.full[1]) THEN
      state = 7
      RETURN
    END
    ;
    ; Air blow after pick workpiece
    IF rin AND gp.full[2] AND cnc.empty[1] AND air.ap THEN
      state = 17
      RETURN
    END
    ;
    ; Air blow before put workpiece
    IF rin AND gp.full[1] AND cnc.empty[1] AND air.bp THEN
      state = 16
      RETURN
    END
    ;
    ; Put workpiece to CNC
    IF rin AND gp.full[1] AND cnc.empty[1] THEN
      state = 9
      RETURN
    END
    ;
    ; Pick detail from CNC
    IF rin AND gp.empty[2] AND cnc.wp2[1] THEN
      state = 12
      RETURN
    END
    ;;;
    ;
    ; Move outside cnc.in
    IF rin AND (gp.empty[1] AND cnc.full[1] OR gp.full[2] AND cnc.empty[1]) THEN
      state = 8
      RETURN
    END
    ;
    ; Put detail to stocker
    IF rout AND gp.full[2] AND gp.empty[1] THEN
      state = 5
      RETURN
    END
    ;
    ; Close shelf
    .ge = gp.empty[1] AND gp.empty[2]
    .ce = cnc.empty[1]
    IF rout AND .ge AND .ce AND max.pick
      state = 3
      RETURN
    END
  END
  ;
.END
.PROGRAM state102 () ; Decision making module 2
  ;
  CALL log ("State 102: Decision making module 2")
  ;
  WHILE TRUE DO
    ;
    CALL calc.state.flag
    ; Open shelf in not opened
    IF shelf.closed THEN
      state = 2
      RETURN
    END
    ;
    ; Send MFINISH
    IF rout AND cnc.full[1] AND mfinish THEN
      state = 18
      RETURN
    END
    ;
    ; Pick workpiece from shelf
    IF rout AND gp.empty[1] AND gp.empty[2] AND n.max.pick THEN
      state = 4
      RETURN
    END
    ;
    ; Move inside CNC
    IF rout AND (gp.full[1] AND cnc.empty[1] OR gp.empty[2] AND cnc.full[2]) THEN
      state = 7
      RETURN
    END
    ;
    ; Air blow before put workpiece
    IF rin AND gp.full[1] AND cnc.empty[1] AND air.bp THEN
      state = 16
      RETURN
    END
    ;
    ; Put workpiece to CNC
    IF rin AND gp.full[1] AND cnc.empty[1] THEN
      state = 9
      RETURN
    END
    ;
    ; Pick detail from CNC
    IF rin AND gp.empty[2] AND cnc.wp2[2] THEN
      state = 12
      RETURN
    END
    ; Air blow after pick workpiece
    IF rin AND gp.full[2] AND cnc.empty[2] AND air.ap THEN
      state = 17
      RETURN
    END
    ;
    ; Move outside cnc.in
    IF rin AND (gp.empty[1] AND cnc.full[1] OR gp.full[2] AND cnc.empty[2]) THEN
      state = 8
      RETURN
    END
    ;
    ; Put detail to stocker
    IF rout AND gp.full[2] AND gp.empty[1] THEN
      state = 5
      RETURN
    END
    ;
    ; Close shelf
    .ge = gp.empty[1] AND gp.empty[2]
    .ce = cnc.empty[1]
    IF rout AND .ge AND .ce AND max.pick
      state = 3
      RETURN
    END
  END
  ;
.END
.PROGRAM state103 () ; Decision making module 3
  ;
  CALL log ("State 103: Decision making module 3")
  ;
  WHILE TRUE DO
    ;
    CALL calc.state.flag
    ; Open shelf in not opened
    IF shelf.closed THEN
      state = 2
      RETURN
    END
    ;
    ; Send MFINISH
    IF rout AND cnc.full[1] AND mfinish THEN
      state = 18
      RETURN
    END
    ;
    ; Pick workpiece from shelf
    IF rout AND gp.empty[1] AND gp.empty[2] AND cnc.empty[1] AND cnc.empty[2] AND n.max.pick THEN
      state = 4
      RETURN
    END
    ;
    ; Move inside CNC
    IF rout AND (gp.wp0[1] AND cnc.empty[1] OR gp.empty[gp.int] AND cnc.wp1[2] OR gp.empty[2] AND cnc.wp2[1]) THEN
      state = 7
      RETURN
    END
    ;
    ; Air blow before put workpiece
    IF rin AND gp.wp0[1] AND cnc.empty[1] AND air.bp THEN
      state = 16
      RETURN
    END
    ;
    ; Put workpiece to CNC
    IF rin AND gp.wp0[1] AND cnc.empty[1] THEN
      state = 9
      RETURN
    END
    ;
    ; Pick for change
    IF rin AND gp.empty[gp.int] AND cnc.wp1[2] THEN
      state = 10
      RETURN
    END
    ;
    ; Put after change
    IF rin AND gp.wp1[gp.int] AND cnc.empty[1] THEN
      state = 11
      RETURN
    END
    ; Pick detail from CNC
    IF rin AND gp.empty[2] AND cnc.wp2[1] THEN
      state = 12
      RETURN
    END
    ; Air blow after pick workpiece
    IF rin AND gp.wp2[2] AND cnc.empty[1] AND air.ap THEN
      state = 17
      RETURN
    END
    ; 
    ; Move outside cnc.in
    IF rin AND (gp.empty[1] AND cnc.wp0[1] OR gp.wp2[2] AND cnc.empty[1] OR gp.empty[gp.int] AND cnc.wp1[1]) THEN
      state = 8
      RETURN
    END
    ; 
    ; Put detail to stocker
    IF rout AND gp.wp2[2] AND gp.empty[1] THEN
      state = 5
      RETURN
    END
    ;
    ; Close shelf
    .ge = gp.empty[1] AND gp.empty[2]
    .ce = cnc.empty[1]
    IF rout AND .ge AND .ce AND max.pick
      state = 3
      RETURN
    END
  END
  ;
.END
.PROGRAM state105 () ; Decision making module 5
  ;
  CALL log ("State 105: Decision making module 5")
  ;
  WHILE TRUE DO
    ;
    CALL calc.state.flag
    ; Open shelf in not opened
    IF shelf.closed THEN
      state = 2
      RETURN
    END
    ;
    ; Send MFINISH
    IF rout AND cnc.full[1] AND mfinish THEN
      state = 18
      RETURN
    END
    ;
    ; Pick workpiece from shelf
    IF rout AND gp.empty[1] AND gp.empty[2] AND cnc.empty[1] AND cnc.empty[2] AND n.max.pick  THEN
      state = 4
      RETURN
    END
    ;
    ; Move inside CNC
    IF rout AND (gp.wp0[1] AND cnc.empty[1] OR gp.empty[gp.ext.1] AND cnc.wp1[1] OR  gp.empty[2] AND cnc.wp2[1] ) THEN
      state = 7
      RETURN
    END
    ;
    ; Air blow before put workpiece
    IF rin AND gp.wp0[1] AND cnc.empty[1] AND air.bp THEN
      state = 16
      RETURN
    END
    ;
    ; Put workpiece to CNC
    IF rin AND gp.wp0[1] AND cnc.empty[1] THEN
      state = 9
      RETURN
    END
    ;
    ; Pick for change
    IF rin AND gp.empty[gp.ext.1] AND cnc.wp1[1] AND NOT SIG(s.ext.chg.req) THEN
      state = 10
      RETURN
    END
    ;
    ; Perform change
    IF rin AND gp.wp1[gp.ext.1] AND cnc.empty[1] AND SIG(s.ext.chg.req) AND SIG(s.ext.chg.ok) THEN
      state = 15
      RETURN
    END
    ;
    ; Put after change
    IF rin AND gp.wp1[gp.ext.2] AND cnc.empty[1]  THEN
      state = 11
      RETURN
    END
    ; Pick detail from CNC
    IF rin AND gp.empty[2] AND cnc.wp2[1] THEN
      state = 12
      RETURN
    END
    ; Air blow after pick workpiece
    IF rin AND gp.wp2[2] AND cnc.empty[1] AND air.ap THEN
      state = 17
      RETURN
    END
    ;  ;
    ;  ; Move outside cnc.in
    IF rin AND (gp.empty[1] AND cnc.wp0[1] OR gp.empty[gp.ext.2] AND cnc.wp1[1] OR gp.wp2[2] AND cnc.empty[1]) THEN
      state = 8
      RETURN
    END
    ;  ;
    ; Put detail to stocker
    IF rout AND gp.wp2[2] AND gp.empty[1] THEN
      state = 5
      RETURN
    END
    ;
    ; Close shelf
    .ge = gp.empty[1] AND gp.empty[2]
    .ce = cnc.empty[1]
    IF rout AND .ge AND .ce AND max.pick
      state = 3
      RETURN
    END
  END
  ;
.END
.PROGRAM state255 () ; Task finished
  ;
  CALL log("State 255: Task complete")
  ;
  SIGNAL -eo.task.exec
  ;
  state = 0 
  RETURN
  ;
.END
.PROGRAM cnc.put (.grip.no,.chuck.no,.wp.state)
  ;
  .$temp = "Put workpiece in CNC. Tool:" + $ENCODE (.grip.no)
  .$temp = .$temp + " Chuck:" + $ENCODE (.chuck.no)
  .$temp = .$temp + "L:" + $ENCODE(wp.length[.wp.state])
  CALL log (.$temp)
  ;
  SPEED 100 ALWAYS
  ACCURACY 50 ALWAYS
  CALL set.tool (.grip.no)
  CALL calc.rotation (.grip.no, .chuck.no)
  CALL chuck.open (.chuck.no, 0)
  ;
  ; Calculate shifts
  .c1 = wp.length[.wp.state] + grip.jaw.body[.grip.no] + cnc.jaw.body[.chuck.no]
  .dz = .c1 - overshoot ;
  .c2 = cnc.jaw.full[.chuck.no] - cnc.jaw.body[.chuck.no]
  .z.appro = .c2 + overshoot + 10
  ;
  ; Calculate points
  POINT .temp = cnc.point[.grip.no, .chuck.no]
  POINT .x.put = .temp + TRANS (0, 0, -.dz)
  ;
  ; Approach
  JMOVE #cnc.in
  ACCURACY 0.1
  LAPPRO .x.put, .z.appro
  BREAK
  ;
  SPEED search.speed MM/S
  XMOVE .x.put TILL grip.sensor[.grip.no]
  BREAK
  TWAIT 0.1
  ;
  IF cnc.first THEN
    CALL log ("CNC close chuck first")
    CALL chuck.close (.chuck.no, tmr.cnc.cl[.chuck.no])
    CALL grip.open (.grip.no, tmr.grip.op[.grip.no], grip.inverse[.grip.no])
  ELSE
    CALL log ("Robot open chuck first")
    CALL grip.open (.grip.no, tmr.grip.op[.grip.no], grip.inverse[.grip.no])
    CALL chuck.close (.chuck.no, tmr.cnc.cl[.chuck.no])
  END
  ;
  SIGNAL s.mcode.req
  cnc.id[.chuck.no] = gripper.id[.grip.no]
  cnc.state[.chuck.no] = gripper.state[.grip.no]
  gripper.id[.grip.no] = 0
  gripper.state[.grip.no] = -1
  ;
  SPEED 20
  ACCURACY 0.1
  LAPPRO .x.put, .z.appro
  BREAK
  LMOVE #cnc.in
  CALL grip.close (.grip.no, 0, grip.inverse[.grip.no])
  ;
.END
.PROGRAM cnc.pick (.grip.no,.chuck.no,.wp.state)
  ;
  ;
  .$temp = "Pick workpiece from CNC. Tool:" + $ENCODE (.grip.no)
  .$temp = .$temp + " Chuck:" + $ENCODE (.chuck.no)
  .$temp = .$temp + "L:" + $ENCODE(wp.length[.wp.state])
  CALL log (.$temp)
  ;
  SPEED 100 ALWAYS
  ACCURACY 50 ALWAYS
  CALL set.tool (.grip.no)
  CALL calc.rotation (.grip.no, .chuck.no)
  ; gripper.no, time, reverse
  CALL grip.open (.grip.no, 0, grip.inverse[.grip.no])
  ;
  ; Calculate shifts
  .c1 = wp.length[.wp.state] + grip.jaw.body[.grip.no] + cnc.jaw.body[.chuck.no]
  .dz = .c1 - overshoot ;
  .c2 = grip.jaw.full[.grip.no] - grip.jaw.body[.grip.no]
  ;.c3 = grip.jaws.full[.tool.no] - grip.jaws.body[.tool.no]
  .z.appro = .c2 + overshoot + 10
  ;.z.appro.pick = grip.jaws.body[.tool.no]
  ;
  ; Calculate points
  POINT .temp = cnc.point[.grip.no, .chuck.no]
  POINT .x.pick = .temp + TRANS (0, 0, -.dz)
  ;
  ; Approach
  JMOVE #cnc.in
  ACCURACY 0.1
  LAPPRO .x.pick, .z.appro
  BREAK
  ; Check if gripper is opened
  ;CALL gripper.is.open (.grip.no, st6.reverse)
  ;IF SIG (eo.gp.error[.grip.no]) THEN
  ;   Return home if not. Error
  ;  LMOVE #cnc.in
  ;  LMOVE #cnc.out
  ;  JMOVE #homyak
  ;  RETURN
  ;END
  ;
  SPEED search.speed MM/S
  XMOVE .x.pick TILL grip.sensor[.grip.no]
  BREAK
  TWAIT 0.1
  CALL grip.close (.grip.no, tmr.grip.cl[.grip.no], grip.inverse[.grip.no])
  CALL chuck.open (.chuck.no, tmr.cnc.op[.chuck.no])
  ;
  gripper.id[.grip.no] = cnc.id[.chuck.no]
  gripper.state[.grip.no] = cnc.state[.chuck.no]
  cnc.id[.chuck.no] = 0
  cnc.state[.chuck.no] = -1
  ;
  SPEED 20
  ACCURACY 0.1
  LAPPRO .x.pick, cnc.jaw.full[.grip.no] + 10
  BREAK
  LMOVE #cnc.in
  ;
.END
.PROGRAM cnc.test.pick ()
  ;
  IF SIG (s.hmi.grip[1]) THEN
    .grip.no = 1
  ELSE
    .grip.no = 2
  END
  ;
  IF SIG (s.cnc.chuck[1]) THEN
    .chuck.no = 1
  ELSE
    .chuck.no = 2
  END
  ;
  CALL get.task.data
  CALL cnc.pick (.grip.no, .chuck.no, 0)
  ;
.END
.PROGRAM cnc.test.put ()
  ;
  IF SIG (s.hmi.grip[1]) THEN
    .grip.no = 1
  ELSE
    .grip.no = 2
  END
  ;
  IF SIG (s.cnc.chuck[1]) THEN
    .chuck.no = 1
  ELSE
    .chuck.no = 2
  END
  ;
  CALL get.task.data
  CALL cnc.put (.grip.no, .chuck.no, 0)
  ;
.END
.PROGRAM cnc.teach ()
  ;
  IF SIG (s.hmi.grip[1]) THEN
    .grip.no = 1
  ELSE
    .grip.no = 2
  END
  ;
  IF SIG (s.cnc.chuck[1]) THEN
    .chuck.no = 1
  ELSE
    .chuck.no = 2
  END
  ;
  .gc.full = hmi.grip.j.full[.grip.no]
  .gc.body = hmi.grip.j.body[.grip.no]
  .cncc.full = hmi.cnc.j.full[.chuck.no]
  .cncc.body = hmi.cnc.j.body[.chuck.no]
  ;
  CALL set.tool (.grip.no)
  CALL calc.rotation (.grip.no, .chuck.no)
  ;
  LMOVE #cnc.in
  ;
  LAPPRO #cnc.point[.grip.no, .chuck.no], 50
  ; Teach this point 
  BREAK
  LMOVE #cnc.point[.grip.no, .chuck.no]  ; **== TEACH POINT ==**
  LAPPRO #cnc.point[.grip.no, .chuck.no], 50
  ;
  POINT .temp = #cnc.point[.grip.no, .chuck.no]
  .zshift = .gc.body + .cncc.body + hmi.wp.length
  POINT cnc.point[.grip.no, .chuck.no] = .temp + TRANS (, , .zshift)
  ;
  POINT .temp = cnc.point[.grip.no, .chuck.no] + TRANS (, , -.zshift)
  LAPPRO .temp, 50
  LMOVE .temp
  LAPPRO .temp, 50
  ;
.END
.PROGRAM calc.rotation (.grip.no,.chuck.no)
  ;
  .j6 = cnc.rotations[.grip.no, .chuck.no]
  DECOMPOSE .j[1] = #cnc.out.base
  POINT #cnc.out = #PPOINT (.j[1], .j[2], .j[3], .j[4], .j[5], .j[6] + .j6)
  DECOMPOSE .j[1] = #cnc.in.base
  POINT #cnc.in = #PPOINT (.j[1], .j[2], .j[3], .j[4], .j[5], .j[6] + .j6)
  ;
  ;
.END
.PROGRAM cnc.appro.teach ()
  ;
  JMOVE #cnc.out.base ; **== TEACH POINT ==**
  ;
  LMOVE #cnc.in.base ; **== TEACH POINT ==**
  LMOVE #cnc.out.base
  ;
.END
.PROGRAM cnc.move.out (.grip.no,.chuck.no)
  ;
  .$temp = "Move outside CNC. Tool:" + $ENCODE (.grip.no)
  .$temp = .$temp + " Chuck:" + $ENCODE (.chuck.no)
  CALL log(.$temp)
  ;
  SPEED 100 ALWAYS
  ACCURACY 50 ALWAYS
  CALL set.tool (.grip.no)
  CALL calc.rotation(.grip.no, .chuck.no)
  ;
  JMOVE #cnc.in
  LMOVE #cnc.out
  BREAK
  $safe.flag = "cnc.out"
  CALL log("Robot outside CNC")
  SIGNAL -s.inside.cnc
  ;
.END
.PROGRAM cnc.move.in (.grip.no,.chuck.no)
  ;
  .$temp = "Move inisde CNC. Tool:" + $ENCODE (.grip.no)
  .$temp = .$temp + " Chuck:" + $ENCODE (.chuck.no)
  CALL log (.$temp)
  ;
  SPEED 100 ALWAYS
  ACCURACY 50 ALWAYS
  CALL set.tool (.grip.no)
  CALL calc.rotation (.grip.no, .chuck.no)
  ;
  $safe.flag = "cnc.out"
  HOME
  JMOVE #cnc.out
  BREAK
  $safe.flag = "cnc.out"
  ;
  CALL log ("Waiting for CNC ready")
  SWAIT ei.cnc.ready
  CALL log ("CNC ready signal received")
  ;
  LMOVE #cnc.in
  BREAK
  $safe.flag = "cnc.in"
  CALL log ("Robot inside CNC")
  SIGNAL s.inside.cnc
  ;
.END
.PROGRAM chuck.open (.chuck.no,.time)
  ;
  CALL log ("Open CNC chuck" + $ENCODE (.chuck.no))
  IF SIG (ei.cnc.ch.opd[.chuck.no]) THEN
    CALL log ("CNC chuck" + $ENCODE (.chuck.no) + " already opened")
    RETURN
  END
  ;
  SIGNAL eo.cnc.ch.open[.chuck.no]
  SWAIT ei.cnc.ch.opd[.chuck.no]
  CALL log ("CNC chuck" + $ENCODE (.chuck.no) + " opened")
  TWAIT .time
  SIGNAL -eo.cnc.ch.open[.chuck.no]
  ;
.END
.PROGRAM chuck.close (.chuck.no,.time)
  ;
  CALL log ("Close CNC chuck" + $ENCODE (.chuck.no))
  SIGNAL eo.cnc.ch.close[.chuck.no]
  SWAIT ei.cnc.ch.clsd[.chuck.no]
  CALL log ("CNC chuck" + $ENCODE (.chuck.no) + " closed")
  TWAIT .time
  SIGNAL -eo.cnc.ch.close[.chuck.no]
  ;
.END
.PROGRAM safe.home ()
  ;
  ;
  CALL grip.close (1, 0, grip.inverse[1])
  CALL grip.close (2, 0, grip.inverse[2])
  ;
  IF SIG (do.home) THEN
    CALL log ("Move robot from HOME to HOME STANDBY")
    HOME2
    $safe.flag = " "
    RETURN
  END
  ;
  IF SIG (do.home2) THEN
    CALL log ("Robot is already at home. Skip safe.home program")
    $safe.flag = " "
    RETURN
  END
  ;
  CALL log ("Performing safe movement to home position")
  SPEED 100 MM/S ALWAYS
  ACCURACY 0.01 ALWAYS
  ;
  SCASE $safe.flag OF
    SVALUE "shelf.work":
      CALL log ("Safe move from shelf")
      CALL set.tool (3)
      TDRAW -40, 0, 0
      TDRAW 0, 0, -60
      TDRAW 250, 0, 0
      JMOVE #shelf.safe
    SVALUE "shelf.safe":
      CALL log ("Safe move from shelf")
      CALL set.tool (3)
      JMOVE #shelf.safe
    SVALUE "wp.safe":
      CALL log ("Safe move from shelf")
      TDRAW 0, 0, -10
      JMOVE #wp.safe[1]
    SVALUE "cnc.out":
      CALL log ("Safe move from CNC")
      LMOVE #cnc.out
    SVALUE "cnc.in":
      CALL log ("Safe move from CNC")
      TDRAW 0, 0, -40
      LMOVE #cnc.in
      LMOVE #cnc.out
  END
  ;
  HOME
  HOME2
  $safe.flag = ""
  BREAK
  CALL log ("Robot in home position")
  ;
  SIGNAL -s.inside.cnc
  ;
.END
.PROGRAM chg.pg.1 ()
  ;
  FOR .i = 1 TO 5
    DRIVE 6, 90
    DRIVE 6, -90
  END
  ;
.END
.PROGRAM ext.change ()
  ;
  BREAK
  HERE #state.bf.chg
  ;
  .chg.pg = chg.pg.no
  .$pg.string = "chg.pg." + $ENCODE (/L, .chg.pg)
  IF EXISTPGM (.$pg.string) THEN
    CALL log ("Use changer program " +.$pg.string)
    SCALL .$pg.string
  ELSE
    CALL log ("No changer program found!!!")
    HALT
  END
  ;
  IF grip.chg.ext[1, 1] THEN
    .grip.before.chg = 1
  ELSE
    .grip.before.chg = 2
  END
  ;
  IF grip.chg.ext[2, 1] THEN
    .grip.after.chg = 1
  ELSE
    .grip.after.chg = 2
  END
  ;
  gripper.id[.grip.after.chg] = gripper.id[.grip.before.chg]
  IF .grip.after.chg <> .grip.before.chg THEN
    gripper.id[.grip.before.chg] = 0
  END
  ;
  gripper.state[.grip.after.chg] = gripper.state[.grip.before.chg] 
  IF .grip.after.chg <> .grip.before.chg THEN
    gripper.state[.grip.before.chg] = -1
  END
  ;
  JMOVE #state.bf.chg
  ;
.END
.PROGRAM chg.pg.2 ()
  ;
  ;
.END
.PROGRAM air.pg.1 ()
  ;
  TWAIT 5
  ;
.END
.PROGRAM air.blow (.air)
  ;
  BREAK
  HERE #state.bf.air
  ;
  .air.pg = air.pg.no[.air]
  .$pg.string = "air.pg." + $ENCODE (/L, .air.pg)
  IF EXISTPGM (.$pg.string) THEN
    CALL log ("Use air blow program " +.$pg.string)
    SIGNAL air.blow.on, -air.blow.off, eo.air.enabled
    SCALL .$pg.string
  ELSE
    CALL log ("No air blow program found, skip")
  END
  ;
  JMOVE #state.bf.air
  SIGNAL -air.blow.on, air.blow.off, -eo.air.enabled
  ;
.END
.PROGRAM air.pg.3 ()
  ;
  TWAIT 5
  ;
.END
.PROGRAM wp.pick (.shelf.no,.grip.no,.wp.id)
  ;
  .$temp = "Pick workpiece. Shelf: " + $ENCODE (.shelf.no)
  .$temp = .$temp + " Tool: " + $ENCODE (.grip.no)
  .$temp = .$temp + " ID: " + $ENCODE (.wp.id)
  .$temp = .$temp + "L: " + $ENCODE (wp.length[0])
  CALL log (.$temp)
  ;
  SPEED 100 ALWAYS
  ACCURACY 50 ALWAYS
  CALL set.tool (.grip.no)
  ; gripper.no, time, reverse
  CALL grip.open (.grip.no, 0, grip.inverse[.grip.no])
  ;
  CALL id.to.ij (.wp.id, .i, .j)
  SIGNAL -s.search.fail
  ;
  IF SIG (ei.skp.emp.cell) THEN
    .epsilon = pick.epsilon
  ELSE
    .epsilon = -1
  END
  ;
  ; Calculate shifts
  .dx = plt.dx * .i + plt.ox
  IF .i MOD 2 == 0
    .dy = plt.dy * (plt.cell.odd -1 - .j) + plt.oy
  ELSE
    .dy = plt.dy * (plt.cell.even - 1 - .j) + plt.even.dy + plt.oy
  END
  .dz = wp.length[0] + grip.jaw.body[.grip.no] - overshoot ;
  .z.appro = grip.jaw.full[.grip.no] - grip.jaw.body[.grip.no] + overshoot + 10
  ;
  ; Calculate points
  POINT .temp = shelf.frame[.shelf.no, .grip.no]
  POINT .x.pick = .temp + TRANS (.dx, .dy, -.dz)
  ; Calculate approach point
  POINT .approach = #wp.safe[.grip.no]
  .x = DX (.x.pick)
  .y = DY (.x.pick)
  .z = DZ (.approach)
  POINT/Z .approach = TRANS (0, 0, .z - 180 * (.shelf.no - 1))
  POINT .#approach = .approach, #wp.safe[.grip.no]
  POINT .post.pick = .approach
  POINT/X .post.pick = TRANS (.x)
  POINT/Y .post.pick = TRANS (0, .y)
  ; Approach
  IF INRANGE (.#approach) == 0 THEN
    JMOVE .#approach
  ELSE
    JMOVE #wp.safe[.grip.no]
  END
  $safe.flag = "wp.safe"
  ;
  ACCURACY 0.1
  LAPPRO .x.pick, .z.appro
  BREAK
  ;
  SPEED search.speed MM/S
  XMOVE .x.pick TILL grip.sensor[.grip.no]
  BREAK
  TWAIT 0.1
  HERE .current
  ;
  .d = DISTANCE (.current, .x.pick)
  CALL log ("Distance:" + $ENCODE (.d))
  IF DISTANCE (.current, .x.pick) <= .epsilon THEN
    CALL log ("Detail search failed, move to the next pick")
    SIGNAL s.search.fail
  ELSE
    CALL log ("Detail found")
    CALL grip.close (.grip.no, tmr.grip.cl[.grip.no], grip.inverse[.grip.no])
    gripper.id[.grip.no] = .wp.id
    gripper.state[.grip.no] = 0
  END
  ;
  SPEED 20
  ACCURACY 0.1
  LAPPRO .x.pick, .z.appro
  ;
  IF INRANGE (.post.pick) == 0 THEN
    LMOVE .post.pick
  END
  ;
  BREAK
  IF INRANGE (.#approach) == 0 THEN
    LMOVE .#approach
  ELSE
    LMOVE #wp.safe[.grip.no]
  END
  ;
.END
.PROGRAM wp.put (.shelf.no,.grip.no,.wp.id)
  ;
  .$temp = "Put workpiece. Shelf: " + $ENCODE (.shelf.no)
  .$temp = .$temp + " Tool: " + $ENCODE (.grip.no)
  .$temp = .$temp + " ID: " + $ENCODE (.wp.id)
  .$temp = .$temp + "L: " + $ENCODE(wp.length[2])
  CALL log (.$temp)
  ;
  SPEED 100 ALWAYS
  ACCURACY 50 ALWAYS
  CALL set.tool (.grip.no)
  ;
  CALL id.to.ij (.wp.id, .i, .j)
  ;
  ; Calculate shifts
  .dx = plt.dx * .i + plt.ox
  IF .i MOD 2 == 0
    .dy = plt.dy * (plt.cell.odd -1 - .j) + plt.oy
  ELSE
    .dy = plt.dy * (plt.cell.even - 1 - .j) + plt.even.dy + plt.oy
  END
  .dz = wp.length[2] + grip.jaw.body[.grip.no] - overshoot ;
  .z.appro = grip.jaw.full[.grip.no] - grip.jaw.body[.grip.no] + overshoot + 10
  ;
  ; Calculate points
  POINT .temp = shelf.frame[.shelf.no, .grip.no]
  POINT .x.put = .temp + TRANS (.dx, .dy, -.dz)
  ; Calculate approach point
  POINT .approach = #wp.safe[.grip.no]
  .x = DX (.x.put)
  .y = DY (.x.put)
  .z = DZ (.approach)
  ;POINT/X .approach = TRANS (.x)
  ;POINT/Y .approach = TRANS (0, .y)
  POINT/Z .approach = TRANS (0, 0, .z - 180 * (.shelf.no - 1))
  POINT .#approach = .approach, #wp.safe[.grip.no]
  ; Approach
  IF INRANGE (.#approach) == 0 THEN
    JMOVE .#approach
  ELSE
    JMOVE #wp.safe[.grip.no]
  END
  $safe.flag = "wp.safe"
  ;
  ACCURACY 0.1
  LAPPRO .x.put, .z.appro
  BREAK
  ;
  SPEED search.speed MM/S
  XMOVE .x.put TILL grip.sensor[.grip.no]
  BREAK
  TWAIT 0.1
  CALL grip.open (.grip.no, tmr.grip.op[.grip.no], grip.inverse[.grip.no])
  ;
  gripper.id[.grip.no] = 0
  gripper.state[.grip.no] = -1
  processed.wp = processed.wp + 1
  ;
  SPEED 20
  ACCURACY 0.1
  LAPPRO .x.put, .z.appro
  BREAK
  IF INRANGE (.#approach) == 0 THEN
    LMOVE .#approach
  ELSE
    LMOVE #wp.safe[.grip.no]
  END
  CALL grip.close (.grip.no, 0, grip.inverse[.grip.no])
  ;
.END
.PROGRAM wp.test.pick ()
  ;
  IF SIG (s.hmi.grip[1]) THEN
    .grip.no = 1
  ELSE
    .grip.no = 2
  END
  ;
  CALL get.task.data
  CALL wp.pick (hmi.shelf.no, .grip.no, hmi.wp.id)
  ;
.END
.PROGRAM wp.test.put ()
  ;
  IF SIG (s.hmi.grip[1]) THEN
    .grip.no = 1
  ELSE
    .grip.no = 2
  END
  ;
  CALL get.task.data
  CALL wp.put(hmi.shelf.no, .grip.no, hmi.wp.id)
  ;
.END
.PROGRAM grip.open (.grip.no,.time,.reverse)
  ;
  IF SIG(ei.check.grip[.grip.no]) AND SIG(grip.opened[.grip.no]) THEN
    CALL log("Gripper" + $ENCODE(.grip.no) + "already opened")
    RETURN
  END
  IF NOT .reverse THEN
    SIGNAL grip.open[.grip.no], -grip.close[.grip.no]
  ELSE
    SIGNAL grip.close[.grip.no], -grip.open[.grip.no]
  END
  TWAIT .time
  ;
  CALL log("Command open gripper" + $ENCODE(.grip.no))
  ;
.END
.PROGRAM grip.close (.grip.no,.time,.reverse)
  ;
  IF NOT .reverse THEN
    SIGNAL grip.close[.grip.no], -grip.open[.grip.no]
  ELSE
    SIGNAL grip.open[.grip.no], -grip.close[.grip.no]
  END
  TWAIT .time
  ;
  CALL log("Command close gripper" + $ENCODE(.grip.no))
  ;
.END
.PROGRAM plate.teach ()
  ;
  ; Preparations for teaching
  ; Set tool
  IF SIG (s.hmi.grip[1]) THEN
    .grip.no = 1
  ELSE
    .grip.no = 2
  END
  TOOL tool.calib[.grip.no]
  ;
  BREAK
  JMOVE #wp.safe[.grip.no] ; **== TEACH POINT ==**
  ;
  LAPPRO #plate.pt.o[hmi.shelf.no, .grip.no], 20
  BREAK
  ; Teach this point for origin
  BREAK
  LMOVE #plate.pt.o[hmi.shelf.no, .grip.no] ; **== TEACH POINT ==**
  LAPPRO #plate.pt.o[hmi.shelf.no, .grip.no], 20
  ;
  LAPPRO #plate.pt.x[hmi.shelf.no, .grip.no], 20
  BREAK
  ; Teach this point for x direction
  BREAK
  LMOVE #plate.pt.x[hmi.shelf.no, .grip.no] ; **== TEACH POINT ==**
  LAPPRO #plate.pt.x[hmi.shelf.no, .grip.no], 20
  ;
  BREAK
  ; Teach this point for y direction
  LAPPRO #plate.pt.y[hmi.shelf.no, .grip.no], 20
  BREAK
  LMOVE #plate.pt.y[hmi.shelf.no, .grip.no] ; **== TEACH POINT ==**
  LAPPRO #plate.pt.y[hmi.shelf.no, .grip.no], 20
  ;
  ; Calculation
  POINT .po = #plate.pt.o[hmi.shelf.no, .grip.no]
  POINT .px = #plate.pt.x[hmi.shelf.no, .grip.no]
  POINT .py = #plate.pt.y[hmi.shelf.no, .grip.no]
  POINT .f = FRAME (.po, .px, .py, .po)
  POINT .f = .f + TRANS (-80, 0, 0)
  POINT shelf.frame[hmi.shelf.no, .grip.no] = .f
  ;
  JMOVE #wp.safe[.grip.no]
  ;
.END
.PROGRAM plate.test ()
  ;
  ; Preparations for testing
  ; Set tool
  IF SIG (s.hmi.grip[1]) THEN
    .grip.no = 1
  ELSE
    .grip.no = 2
  END
  TOOL tool.calib[.grip.no]
  ;
  JMOVE #wp.safe[.grip.no]
  ;
  LAPPRO shelf.frame[hmi.shelf.no, .grip.no] + TRANS(80, 0, 0), 20
  LMOVE shelf.frame[hmi.shelf.no, .grip.no] + TRANS(80, 0, 0)
  LAPPRO shelf.frame[hmi.shelf.no, .grip.no] + TRANS(80, 0, 0), 20
  ;
  LAPPRO shelf.frame[hmi.shelf.no, .grip.no] + TRANS(390+80, 0, 0), 20
  LMOVE shelf.frame[hmi.shelf.no, .grip.no] + TRANS(390+80, 0, 0)
  LAPPRO shelf.frame[hmi.shelf.no, .grip.no] + TRANS(390+80, 0, 0), 20
  ;
  LAPPRO shelf.frame[hmi.shelf.no, .grip.no] + TRANS(80, 630, 0), 20
  LMOVE shelf.frame[hmi.shelf.no, .grip.no] + TRANS(80, 630, 0)
  LAPPRO shelf.frame[hmi.shelf.no, .grip.no] + TRANS(80, 630, 0), 20
  ;
  LAPPRO shelf.frame[hmi.shelf.no, .grip.no] + TRANS(390+80, 630, 0), 20
  LMOVE shelf.frame[hmi.shelf.no, .grip.no] + TRANS(390+80, 630, 0)
  LAPPRO shelf.frame[hmi.shelf.no, .grip.no] + TRANS(390+80, 630, 0), 20
  ;
  JMOVE #wp.safe[.grip.no]
  ;
.END
.PROGRAM shelf.teach ()
  ;
  ; Preaprations for teaching
  TOOL tool.pin
  SIGNAL grip.close[1], -grip.open[1]
  SIGNAL grip.close[2], -grip.open[2]
  JMOVE #shelf.safe
  ;
  ; Teach points for open shelf
  LMOVE shelf.open[hmi.shelf.no, 1] + TRANS (-50, 0, -150)
  LMOVE shelf.open[hmi.shelf.no, 1] + TRANS (-50, 0, 0)
  ; Teach this point for shelf open
  BREAK
  LMOVE shelf.open[hmi.shelf.no, 1] ; **== TEACH POINT ==**
  ; Teach this point for shelf close
  BREAK
  LMOVE shelf.close[hmi.shelf.no, 2] ; **== TEACH POINT ==**
  ;
  LMOVE shelf.open[hmi.shelf.no, 1] + TRANS (-50, 0, 0)
  LMOVE shelf.open[hmi.shelf.no, 1] + TRANS (-50, 0, -150)
  JMOVE #shelf.safe
  ;
  ; Teach points for close shelf
  LMOVE shelf.close[hmi.shelf.no, 1] + TRANS (150, 0, -150)
  LMOVE shelf.close[hmi.shelf.no, 1] + TRANS (-50, 0, -150)
  LMOVE shelf.close[hmi.shelf.no, 1] + TRANS (-50, 0, 0)
  ; Teach this point for shelf close
  BREAK
  LMOVE shelf.close[hmi.shelf.no, 1] ; **== TEACH POINT ==**
  ; Teach this point for shelf open
  BREAK
  LMOVE shelf.open[hmi.shelf.no, 2] ; **== TEACH POINT ==**
  ;
  LMOVE shelf.close[hmi.shelf.no, 1] + TRANS (-50, 0, 0)
  LMOVE shelf.close[hmi.shelf.no, 1] + TRANS (-50, 0, -150)
  LMOVE shelf.close[hmi.shelf.no, 1] + TRANS (150, 0, -150)
  JMOVE #shelf.safe
  ;
.END
.PROGRAM shelf.test ()
  ;
  CALL shelf.open (hmi.shelf.no)
  CALL shelf.close (hmi.shelf.no)
  ;
.END
.PROGRAM shelf.open (.shelf.no)
  ;
  CALL log ("Open shelf" + $ENCODE (.shelf.no))
  ;
  SPEED 60 ALWAYS
  ACCURACY 5 ALWAYS
  CALL set.tool (3)
  ; gripper.no, time, reverse
  CALL grip.close (1, 0, FALSE)
  CALL grip.close (2, 0, FALSE)
  ;
  POINT .start = shelf.open[.shelf.no, 1]
  POINT .end = shelf.open[.shelf.no, 2]
  ;
  JMOVE #shelf.safe
  BREAK
  $safe.flag = "shelf.safe"
  ;
  LMOVE .start + TRANS (-50, 0, -150)
  LMOVE .start + TRANS (-50, 0, 0)
  $safe.flag = "shelf.work"
  SPEED 50 MM/S
  ACCURACY 0.1
  LMOVE .start
  BREAK
  ; Unlock shelf
  CALL log ("Request unlock shelf" + $ENCODE (.shelf.no))
  SIGNAL eo.shelf.unlock[.shelf.no]
  WAIT BITS (ei.shelf.state[1], 5) <> 0
  ;
  IF NOT SIG (ei.shelf.failed) THEN
    ;
    CALL log ("Shelf" + $ENCODE (.shelf.no) +" successfully unlocked")
    ;
    SPEED 200 MM/S
    ACCURACY 0.1
    LMOVE .end
    BREAK
    ;
    SPEED 50 MM/S
    ACCURACY 0.1
    LMOVE .end + TRANS (-50, 0, 0)
    BREAK
    ;
    SIGNAL -eo.shelf.unlock[.shelf.no]
    SIGNAL eo.shelf.opened[.shelf.no]
    ;
    ACCURACY 0.1
    LMOVE .end + TRANS (-50, 0, -50)
    LMOVE .end + TRANS (150, 0, -50)
    ;
    LMOVE #shelf.safe
    $safe.flag = "shelf.safe"
    BREAK
    ;
    RETURN
  ELSE
    CALL log ("Failed to unlock shelf" + $ENCODE (.shelf.no) +". Task will be stopped")
    SIGNAL s.shelf.failed
    SIGNAL -eo.shelf.unlock[.shelf.no]
    ACCURACY 0.1
    LMOVE .start + TRANS (-50, 0, 0)
    ACCURACY 0.1
    LMOVE .start + TRANS (-50, 0, -150)
    JMOVE #shelf.safe
    $safe.flag = "shelf.safe"
    BREAK
    HOME
    HOME2
  END
.END
.PROGRAM shelf.close (.shelf.no)
  ;
  CALL log ("Closing shelf" + $ENCODE (.shelf.no))
  ;
  SPEED 60 ALWAYS
  ACCURACY 5 ALWAYS
  CALL set.tool (3)
  CALL grip.close (1, 0, FALSE)
  CALL grip.close (2, 0, FALSE)
  ;
  POINT .start = shelf.close[.shelf.no, 1]
  POINT .end = shelf.close[.shelf.no, 2]
  ;
  JMOVE #shelf.safe
  BREAK
  $safe.flag = "shelf.safe"
  ;
  LMOVE .start + TRANS (150, 0, -50)
  LMOVE .start + TRANS (-50, 0, -50)
  $safe.flag = "shelf.work"
  LMOVE .start + TRANS (-50, 0, 0)
  SPEED 50 MM/S
  ACCURACY 0.1
  LMOVE .start
  BREAK
  ; Open shelf
  CALL log ("Request unlock shelf" + $ENCODE (.shelf.no))
  SIGNAL eo.shelf.unlock[.shelf.no]
  WAIT BITS (ei.shelf.state[1], 5) <> 0
  ;
  IF NOT SIG (ei.shelf.failed) THEN
    ;
    CALL log ("Shelf" + $ENCODE (.shelf.no) +" successfully unlocked")
    ;
    SPEED 200 MM/S
    ACCURACY 0.1
    LMOVE .end
    BREAK
    ;
    SPEED 50 MM/S
    ACCURACY 0.1
    LMOVE .end + TRANS (-50, 0, 0)
    BREAK
    ;
    SIGNAL -eo.shelf.unlock[.shelf.no]
    SIGNAL -eo.shelf.opened[.shelf.no]
    ;
    ACCURACY 0.1
    LMOVE .end + TRANS (-50, 0, -150)
    ;
    LMOVE #shelf.safe
    BREAK
    ;
    RETURN
  ELSE
    CALL log ("Failed to unlock shelf" + $ENCODE (.shelf.no) +". Task will be stopped")
    SIGNAL s.shelf.failed
    SIGNAL -eo.shelf.unlock[.shelf.no]
    ACCURACY 0.1
    LMOVE .start + TRANS (-50, 0, 0)
    ACCURACY 0.1
    LMOVE .start + TRANS (-50, 0, -50)
    LMOVE .start + TRANS (150, 0, -50)
    JMOVE #shelf.safe
    $safe.flag = "shelf.safe"
    BREAK
    HOME
    HOME2
  END
  ;
.END
.PROGRAM a.transport ()
  ;
  ; Set small speed
  SPEED 100 MM/S ALWAYS
  ACCURACY 0.01 ALWAYS
  ; Move to home and home standby pos
  JMOVE #transport 
  ;
.END
.PROGRAM set.tool (.grip.no)
  ;
  IF .grip.no <> 3 THEN
    TOOL tool.gripper[.grip.no]
  ELSE
    TOOL tool.pin
  END
  ;
  WEIGHT 20, 0, 0, 100, 0.1, 0.1, 0.1
  current.grip = .grip.no
  ;
  CALL log ("Tool " + $ENCODE (/L, .grip.no)+ " set")
  ;
.END
.PROGRAM a.home ()
  ;
  ; Set small speed
  SPEED 100 MM/S ALWAYS
  ACCURACY 0.01 ALWAYS
  ; Move to home and home standby pos
  HOME
  HOME2  
  ;
.END
.PROGRAM get.task.data ()
  ;
  CALL get.system.data
  ;
  IF SIG (o.debug) THEN
    CALL log ("DEBUG mod activated. Get task data from Robot HMI")
    CALL get.from.hmi
  ELSE
    CALL log ("Get task data from PLC")
    CALL get.from.plc
  END
  ;
.END
.PROGRAM get.from.hmi ()
  ;
  wp.length[0]       = hmi.wp.length
  wp.length[1]       = hmi.wp.length
  wp.length[2]       = hmi.wp.length
  grip.jaw.full[1]   = hmi.grip.j.full[1]
  grip.jaw.body[1]   = hmi.grip.j.body[1]
  grip.jaw.full[2]   = hmi.grip.j.full[2]
  grip.jaw.body[2]   = hmi.grip.j.body[2]
  cnc.jaw.full[1]   = hmi.cnc.j.full[1]
  cnc.jaw.body[1]   = hmi.cnc.j.body[1]
  cnc.jaw.full[2]   = hmi.cnc.j.full[2]
  cnc.jaw.body[2]   = hmi.cnc.j.body[2]
  ;
  plt.rows           = hmi.plate.rows
  plt.cell.odd       = hmi.plate.col.o
  plt.cell.even      = hmi.plate.col.e
  plt.dx             = hmi.plate.dx
  plt.dy             = hmi.plate.dy
  plt.even.dy        = hmi.plate.e.dy
  plt.ox             = hmi.plate.ox
  plt.oy             = hmi.plate.oy
  ;
  wp.count           = hmi.wp.count
  ;
  chg.pg.no          = 1
  air.pg.no[1]       = 1
  air.pg.no[2]       = 1
  ;
  grip.inverse[1]    = FALSE
  grip.inverse[2]    = FALSE
  air.blow[1]        = FALSE
  air.blow[2]        = FALSE
  wp2.pick[1]        = TRUE
  wp2.pick[2]        = FALSE
  cnc.first          = TRUE
  grip.first         = FALSE
  ;
  int.change         = FALSE
  ext.change         = TRUE
  ;
  grip.chg.int[1]    = TRUE
  grip.chg.int[2]    = FALSE
  ;
  grip.chg.ext[1, 1] = TRUE
  grip.chg.ext[1, 2] = FALSE
  grip.chg.ext[2, 1] = TRUE
  grip.chg.ext[2, 2] = FALSE
  ;
  ;
.END
.PROGRAM get.from.plc ()
  ;
  wp.length[0]       = BITS (d.wp.length[0, 0], 8)
  wp.length[1]       = BITS (d.wp.length[1, 0], 8)
  wp.length[2]       = BITS (d.wp.length[2, 0], 8)
  grip.jaw.full[1]   = BITS (d.grip.jaw.full[1, 0], 8)
  grip.jaw.body[1]   = BITS (d.grip.jaw.body[1, 0], 8)
  grip.jaw.full[2]   = BITS (d.grip.jaw.full[2, 0], 8)
  grip.jaw.body[2]   = BITS (d.grip.jaw.body[2, 0], 8)
  cnc.jaw.full[1]   = BITS (d.cnc.jaw.full[1, 0], 8)
  cnc.jaw.body[1]   = BITS (d.cnc.jaw.body[1, 0], 8)
  cnc.jaw.full[2]   = BITS (d.cnc.jaw.full[2, 0], 8)
  cnc.jaw.body[2]   = BITS (d.cnc.jaw.body[2, 0], 8)
  ;
  plt.rows           = BITS (d.plt.rows[0], 4)
  plt.cell.odd       = BITS (d.plt.cell.odd[0], 4)
  plt.cell.even      = BITS (d.plt.cell.even[0], 4)
  plt.dx             = BITS (d.plt.dx[0], 16) / 10
  plt.dy             = BITS (d.plt.dy[0], 16) / 10
  plt.even.dy        = BITS (d.plt.even.dy[0], 16) / 10
  plt.ox             = BITS (d.plt.ox[0], 16) / 10
  plt.oy             = BITS (d.plt.oy[0], 16) / 10
  ;
  cnc.pg.no          = BITS (d.cnc.pg.no[0], 8)
  chg.pg.no          = BITS (d.chg.pg.no[0], 8)
  air.pg.no[1]       = BITS (d.air.pg.no[1, 0], 8)
  air.pg.no[2]       = BITS (d.air.pg.no[2, 0], 8)
  wp.count           = BITS (d.wp.count[0], 8)
  ;
  grip.inverse[1]    = SIG (d.grip.inverse[1])
  grip.inverse[2]    = SIG (d.grip.inverse[2])
  cnc.run.pg         = SIG (d.cnc.run.pg)
  air.blow[1]        = SIG (d.air.blow[1])
  air.blow[2]        = SIG (d.air.blow[2])
  wp2.pick[1]        = SIG (d.wp2.pick[1])
  wp2.pick[2]        = SIG (d.wp2.pick[2])
  cnc.first          = SIG (d.cnc.first)
  grip.first         = SIG (d.grip.first)
  ;
  int.change         = SIG (d.int.change)
  ext.change         = SIG (d.ext.change)
  ;
  grip.chg.int[1]    = SIG (d.grip.chg.int[1])
  grip.chg.int[2]    = SIG (d.grip.chg.int[2])
  ;
  grip.chg.ext[1, 1] = SIG (d.grip.chg.ext[1, 1])
  grip.chg.ext[1, 2] = SIG (d.grip.chg.ext[1, 2])
  grip.chg.ext[2, 1] = SIG (d.grip.chg.ext[2, 1])
  grip.chg.ext[2, 2] = SIG (d.grip.chg.ext[2, 2])
  ;
 ;  
.END
.PROGRAM id.to.ij (.id,.i,.j)
  ;
  .P = plt.cell.odd + plt.cell.even
  .pair = INT((.id - 1)/.P)
  .offset = (.id - 1) MOD .P
  ;
  IF .offset < plt.cell.odd THEN
    .i = 2*.pair
    .j = .offset
  ELSE
    .i = 2*.pair + 1
    .j = .offset - plt.cell.odd
  END
  ;
  CALL log("ID:" + $ENCODE(.id) + " --> i:" + $ENCODE(.i) + " j:" + $ENCODE(.j))
  ;
.END
.PROGRAM get.system.data ()
  ;
  overshoot = BITS (ei.overshoot[0], 4)
  IF overshoot == 0 THEN
    overshoot = 5
  END
  ;
  search.speed = BITS (ei.xmove.spd[0], 8)
  IF search.speed == 0 THEN
    search.speed = 10
  END
  ;
  air.blow.speed = BITS (ei.blow.spd[0], 8)
  IF air.blow.speed == 0 THEN
    air.blow.speed = 10
  END
  ;
  tmr.grip.op[1]       = BITS (ei.t.grip.op[1, 0], 8)/10
  tmr.grip.cl[1]       = BITS (ei.t.grip.cl[1, 0], 8)/10
  tmr.grip.op[2]       = BITS (ei.t.grip.op[2, 0], 8)/10
  tmr.grip.cl[2]       = BITS (ei.t.grip.cl[2, 0], 8)/10
  ;
  tmr.cnc.op[1]        = BITS (ei.t.cnc.open[1, 0], 8)/10
  tmr.cnc.cl[1]        = BITS (ei.t.cnc.close[1, 0], 8)/10
  tmr.cnc.op[2]        = BITS (ei.t.cnc.open[2, 0], 8)/10
  tmr.cnc.cl[2]        = BITS (ei.t.cnc.close[2, 0], 8)/10
  ;
.END
.PROGRAM calc.state.flag ()
  ;
  shelf.opened = SIG (eo.shelf.opened[current.shelf])
  shelf.closed = NOT shelf.opened
  ;
  gp.empty[1] = gripper.state[1] == -1
  gp.full[1] = NOT gp.empty[1]
  gp.wp2[1] = gripper.state[1] == 2
  gp.wp1[1] = gripper.state[1] == 1
  gp.wp0[1] = gripper.state[1] == 0
  ;
  gp.empty[2] = gripper.id[2] == 0
  gp.full[2] = NOT gp.empty[2]
  gp.wp2[2] = gripper.state[2] == 2
  gp.wp1[2] = gripper.state[2] == 1
  gp.wp0[2] = gripper.state[2] == 0
  ;
  cnc.empty[1] = cnc.state[1] == -1
  cnc.full[1] = NOT cnc.empty[1]
  cnc.wp2[1] = cnc.state[1] == 2
  cnc.wp1[1] = cnc.state[1] == 1
  cnc.wp0[1] = cnc.state[1] == 0
  ;
  cnc.empty[2] = cnc.state[2] == -1
  cnc.full[2] = NOT cnc.empty[2]
  cnc.wp2[2] = cnc.state[2] == 2
  cnc.wp1[2] = cnc.state[2] == 1
  cnc.wp0[2] = cnc.state[2] == 0
  ;
  air.bp = SIG (s.p.put.air.req)
  air.ap = SIG (s.a.pic.air.req)
  ;
  .inside.cnc = SIG (s.inside.cnc)
  .outside.cnc = NOT .inside.cnc
  rout = shelf.opened AND .outside.cnc
  rin = shelf.opened AND .inside.cnc
  ;
  mfinish = SIG (s.mcode.req)
  n.max.pick = current.wp <= wp.count
  max.pick = NOT n.max.pick
  ;
  IF grip.chg.int[1] THEN
    gp.int = 1
  ELSE
    gp.int = 2
  END
  ;
  IF grip.chg.ext[1, 1] THEN
    gp.ext.1 = 1
  ELSE
    gp.ext.1 = 2
  END
  IF grip.chg.ext[2, 1] THEN
    gp.ext.2 = 1
  ELSE
    gp.ext.2 = 2
  END
  ;
.END
.PROGRAM ciner (.$var.name,.var,.default)
  ;
  IF NOT EXISTREAL(.$var.name) THEN
    CALL log("Variable " + .$var.name + " is not exist. Default:" + $ENCODE(.default))
    .var = .default
  END
  ;
.END
.PROGRAM log (.$msg)
  ;
  IF LEN (.$msg) > 55 THEN
    .$msg = $LEFT (.$msg, 55)
  END
  ;
  FOR .i = 1 TO log.max.count - 1
    $log.entry[.i] = $log.entry[.i + 1]
  END
  $log.entry[log.max.count] = $TIME + " " + .$msg
  ;
  FOR .i = 0 TO 11
    .$tmp[.i] = $log.entry[log.max.count - (11 - .i)]
  END
  ;
  IFPWPRINT 1, 1, 1, 9, 10 = .$tmp[0], .$tmp[1], .$tmp[2],  .$tmp[3]
  IFPWPRINT 2, 1, 1, 9, 10 = .$tmp[4], .$tmp[5], .$tmp[6],  .$tmp[7]
  IFPWPRINT 3, 1, 1, 9, 10 = .$tmp[8], .$tmp[9], .$tmp[10], .$tmp[11]
  ;
.END
.PROGRAM log.init ()
  ;
  ; Change this number if needed
  log.max.count = 256
  ;
  .$tmp1 = $ENCODE(/L, log.max.count)
  .$tmp2 = "$log.entry[" + .$tmp1 + "]"
  IF NOT EXISTCHAR (.$tmp2) THEN
    FOR .i = 1 TO log.max.count
      $log.entry[.i] = ""
    END
  END
  ;
.END
.PROGRAM log.pc1 (.$msg)
  ;
  IF LEN (.$msg) > 55 THEN
    .$msg = $LEFT (.$msg, 55)
  END
  ;
  FOR .i = 1 TO log.max.count - 1
    $log.entry[.i] = $log.entry[.i + 1]
  END
  $log.entry[log.max.count] = $TIME + " " + .$msg
  ;
  FOR .i = 0 TO 11
    .$tmp[.i] = $log.entry[log.max.count - (11 - .i)]
  END
  ;
  IFPWPRINT 1, 1, 1, 9, 10 = .$tmp[0], .$tmp[1], .$tmp[2],  .$tmp[3]
  IFPWPRINT 2, 1, 1, 9, 10 = .$tmp[4], .$tmp[5], .$tmp[6],  .$tmp[7]
  IFPWPRINT 3, 1, 1, 9, 10 = .$tmp[8], .$tmp[9], .$tmp[10], .$tmp[11]
  ;
.END
.PROGRAM log.clear ()
  ;
  FOR .i = 1 TO log.max.count
    $log.entry[.i] = ""
  END
  ;
.END
.PROGRAM a.main ()
  ;
  CALL log ("Main program executed")
  CALL safe.home
  ;
  WHILE TRUE DO
    .$pg.string = "state" + $ENCODE (/L, state)
    IF EXISTPGM (.$pg.string) THEN
      SCALL .$pg.string
    ELSE
      CALL log ("Error! Program is in wrong state. Reset state to 0")
      RETURN
    END
  END
  ;
.END
.PROGRAM pg0 ()
  ;
  state = 0
  CALL a.main
  ;
.END
.PROGRAM check.speed.pc ()
  ;
  IF SIG (o.debug) THEN
    RETURN
  END
  ; Set speed from HMI at any time
  .speed = BITS (ei.robot.speed[0], 16)
  .speed = MAXVAL (.speed, 1)
  .speed = MINVAL (.speed, 100)
  IF INT(.speed) <> INT(MSPEED) THEN
    MON_SPEED .speed
    CALL log.pc1 ("Speed" + $ENCODE (.speed) + " was applied")
  END
  ;
.END
.PROGRAM check.teach.pc ()
  ;
  IF NOT SWITCH (REPEAT ) THEN
    IF SIG (s.pr.tch.plate) THEN
      MC PRIME plate.teach
    END
    ;
    IF SIG (s.pr.tst.plate) THEN
      MC PRIME plate.test
    END
    ;
    IF SIG (s.pr.tch.shelf) THEN
      MC PRIME shelf.teach
    END
    ;
    IF SIG (s.pr.tst.shelf) THEN
      MC PRIME shelf.test
    END
    ;
    IF SIG (s.pr.wp.tst.pic) THEN
      MC PRIME wp.test.pick
    END
    ;
    IF SIG (s.pr.wp.tst.put) THEN
      MC PRIME wp.test.put
    END
    ;
    IF SIG (s.pr.tch.cnc.ap) THEN
      MC PRIME cnc.appro.teach
    END
    ;
    IF SIG (s.pr.tch.cnc) THEN
      MC PRIME cnc.teach
    END
    ;
    IF SIG (s.pr.tst.cnc.pi) THEN
      MC PRIME cnc.test.pick
    END
    ;
    IF SIG (s.pr.tst.cnc.pu) THEN
      MC PRIME cnc.test.put
    END
    ;
    IF SIG(s.pr.a.home) THEN
      MC PRIME a.home
    ;
    END
  END
  ;
.END
.PROGRAM check.limits.pc ()
  ;
  hmi.shelf.no = MINVAL(hmi.shelf.no, 4)
  hmi.shelf.no = MAXVAL(hmi.shelf.no, 1)
  hmi.wp.id = MAXVAL(hmi.wp.id, 1)
  hmi.wp.length = MAXVAL(hmi.wp.length, 1)
  ;
  hmi.grip.j.full[1] = MAXVAL(hmi.grip.j.full[1], 1)
  hmi.grip.j.full[2] = MAXVAL(hmi.grip.j.full[2], 1)
  hmi.cnc.j.full[1] = MAXVAL(hmi.cnc.j.full[1], 1)
  hmi.cnc.j.full[2] = MAXVAL(hmi.cnc.j.full[2], 1)
  ;
  hmi.grip.j.body[1] = MAXVAL(hmi.grip.j.body[1], 1)
  hmi.grip.j.body[2] = MAXVAL(hmi.grip.j.body[2], 1)
  hmi.cnc.j.body[1] = MAXVAL(hmi.cnc.j.body[1], 0)
  hmi.cnc.j.body[2] = MAXVAL(hmi.cnc.j.body[2], 0)
  ;
  hmi.grip.j.body[1] = MINVAL(hmi.grip.j.body[1], hmi.grip.j.full[1])
  hmi.grip.j.body[2] = MINVAL(hmi.grip.j.body[2], hmi.grip.j.full[2])
  hmi.cnc.j.body[1] = MINVAL(hmi.cnc.j.body[1], hmi.cnc.j.full[1])
  hmi.cnc.j.body[2] = MINVAL(hmi.cnc.j.body[2], hmi.cnc.j.full[2])
  ;
  hmi.plate.rows = MAXVAL(hmi.plate.rows, 1)
  hmi.plate.col.o = MAXVAL(hmi.plate.col.o, 1)
  hmi.plate.col.e  = MAXVAL(hmi.plate.col.e, 1)
  hmi.plate.dx  = MAXVAL(hmi.plate.dx, 0)
  hmi.plate.dy = MAXVAL(hmi.plate.dy, 0)
  hmi.plate.e.dy = MAXVAL(hmi.plate.e.dy, 0)
  hmi.plate.ox = MAXVAL(hmi.plate.ox, 0)
  hmi.plate.oy = MAXVAL(hmi.plate.oy, 0)
  hmi.wp.count = MAXVAL(hmi.wp.count, 1)
  ;
  hmi.air.pg = MAXVAL(hmi.air.pg, 1)
  hmi.air.pg = MINVAL(hmi.air.pg, 255)
  ;
  hmi.chg.pg = MAXVAL(hmi.chg.pg, 1)
  hmi.chg.pg = MINVAL(hmi.chg.pg, 255)
  ;
.END
.PROGRAM check.reset.pc()@26/09/10 14:47 #0
  ;
  IF NOT SIG (di.ext.pgreset) THEN
    SIGNAL -s.reset.perf
  END
  IF SIG (di.ext.pgreset) THEN
    IF NOT SIG (s.reset.perf) THEN
      CALL log.pc1 ("Reset command executed")
      ; Resetting signals
      SIGNAL -s.shelf.failed
      BITS eo.shelf.opened[1], 4 = 0
      ;
      SIGNAL eo.task.exec
      SIGNAL -eo.robot.ready
      SIGNAL -s.p.put.air.req
      SIGNAL -s.a.pic.air.req
      SIGNAL -s.mcode.req
      ;SIGNAL -s.change.req
      ;SIGNAL -s.chg.ok
      SIGNAL -s.ext.chg.ok
      SIGNAL -s.ext.chg.req
      current.shelf = 1
      ;
      state = 0
      ;
      gripper.id[1] = 0
      gripper.id[2] = 0
      gripper.state[1] = -1
      gripper.state[2] = -1
      cnc.id[1] = 0
      cnc.id[2] = 0
      cnc.state[1] = -1
      cnc.state[2] = -1
      current.wp = 1
      processed.wp = 0
      ;
    END
    SIGNAL s.reset.perf
  END
  ;
.END
.PROGRAM send.plc.pc ()
  ;
  BITS eo.grip.id[1, 0], 8 = gripper.id[1]
  BITS eo.grip.id[2, 0], 8 = gripper.id[2]
  BITS eo.cnc.id[1, 0], 8 = cnc.id[1]
  BITS eo.cnc.id[2, 0], 8 = cnc.id[2]
  BITS eo.wp.processed[0], 8 = processed.wp
  IF current.wp > wp.count THEN
    BITS eo.next.wp[0], 8 = 0
  ELSE
    BITS eo.next.wp[0], 8 = current.wp
  END
  ;
  BITS eo.error.code[0], 16 = -ERROR
  ;
  CASE gripper.state[1] OF
    VALUE -1:
      SIGNAL eo.grip.empty[1]
      SIGNAL -eo.grip.wp0[1]
      SIGNAL -eo.grip.wp1[1]
      SIGNAL -eo.grip.wp2[1]
    VALUE 0:
      SIGNAL -eo.grip.empty[1]
      SIGNAL eo.grip.wp0[1]
      SIGNAL -eo.grip.wp1[1]
      SIGNAL -eo.grip.wp2[1]
    VALUE 1:
      SIGNAL -eo.grip.empty[1]
      SIGNAL -eo.grip.wp0[1]
      SIGNAL eo.grip.wp1[1]
      SIGNAL -eo.grip.wp2[1]
    VALUE 2:
      SIGNAL -eo.grip.empty[1]
      SIGNAL -eo.grip.wp0[1]
      SIGNAL -eo.grip.wp1[1]
      SIGNAL eo.grip.wp2[1]
  END
  ;
  CASE gripper.state[2] OF
    VALUE -1:
      SIGNAL eo.grip.empty[2]
      SIGNAL -eo.grip.wp0[2]
      SIGNAL -eo.grip.wp1[2]
      SIGNAL -eo.grip.wp2[2]
    VALUE 0:
      SIGNAL -eo.grip.empty[2]
      SIGNAL eo.grip.wp0[2]
      SIGNAL -eo.grip.wp1[2]
      SIGNAL -eo.grip.wp2[2]
    VALUE 1:
      SIGNAL -eo.grip.empty[2]
      SIGNAL -eo.grip.wp0[2]
      SIGNAL eo.grip.wp1[2]
      SIGNAL -eo.grip.wp2[2]
    VALUE 2:
      SIGNAL -eo.grip.empty[2]
      SIGNAL -eo.grip.wp0[2]
      SIGNAL -eo.grip.wp1[2]
      SIGNAL eo.grip.wp2[2]
  END
  ;
  CASE cnc.state[1] OF
    VALUE -1:
      SIGNAL eo.cnc.empty[1]
      SIGNAL -eo.cnc.wp0[1]
      SIGNAL -eo.cnc.wp1[1]
      SIGNAL -eo.cnc.wp2[1]
    VALUE 0:
      SIGNAL -eo.cnc.empty[1]
      SIGNAL eo.cnc.wp0[1]
      SIGNAL -eo.cnc.wp1[1]
      SIGNAL -eo.cnc.wp2[1]
    VALUE 1:
      SIGNAL -eo.cnc.empty[1]
      SIGNAL -eo.cnc.wp0[1]
      SIGNAL eo.cnc.wp1[1]
      SIGNAL -eo.cnc.wp2[1]
    VALUE 2:
      SIGNAL -eo.cnc.empty[1]
      SIGNAL -eo.cnc.wp0[1]
      SIGNAL -eo.cnc.wp1[1]
      SIGNAL eo.cnc.wp2[1]
  END
  ;
  CASE cnc.state[2] OF
    VALUE -1:
      SIGNAL eo.cnc.empty[2]
      SIGNAL -eo.cnc.wp0[2]
      SIGNAL -eo.cnc.wp1[2]
      SIGNAL -eo.cnc.wp2[2]
    VALUE 0:
      SIGNAL -eo.cnc.empty[2]
      SIGNAL eo.cnc.wp0[2]
      SIGNAL -eo.cnc.wp1[2]
      SIGNAL -eo.cnc.wp2[2]
    VALUE 1:
      SIGNAL -eo.cnc.empty[2]
      SIGNAL -eo.cnc.wp0[2]
      SIGNAL eo.cnc.wp1[2]
      SIGNAL -eo.cnc.wp2[2]
    VALUE 2:
      SIGNAL -eo.cnc.empty[2]
      SIGNAL -eo.cnc.wp0[2]
      SIGNAL -eo.cnc.wp1[2]
      SIGNAL eo.cnc.wp2[2]
  END
  ;
.END
.PROGRAM set.switches.pc ()
  ;
  ; System switches
  CP ON
  PREFETCH.SIGINS OFF
  QTOOL OFF
  REP_ONCE ON
  HOLD.STEP ON
  DISP.EXESTEP ON
  PROG.DATE ON
  ABS.SPEED ON
  ERRSTART.PC ON  
  autostart.pc ON
  ;
.END
.PROGRAM disp.info.pc ()
  ;
  .$robot.name = $SYSDATA(ZROB.NAME)
  .robot.sn = SYSDATA (ZROB.MGFNO)
  .cont.sn = SYSDATA (CONT.NO)
  .$robot.str = "Robot: " + .$robot.name +" S/N: C" + $ENCODE (/L, .robot.sn)
  .$cont.str = "Controller: F60 S/N: C" + $ENCODE (/L, .cont.sn)
  IFPWPRINT 8, 1, 1, 5, 10 = .$robot.str, .$cont.str, " ", "Powered by Robowizard Co.Ltd."
  ;
.END
.PROGRAM set.vars.pc ()
  ;
  POINT tool.gripper[1] = TRANS (-103.3, 0, 104, -180, 90, 180)
  POINT tool.gripper[2] = TRANS (103.3, 0, 104, 0, 90, 180)
  POINT tool.calib[1] = TRANS (-202.8, 0, 104, -180, 90, 180)
  POINT tool.calib[2] = TRANS (202.8, 0, 104, 0, 90, 180)
  POINT tool.pin = TRANS (0, 112, 104, 90, 90, 0)
  ;
  POINT #shelf.safe = #PPOINT (75, 0, 100, 30, 75, 100)
  POINT #transport = #PPOINT (0, 50, -145, 0, -120, 0)
  ;
  IF NOT EXISTJOINT ("#wp.safe[1]") THEN
    POINT #wp.safe[1] = #PPOINT (73, 14, 105, 108, -40, 14)
  END
  IF NOT EXISTJOINT ("#wp.safe[2]") THEN
    POINT #wp.safe[2] = #PPOINT (73, 14, 105, 108, -40, 194)
  END
  ;
  hmi.shelf.no = 1
  hmi.wp.id = 1
  ;
  hmi.air.pg = 1
  hmi.chg.pg = 1
  ;
  CALL ciner ("pick.epsilon", pick.epsilon, 0.2)
  ;
  CALL ciner ("hmi.wp.length", hmi.wp.length, 50)
  ;
  CALL ciner ("hmi.grip.j.full[1]", hmi.grip.j.full[1], 40)
  CALL ciner ("hmi.grip.j.full[2]", hmi.grip.j.full[2], 40)
  CALL ciner ("hmi.grip.j.body[1]", hmi.grip.j.body[1], 28)
  CALL ciner ("hmi.grip.j.body[2]", hmi.grip.j.body[2], 28)
  CALL ciner ("hmi.cnc.j.full[1]", hmi.cnc.j.full[1], 40)
  CALL ciner ("hmi.cnc.j.full[2]", hmi.cnc.j.full[2], 40)
  CALL ciner ("hmi.cnc.j.body[1]", hmi.cnc.j.body[1], 28)
  CALL ciner ("hmi.cnc.j.body[2]", hmi.cnc.j.body[2], 28)
  ;
  CALL ciner ("hmi.plate.rows", hmi.plate.rows, 4)
  CALL ciner ("hmi.plate.col.o", hmi.plate.col.o, 4)
  CALL ciner ("hmi.plate.col.e", hmi.plate.col.e, 4)
  CALL ciner ("hmi.plate.dx", hmi.plate.dx, 130)
  CALL ciner ("hmi.plate.dy", hmi.plate.dy, 160)
  CALL ciner ("hmi.plate.e.dy", hmi.plate.e.dy, 0)
  CALL ciner ("hmi.plate.ox", hmi.plate.ox, 80)
  CALL ciner ("hmi.plate.oy", hmi.plate.oy, 75)
  ;
  CALL ciner ("hmi.wp.count", hmi.wp.count, 4)
  ;
  CALL ciner ("hmi.air.pg", hmi.air.pg, 1)
  CALL ciner ("hmi.chg.pg", hmi.chg.pg, 1)
  ;
  CALL ciner ("cnc.rotations[1, 1]", cnc.rotations[1, 1], 0)
  CALL ciner ("cnc.rotations[1, 2]", cnc.rotations[1, 2], 180)
  CALL ciner ("cnc.rotations[2, 1]", cnc.rotations[2, 1], 180)
  CALL ciner ("cnc.rotations[2, 2]", cnc.rotations[2, 2], 0)
  ;
  CALL ciner ("gripper.id[1]", gripper.id[1], 0)
  CALL ciner ("gripper.state[1]", gripper.state[1], -1)
  CALL ciner ("gripper.id[2]", gripper.id[2], 0)
  CALL ciner ("gripper.state[2]", gripper.state[2], -1)
  CALL ciner ("cnc.id[1]", cnc.id[1], 0)
  CALL ciner ("cnc.state[1]", cnc.state[1], -1)
  CALL ciner ("cnc.id[2]", cnc.id[2], 0)
  CALL ciner ("cnc.state[2]", cnc.state[2], -1)
  ;
  CALL ciner ("processed.wp", processed.wp, 0)
  CALL ciner ("current.wp", current.wp, 1)
  CALL ciner ("wp.count", wp.count, 1)
  ;
  CALL ciner ("state", state, 0)
  ;
  IF NOT EXISTCHAR ("$safe.slag") THEN
    $safe.slag = " "
  END
  ;
.END
.PROGRAM initialize.pc ()
  ;
  CALL log.init
  CALL set.switches.pc
  CALL set.io.pc
  CALL set.vars.pc
  CALL disp.info.pc
  CALL get.from.plc
  ;
  MC PRIME a.main
  TWAIT 0.5
  ;
  CALL log.pc1 ("Robot boot initialize completed")
  ;
.END
