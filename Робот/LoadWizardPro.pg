.PROGRAM autostart.pc ()
  ;
  CALL initialize.pc
  ;
  WHILE TRUE DO
    CALL check.speed.pc
    CALL check.teach.pc
    CALL check.limits.pc
    CALL check.reset.pc
    CALL send.plc.pc
  END
  ;
.END
