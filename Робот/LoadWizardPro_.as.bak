  ;
  s.pr.tch.plate        = 2106
  s.pr.tst.plate        = 2107
  s.pr.tch.shelf        = 2108
  s.pr.tst.shelf        = 2109
  s.pr.wp.tst.pic       = 2110
  s.pr.wp.tst.put       = 2111
  s.pr.tch.cnc.ap       = 2112
  s.pr.tch.cnc          = 2113
  s.pr.tst.cnc          = 2114
  ;
